<div class="nc-section">
  <div class="nc-container" style="max-width: 480px;">
    <h1>Vælg ny adgangskode</h1>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <p role="alert">Adgangskoden kunne ikke ændres. Prøv igen.</p>
      {%- endif -%}
      <p>
        <label class="nc-label" for="nc-reset-password">Ny adgangskode</label>
        <input id="nc-reset-password" class="nc-input" type="password" name="customer[password]" autocomplete="new-password" required>
      </p>
      <p>
        <label class="nc-label" for="nc-reset-confirm">Gentag adgangskode</label>
        <input id="nc-reset-confirm" class="nc-input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </p>
      <p>
        <button class="nc-btn nc-btn--primary" type="submit">Gem adgangskode</button>
      </p>
    {%- endform -%}
  </div>
</div>
