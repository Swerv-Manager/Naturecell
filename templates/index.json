    "c5e124b2-47cb-4d7e-bb29-57368d4c8c6b": {
      "type": "rich-text",
      "blocks": {
        "template--18345353642322__c5e124b2-47cb-4d7e-bb29-57368d4c8c6b-1679318343efb698b1-1": {
          "type": "heading",
          "settings": {
            "text": "CBD hudpleje er godt for din hud",
