{% comment %}
  USP-baand, lys variant fra godkendt PDP-design: paper-baggrund, tynde
  linjer, sage-ikoner og moerk tekst i loeb. (Paa produktsiden ligger
  loebet inde i koebskolonnen i main-product; denne sektion er til
  fritstaaende brug.)
{% endcomment %}

{%- style -%}
  .nc-uspband { background: var(--sage-50); color: var(--sage-700); padding: 14px 0; overflow: hidden; border-top: 1px solid var(--border-soft); border-bottom: 1px solid var(--border-soft); }
  .nc-uspband__item { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-body); font-weight: 600; font-size: 13.5px; padding: 0 22px; white-space: nowrap; }
  .nc-uspband__item svg { flex: none; }
{%- endstyle -%}

<div class="nc-uspband nc-marqwrap" aria-label="Fordele ved at handle hos NatureCell">
  <div class="nc-rail" style="animation-duration: 24s;">
    {%- assign items = section.settings.items | newline_to_br | split: '<br />' -%}
    {%- for i in (1..2) -%}
      {%- for item in items -%}
        {%- assign tp = item | split: ' | ' -%}
        <span class="nc-uspband__item" {% if i == 2 %}aria-hidden="true"{% endif %}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="{{ tp[1] | strip | default: 'M20 6 9 17l-5-5' }}"/></svg>
          {{ tp[0] | strip }}
        </span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "USP-bånd",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "items",
      "label": "Punkter (én pr. linje: Tekst | SVG-sti (valgfri))",
      "default": "Fri fragt over 399 kr. | M5 18H3V6h12v4 M14 9h4l3 3v6h-2 M7.5 18.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3 M17.5 18.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3\nDansk produktion & test | M20 6 9 17l-5-5\nVegansk & plantebaseret | M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\ne-mærket webshop · tryg handel | M12 2 4 5v6c0 5 3.5 8 8 11 4.5-3 8-6 8-11V5Z\n30 dages returret | M3 12a9 9 0 1 0 3-6.7L3 8 M3 3v5h5"
    }
  ],
  "presets": [ { "name": "USP-bånd" } ]
}
{% endschema %}
