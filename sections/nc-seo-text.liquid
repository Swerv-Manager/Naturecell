{% comment %}
  SEO-bundtekst fra designet: overskrift + afsnit og tre emneblokke.
  Bruges nederst paa kollektionssider. Indholdet kommer pr. kollektion fra
  metafelterne (ncell.seo_heading / seo_body / seo_topics), saa der kun er
  én skabelon. Uden indhold vises sektionen ikke, saa der aldrig staar den
  samme generiske tekst paa flere kollektioner (dobbelt indhold).
{% endcomment %}

{%- style -%}
  {%- comment -%}
    Maal spejlet 1:1 fra designets SEO-blok (template.html 1589-1605): 72px over
    hairline-stregen, 48px under den, 2 kolonner med 52px gap, h2 30px/1.18 + 16px,
    afsnit 15.5px/1.8 + 14px, emnekort cloud + 1px border-soft, 22px 24px padding,
    h3 19px/1.25 + 8px, tekst 14.5px/1.75, 14px mellem kortene. Bundpadding 55px lander
    FAQ-overskriften 70px under sidste emnekort som i det godkendte skud (designets
    64px margin + FAQ-sektionens egen padding/overskriftsboks).
  {%- endcomment -%}
  .nc-seotext { background: var(--paper); }
  .nc-seotext.nc-section { padding-top: clamp(46px, 6vw, 72px); padding-bottom: 55px; }
  .nc-seotext .nc-container::before { content: ''; display: block; border-top: 1px solid var(--border-soft); margin-bottom: clamp(32px, 4vw, 48px); }
  .nc-seotext__cols { display: grid; gap: clamp(24px, 4vw, 52px); align-items: start; }
  @media (min-width: 900px) { .nc-seotext__cols { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .nc-seotext__lead h2 { margin: 0 0 16px; font-family: var(--font-display); font-weight: 400; font-size: clamp(24px, 3vw, 30px); line-height: 1.18; letter-spacing: normal; color: var(--sage-700); text-wrap: wrap; }
  .nc-seotext__lead p { margin: 0 0 14px; font-size: 15.5px; line-height: 1.8; color: var(--ink-700); text-wrap: pretty; }
  .nc-seotext__blocks { display: grid; gap: 14px; grid-template-columns: 1fr; }
  .nc-seotext__card { background: var(--cloud); border: 1px solid var(--border-soft); border-radius: var(--radius-lg, 18px); padding: 22px 24px; }
  .nc-seotext__card h3 { margin: 0 0 8px; font-family: var(--font-display); font-weight: 400; font-size: 19px; line-height: 1.25; letter-spacing: normal; color: var(--sage-700); }
  .nc-seotext__card p { margin: 0; font-size: 14.5px; line-height: 1.75; color: var(--ink-700); text-wrap: pretty; }
  .nc-seotext__links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: clamp(40px, 5vw, 56px); }
{%- endstyle -%}

{%- liquid
  assign seo_any = false
  if collection.metafields.ncell.seo_heading.value != blank or collection.metafields.ncell.seo_body.value != blank or collection.metafields.ncell.seo_topics.value != blank
    assign seo_any = true
  elsif section.settings.heading != blank or section.settings.body != blank or section.settings.links != blank
    assign seo_any = true
  else
    for block in section.blocks
      if block.type == 'topic'
        assign seo_any = true
      endif
    endfor
  endif
-%}
{%- if seo_any -%}
<section class="nc-seotext nc-section">
  <div class="nc-container">
    {%- assign has_blocks = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'topic' -%}{%- assign has_blocks = true -%}{%- endif -%}
    {%- endfor -%}

    {%- comment -%}
      Unikt indhold pr. kollektion kommer fra kollektionens metafelter (ét template for alle):
      ncell.seo_heading (tekst), ncell.seo_body (rich text) og ncell.seo_topics (liste af
      metaobjektet seo_topic med title + text). Er de tomme, bruges sektionens egne indstillinger.
    {%- endcomment -%}
    {%- liquid
      assign mf_heading = collection.metafields.ncell.seo_heading.value
      assign mf_body = collection.metafields.ncell.seo_body
      assign mf_topics = collection.metafields.ncell.seo_topics.value
    -%}
    {%- liquid
      assign seo_heading = mf_heading | default: section.settings.heading
      assign seo_has_body = false
      if mf_body.value != blank or section.settings.body != blank
        assign seo_has_body = true
      endif
    -%}
    {%- if seo_heading != blank or seo_has_body or mf_topics != blank or has_blocks -%}
    <div class="nc-seotext__cols">
      <div class="nc-seotext__lead">
        {%- if seo_heading != blank -%}<h2>{% render 'nc-cbd', text: seo_heading %}</h2>{%- endif -%}
        {%- if mf_body.value != blank -%}
          {%- capture mf_body_html %}{{ mf_body | metafield_tag }}{% endcapture -%}
          {% render 'nc-cbd', text: mf_body_html %}
        {%- else -%}
          {% render 'nc-cbd', text: section.settings.body %}
        {%- endif -%}
      </div>

      {%- if mf_topics != blank -%}
        <div class="nc-seotext__blocks">
          {%- for topic in mf_topics -%}
            <div class="nc-seotext__card">
              <h3>{% render 'nc-cbd', text: topic.title %}</h3>
              <p>{% render 'nc-cbd', text: topic.text %}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- elsif has_blocks -%}
        <div class="nc-seotext__blocks">
          {%- for block in section.blocks -%}
            {%- if block.type == 'topic' -%}
              <div class="nc-seotext__card" {{ block.shopify_attributes }}>
                <h3>{% render 'nc-cbd', text: block.settings.heading %}</h3>
                <p>{% render 'nc-cbd', text: block.settings.text %}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    {%- endif -%}

    {%- if section.settings.links != blank -%}
      <div class="nc-seotext__links">
        {%- assign rows = section.settings.links | newline_to_br | split: '<br />' -%}
        {%- for row in rows -%}
          {%- assign parts = row | strip | split: '|' -%}
          {%- if parts[0] != blank and parts[1] != blank -%}
            {%- assign link_text = parts[0] | strip -%}<a class="nc-chip" href="{% render 'nc-url', url: parts[1] %}">{% render 'nc-cbd', text: link_text %}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "SEO-tekst",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift (fallback)",
      "info": "Bruges kun, når kollektionen ikke har metafeltet ncell.seo_heading. Lad den stå tom, så kollektioner uden eget indhold ikke viser den samme tekst."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Brødtekst (fallback)",
      "info": "Bruges kun, når kollektionen ikke har ncell.seo_body."
    },
    {
      "type": "textarea",
      "id": "links",
      "label": "Interne links (én pr. linje: Tekst | /url)",
      "default": "CBD creme | /collections/cbd-ansigtspleje\nDagcreme | /collections/cbd-ansigtspleje\nHåndcreme | /collections/cbd-handpleje\nFodcreme | /collections/cbd-fodpleje\nBodylotion | /collections/cbd-kropspleje\nHudpleje til mænd | /collections/herre-hudpleje\nSampakker | /collections/sampakker\nHele sortimentet | /collections/cbd-hudpleje"
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Emneblok",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Overskrift",
          "default": "Rutinen i tre trin"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Tekst",
          "default": "Beskriv, hvordan produkterne i kollektionen bruges sammen, uden løfter om effekt."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SEO-tekst"
    }
  ]
}
{% endschema %}
