{% comment %}
  Artikelside 1:1 fra NatureCell.dc.html.
  Kundecase: fuldbred sage-hero med tilbage-link, omraade-pill, citat,
  avatar med kundens navn, medie med play-cirkel. Broedtekst med drop cap
  og citat-callouts, tag-chips, og "Produkterne bag resultatet"-baand med
  Tilfoej hele rutinen. Navn/citat/produkter laeses fra artiklens
  metafelter ncell.name, ncell.quote og ncell.products.
  Artikel: tilbage-link, tag-eyebrow, stor rubrik, herobillede, lead og
  broedtekst i tekstkolonne, plus "Laes ogsaa".
{% endcomment %}

{%- liquid
  assign is_case = false
  if blog.handle == 'kundecases'
    assign is_case = true
  endif

  assign clean_title = article.title | split: ' | ' | first
  assign person = article.metafields.ncell.name | default: ''
  assign quote = article.metafields.ncell.quote | default: ''
  assign case_products = article.metafields.ncell.products.value

  assign area_label = ''
  assign area_tag = ''
  for tag in article.tags
    assign lt = tag | downcase
    if area_label == blank
      if lt contains 'ansigt'
        assign area_label = 'Ansigt'
      elsif lt contains 'hænder' or lt contains 'haender' or lt contains 'håndcreme'
        assign area_label = 'Hænder'
      elsif lt contains 'fødder' or lt contains 'foedder' or lt contains 'fodcreme'
        assign area_label = 'Fødder'
      elsif lt == 'krop'
        assign area_label = 'Krop'
      endif
      if area_label != blank
        assign area_tag = tag
      endif
    endif
  endfor

  assign has_video = false
  if article.content contains 'youtube' or article.content contains 'youtu.be' or article.content contains '<video'
    assign has_video = true
  endif

  comment
    Kundecase: video-embed skal staa lige efter intro-afsnittet (som i
    designet), ikke hvor den ligger i CMS-indholdet. Loeft foerste iframe
    ud og saet den ind efter foerste <p>.
  endcomment
  assign body_html = article.content
  if is_case and body_html contains '<iframe'
    assign embed_split = body_html | split: '<iframe'
    assign embed_rest = embed_split[1] | split: '</iframe>'
    assign embed_html = '<div class="nc-art__embed"><iframe' | append: embed_rest[0] | append: '</iframe></div>'
    assign intro_split = embed_split[0] | split: '</p>'
    assign intro_html = intro_split[0] | append: '</p>'
    assign after_intro = embed_split[0] | remove_first: intro_html
    assign body_html = intro_html | append: embed_html | append: after_intro
    if embed_rest.size > 1
      assign body_html = body_html | append: embed_rest[1]
    endif
  endif
-%}

{%- style -%}
  .nc-casehero { position: relative; background: var(--sage-500); color: rgba(255, 255, 255, 0.88); padding: clamp(20px, 3vw, 32px) 0 clamp(36px, 5vw, 64px); }
  .nc-casehero__fab { position: absolute; right: clamp(16px, 2vw, 30px); bottom: clamp(22px, 3.2vw, 46px); display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: var(--sage-700); color: var(--cloud); box-shadow: var(--shadow-md); cursor: pointer; }
  .nc-casehero__fab svg { display: block; }
  .nc-casehero .nc-backlink { color: rgba(255, 255, 255, 0.85); }
  .nc-casehero__grid { display: grid; gap: clamp(24px, 4vw, 56px); grid-template-columns: 1fr; align-items: center; margin-top: clamp(18px, 3vw, 40px); }
  @media (min-width: 900px) { .nc-casehero__grid { grid-template-columns: 1fr 1fr; } }
  .nc-casehero__pill { display: inline-flex; padding: 6px 13px; border-radius: var(--radius-pill); background: rgba(255, 255, 255, 0.16); color: var(--cloud); font-size: 10.5px; font-weight: 600; letter-spacing: var(--tracking-wider); text-transform: uppercase; }
  .nc-casehero__body { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; max-width: 518px; }
  .nc-casehero__body h1 { margin: 0; color: var(--cloud); font-size: clamp(30px, 3.8vw, 48px); line-height: 1.12; text-wrap: wrap; }
  .nc-casehero__quote { margin: 0; font-family: var(--font-display); font-style: italic; font-size: clamp(16px, 1.5vw, 19px); line-height: 1.6; color: rgba(255, 255, 255, 0.92); }
  .nc-casehero__person { display: flex; align-items: center; gap: 12px; }
  .nc-casehero__person strong { display: block; font-size: 15px; color: var(--cloud); font-weight: 600; }
  .nc-casehero__person small { display: block; font-size: 13px; color: rgba(255, 255, 255, 0.75); }
  .nc-casehero__media { position: relative; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4 / 5; background: rgba(255, 255, 255, 0.12); }
  .nc-casehero__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .nc-art { max-width: var(--container-text); margin: 0 auto; }
  .nc-art__byline { display: flex; align-items: center; gap: 10px; padding-bottom: 16px; margin-bottom: 22px; border-bottom: 1px solid var(--border-soft, var(--ink-100)); font-size: 14px; color: var(--ink-500); }
  .nc-art__byline strong { color: var(--ink-900); font-weight: 600; }

  .nc-art__back { margin-bottom: clamp(14px, 2vw, 22px); }
  .nc-art__back .nc-backlink { color: var(--ink-500); }
  .nc-art__back .nc-backlink:hover { color: var(--sage-700); }
  .nc-art__eyebrow { margin: 0 0 10px; font-size: var(--text-xs); font-weight: 600; letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--sage-600); }
  .nc-art__title { margin: 0 0 clamp(18px, 2.6vw, 28px); font-size: clamp(30px, 3.6vw, 44px); line-height: 1.15; color: var(--sage-700); }
  .nc-art__hero { border-radius: var(--radius-xl); overflow: hidden; margin-bottom: clamp(20px, 3vw, 34px); aspect-ratio: 16 / 9; background: var(--sage-100); }
  .nc-art__hero img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .nc-article-body--lead > p:first-of-type { font-family: var(--font-display); font-size: 20.5px; line-height: 1.6; color: var(--ink-900); }
  .nc-art__embed { margin: 28px 0 36px; aspect-ratio: 16 / 9; border-radius: var(--radius-lg); overflow: hidden; background: #000; }
  .nc-art__embed iframe { display: block; width: 100%; height: 100%; border: 0; }

  .nc-art__tags { display: flex; flex-wrap: wrap; gap: 8px; max-width: var(--container-text); margin: clamp(26px, 3.4vw, 40px) auto 0; padding-top: 20px; border-top: 1px solid var(--border-soft, var(--ink-100)); }

  .nc-caseprods { background: var(--sage-500); padding: clamp(40px, 6vw, 76px) 0; margin-top: clamp(36px, 5vw, 64px); margin-bottom: calc(-1 * var(--section-y)); text-align: center; }
  .nc-caseprods__eyebrow { margin: 0 0 12px; font-size: var(--text-xs); font-weight: 600; letter-spacing: var(--tracking-wider); text-transform: uppercase; color: rgba(255, 255, 255, 0.75); }
  .nc-caseprods h2 { margin: 0; color: var(--cloud); font-size: clamp(26px, 3vw, 38px); }
  .nc-caseprods__sub { margin: 12px auto 0; max-width: none; color: rgba(255, 255, 255, 0.82); }
  .nc-caseprods__grid { display: grid; gap: clamp(14px, 2vw, 24px); grid-template-columns: repeat(4, minmax(0, 1fr)); margin: clamp(24px, 3.4vw, 40px) 0 0; list-style: none; padding: 0; text-align: left; }
  @media (max-width: 900px) { .nc-caseprods__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .nc-caseprods__grid { grid-template-columns: 1fr; } }
  .nc-caseprods__ctas { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: clamp(22px, 3vw, 34px); }
  .nc-caseprods.nc-on-dark .nc-product-card__title { color: var(--sage-700); }

  .nc-art__more { margin-top: clamp(36px, 5vw, 64px); }
  .nc-art__more h2 { margin-bottom: clamp(16px, 2.4vw, 26px); }
  .nc-art__more-grid { display: grid; gap: clamp(16px, 2.4vw, 28px); grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); list-style: none; margin: 0; padding: 0; }
{%- endstyle -%}

{%- if is_case -%}
  <div class="nc-casehero nc-on-dark">
    <div class="nc-container">
      <a class="nc-backlink" href="{{ blog.url }}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        Alle kundecases
      </a>
      <div class="nc-casehero__grid">
        <div class="nc-casehero__body">
          <span class="nc-casehero__pill">{% if area_label != blank %}{{ area_label }} · {% endif %}Kundecase</span>
          <h1>{{ clean_title }}</h1>
          {%- if quote != blank -%}
            <p class="nc-casehero__quote">"{{ quote }}"</p>
          {%- endif -%}
          {%- if person != blank -%}
            <div class="nc-casehero__person">
              <span class="nc-avatar" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
              </span>
              <span>
                <strong>{{ person }}</strong>
                <small>Ægte NatureCell-kunde</small>
              </span>
            </div>
          {%- endif -%}
        </div>
        <div class="nc-casehero__media">
          {%- if article.image -%}
            {{ article.image | image_url: width: 1100 | image_tag: alt: article.title, loading: 'eager', sizes: '(min-width: 900px) 590px, 94vw' }}
          {%- endif -%}
          {%- if has_video -%}
            <span class="nc-ccard__play" aria-hidden="true"><span style="width: 58px; height: 58px;"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span></span>
          {%- endif -%}
        </div>
      </div>
    </div>
    <button class="nc-casehero__fab" type="button" aria-label="Se farverne fra casen">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
    </button>
  </div>
{%- endif -%}

<div class="nc-section" {% if is_case %}style="padding-top: clamp(28px, 4vw, 48px); padding-bottom: 0;"{% endif %}>
  <div class="nc-container">
    <article class="nc-art">
      {%- if is_case -%}
        <div class="nc-art__byline">
          <span class="nc-avatar nc-avatar--light" style="width: 32px; height: 32px;" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
          </span>
          <span>Fortalt af <strong>{{ article.author }}</strong></span>
        </div>
      {%- else -%}
        <div class="nc-art__back">
          <a class="nc-backlink" href="{{ blog.url }}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            Alle artikler
          </a>
        </div>
        {%- if article.tags.first -%}
          <p class="nc-art__eyebrow">{{ article.tags.first }}</p>
        {%- endif -%}
        <h1 class="nc-art__title">{{ clean_title }}</h1>
        {%- if article.image -%}
          <div class="nc-art__hero">
            {{ article.image | image_url: width: 1400 | image_tag: alt: article.title, loading: 'eager', sizes: '(min-width: 900px) 680px, 94vw' }}
          </div>
        {%- endif -%}
      {%- endif -%}

      <div class="nc-article-body {% if is_case %}nc-case-body{% else %}nc-article-body--lead{% endif %}">
        {{ body_html }}
      </div>
    </article>

    {%- if article.tags.size > 0 and section.settings.show_tags -%}
      <div class="nc-art__tags">
        {%- for tag in article.tags limit: 6 -%}
          {%- if is_case and tag == area_tag -%}{%- continue -%}{%- endif -%}
          <a class="nc-chip" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- if is_case and section.settings.show_products and case_products != blank -%}
    {%- assign routine_name = person | default: article.author -%}
    <div class="nc-caseprods nc-on-dark">
      <div class="nc-container">
        <p class="nc-caseprods__eyebrow">{{ routine_name }}s rutine</p>
        <h2>Produkterne bag {{ routine_name }}s resultat</h2>
        <p class="nc-caseprods__sub">Shop præcis den rutine — enkeltvis, eller saml hele sættet med ét klik.</p>
        <ul class="nc-caseprods__grid">
          {%- assign case_variant_ids = '' -%}
          {%- for p in case_products limit: 4 -%}
            <li>{% render 'nc-product-card', product: p %}</li>
            {%- assign vid = p.selected_or_first_available_variant.id | append: '' -%}
            {%- if case_variant_ids == '' -%}
              {%- assign case_variant_ids = vid -%}
            {%- else -%}
              {%- assign case_variant_ids = case_variant_ids | append: ',' | append: vid -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <div class="nc-caseprods__ctas">
          <button class="nc-btn nc-btn--light" type="button" data-nc-add-all="{{ case_variant_ids }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l1 13H5L6 7Z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
            Tilføj hele rutinen · {{ case_products.size }} produkter
          </button>
          <a class="nc-btn nc-btn--outline-light" href="{{ blog.url }}">Se flere kundecases</a>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- unless is_case -%}
    <div class="nc-container">
      <div class="nc-art__more">
        <h2>Læs også</h2>
        <ul class="nc-art__more-grid">
          {%- assign shown = 0 -%}
          {%- for a in blog.articles -%}
            {%- if a.id != article.id and shown < 3 -%}
              <li>
                <a class="nc-ccard" href="{{ a.url }}">
                  <span class="nc-ccard__media nc-ccard__media--wide">
                    {%- if a.image -%}
                      {{ a.image | image_url: width: 560 | image_tag: alt: a.title, loading: 'lazy' }}
                    {%- endif -%}
                    {%- if a.tags.first -%}
                      <span class="nc-ccard__area">{{ a.tags.first }}</span>
                    {%- endif -%}
                  </span>
                  <h3 class="nc-ccard__title">{{ a.title | split: ' | ' | first }}</h3>
                </a>
              </li>
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endunless -%}
</div>

<script>
  (function () {
    var btn = document.querySelector('[data-nc-add-all]');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var ids = (btn.getAttribute('data-nc-add-all') || '').split(',').filter(Boolean);
      if (!ids.length) return;
      btn.disabled = true;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: ids.map(function (id) { return { id: parseInt(id, 10), quantity: 1 }; }) })
      }).then(function () {
        btn.disabled = false;
        if (window.ncRefreshCart) { window.ncRefreshCart(true); }
        else { window.location.href = '/cart'; }
      }).catch(function () { btn.disabled = false; window.location.href = '/cart'; });
    });
  })();
</script>

{% schema %}
{
  "name": "Artikel",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_products", "label": "Vis produkter fra casen", "default": true, "info": "Kræver metafeltet ncell.products (produktliste) på artiklen." },
    { "type": "checkbox", "id": "show_tags", "label": "Vis emne-chips under artiklen", "default": true }
  ]
}
{% endschema %}
