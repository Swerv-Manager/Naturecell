{% comment %}
  Kundeklub 1:1 fra NatureCell.dc.html: sage-hero med to knapper,
  fire fordelskort med ikon-cirkler, "Saadan virker det" med tre
  nummererede trin paa lys sage-bund, og tilmelding med e-mailfelt.
{% endcomment %}

{%- style -%}
  .nc-klub__hero { background: var(--sage-500); padding: clamp(48px, 6vw, 88px) 0; }
  .nc-klub__hero-inner { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .nc-klub__hero.nc-on-dark .nc-eyebrow { color: var(--sage-200); }
  .nc-klub__hero h1 { margin: 0; color: var(--paper); font-size: clamp(38px, 5vw, 58px); line-height: 1.05; }
  .nc-klub__hero p { margin: 0; color: rgba(246, 244, 238, 0.85); font-size: 18px; line-height: 1.7; max-width: 560px; }
  .nc-klub__hero .nc-eyebrow { font-size: var(--text-xs); line-height: 1.4; letter-spacing: var(--tracking-wider); }
  .nc-klub__hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .nc-klub__hero-ctas .nc-btn { padding-top: 16px; padding-bottom: 16px; min-height: 50px; }

  .nc-klub__perksec { padding: clamp(43px, 5vw, 72px) 0 clamp(17px, 6vw, 28px); }
  .nc-klub__head { text-align: center; max-width: 62ch; margin: 0 auto 40px; }
  .nc-klub__head h2 { margin: 0; font-size: clamp(21px, 3.3vw, 34px); }

  .nc-klub__perks { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(47%, 240px), 1fr)); }
  .nc-klub__perk { background: var(--cloud); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); padding: 28px 28px 36px; }
  .nc-klub__perk-icon { display: flex; align-items: center; justify-content: center; width: 52px; height: 52px; border-radius: 999px; background: var(--sage-100); color: var(--sage-700); margin-bottom: 12px; }
  .nc-klub__perk h3 { font-size: 20px; margin: 0 0 20px; }
  .nc-klub__perk p { margin: 0; font-size: 14.5px; line-height: 1.65; color: var(--ink-500); }

  .nc-klub__how { background: var(--sage-50); border-top: 1px solid var(--border-soft); border-bottom: 1px solid var(--border-soft); padding: clamp(50px, 7vw, 94px) 0 clamp(35px, 6vw, 64px); }
  .nc-klub__how .nc-klub__head h2 { font-size: clamp(19px, 2.9vw, 30px); }
  .nc-klub__steps { display: grid; gap: 28px; grid-template-columns: repeat(auto-fit, minmax(min(47%, 220px), 1fr)); text-align: center; max-width: 900px; margin: 0 auto; }
  .nc-klub__step strong { display: block; font-family: var(--font-display); font-weight: 400; font-size: clamp(21px, 3.3vw, 34px); color: var(--sage-400); letter-spacing: 0.04em; }
  .nc-klub__step h3 { font-size: 19px; margin: 8px 0; }
  .nc-klub__step p { margin: 0 auto; font-size: 14px; line-height: 1.6; color: var(--ink-500); max-width: 280px; }

  .nc-klub__signup { padding: clamp(40px, 6vw, 72px) 0 clamp(8px, 1vw, 12px); text-align: center; }
  .nc-klub__signup h2 { margin: 0; font-size: clamp(19px, 2.9vw, 30px); }
  .nc-klub__signup > .nc-container > p { margin: 18px auto 0; font-size: 16px; line-height: 1.7; color: var(--ink-500); max-width: 560px; }
  .nc-klub__form { display: flex; gap: 10px; max-width: 440px; margin: 18px auto 0; }
  .nc-klub__form .nc-input { flex: 1; min-width: 0; border-radius: var(--radius-pill); }
  .nc-klub__fine { margin: 22px auto 0; font-size: 12.5px; color: var(--ink-400); }

  /* Sideskopede justeringer, saa kundeklub-siden matcher det godkendte design:
     nyhedsbrevsknappen i footeren er moerk sage med lys pil, og sprogvaelgeren
     er én omkranset kapsel uden indre skillelinjer, hvor det aktive DA-segment
     er en fuldt afrundet sage-pille med lille luft til kapslens kant. */
  .nc-footer .nc-footer__form .nc-iconbtn { background: var(--sage-700, #3E5D58); border-color: var(--sage-700, #3E5D58); color: var(--paper, #F6F4EE); }
  .nc-footer .nc-footer__form .nc-iconbtn:hover, .nc-footer .nc-footer__form .nc-iconbtn:focus-visible { background: var(--sage-800, #33504b); border-color: var(--sage-800, #33504b); color: var(--paper, #F6F4EE); }
  .nc-langs { background: transparent; border: 1px solid var(--border-default); border-radius: var(--radius-pill); padding: 3px; align-items: center; overflow: hidden; }
  .nc-langs a { border-radius: var(--radius-pill, 999px); padding: 4px 11px; margin: 0; color: var(--sage-600, #4F6E68); }
  .nc-langs a.is-active { background: var(--sage-500, #80A097); color: var(--cloud, #FDFDFB); }

  /* Kundeklub-navpunktet: baade stjerne og tekst i dyb sage. */
  .nc-header__link[href*="kundeklub"] { color: var(--sage-700, #3E5D58); }
  .nc-header__link[href*="kundeklub"] .nc-header__star { color: var(--sage-700, #3E5D58); }

  /* Footer-rytme: kompaktere linkkolonner og smallere brandkolonne som i designet.
     Hoejere specificitet, da footerens eget style-blok kommer senere i kaskaden. */
  .nc-footer .nc-footer__grid ul { gap: 5px; }
  .nc-footer .nc-footer__grid ul a { line-height: 1.5; }
  .nc-footer .nc-footer__grid .nc-footer__brand p { max-width: 190px; }

  /* Footer-nyhedsbrev: fuld pille-form paa e-mailfeltet og plads nok til hele
     placeholderen "din@email.dk" (bredere nyhedsbrevskolonne + slankere pilknap). */
  .nc-footer .nc-footer__grid { grid-template-columns: 1.3fr repeat(3, minmax(140px, 1fr)) minmax(158px, 1.05fr); }
  .nc-footer .nc-footer__form .nc-input { border-radius: var(--radius-pill, 999px); padding-left: 14px; padding-right: 6px; font-size: 15px; }
  .nc-footer .nc-footer__form .nc-iconbtn { padding: 0 13px; }

  /* Footer-bundlinje: lysere footer-krop (#85A49B) og en moerkere fuldbreddes
     baandfarve (#80A097) bag copyright/disclaimer-raekken som i designet. */
  .nc-footer.nc-on-dark { background: #85A49B; }
  .nc-footer .nc-footer__bottom { background: var(--nc-footer-bg, #80A097); box-shadow: 0 0 0 100vmax var(--nc-footer-bg, #80A097); clip-path: inset(0 -100vmax); }
  .nc-footer .nc-footer__bottom p { max-width: 80ch; }
{%- endstyle -%}

<div class="nc-klub">
  <div class="nc-klub__hero nc-on-dark">
    <div class="nc-container">
      <div class="nc-klub__hero-inner">
        <p class="nc-eyebrow" style="margin: 0;">{{ section.settings.hero_eyebrow }}</p>
        <h1>{{ section.settings.hero_heading }}</h1>
        <p>{{ section.settings.hero_text }}</p>
        <div class="nc-klub__hero-ctas">
          {%- if section.settings.signup_mode == 'account' -%}
            <a class="nc-btn nc-btn--light" href="{{ routes.account_register_url }}">{{ section.settings.hero_cta1 }}</a>
          {%- else -%}
            <a class="nc-btn nc-btn--light" href="#nc-klub-tilmeld">{{ section.settings.hero_cta1 }}</a>
          {%- endif -%}
          <a class="nc-btn nc-btn--outline-light" href="{{ routes.account_login_url }}">{{ section.settings.hero_cta2 }}</a>
        </div>
      </div>
    </div>
  </div>

  <div class="nc-section nc-klub__perksec">
    <div class="nc-container">
      <div class="nc-klub__head">
        <p class="nc-eyebrow">{{ section.settings.perks_eyebrow }}</p>
        <h2>{{ section.settings.perks_heading }}</h2>
      </div>
      <div class="nc-klub__perks">
        {%- for block in section.blocks -%}
          {%- if block.type == 'perk' -%}
            <div class="nc-klub__perk" {{ block.shopify_attributes }}>
              <span class="nc-klub__perk-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  {%- case block.settings.icon -%}
                    {%- when 'star' -%}<path d="m12 2 3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.4 21.7l1.8-7.3L1.5 9.5 9 8.9Z" fill="currentColor"/>
                    {%- when 'percent' -%}<path d="M19 5 5 19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>
                    {%- when 'gift' -%}<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v9h14v-9M12 8v13M12 8S10.5 3.5 8 4.6 8.4 8 12 8ZM12 8s1.5-4.5 4-3.4S15.6 8 12 8Z"/>
                    {%- else -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
                  {%- endcase -%}
                </svg>
              </span>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%}
    App-slot til loyalitetsprogrammet (Yotpo Loyalty & Referrals): pointsaldo, "saadan
    optjener du", "saadan indloeser du" og VIP-niveauer tilfoejes som app-blokke i
    temaeditoren og vises her mellem fordelene og "Saadan virker det".
  {%- endcomment -%}
  {%- assign has_app_blocks = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}{%- assign has_app_blocks = true -%}{%- endif -%}
  {%- endfor -%}
  {%- if has_app_blocks -%}
    <div class="nc-section nc-klub__apps">
      <div class="nc-container">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}{%- render block -%}{%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <div class="nc-klub__how">
    <div class="nc-container">
      <div class="nc-klub__head" style="margin-bottom: 34px;">
        <h2>{{ section.settings.steps_heading }}</h2>
      </div>
      <div class="nc-klub__steps">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <div class="nc-klub__step" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.num }}</strong>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="nc-klub__signup" id="nc-klub-tilmeld">
    <div class="nc-container">
      <h2>{{ section.settings.cta_heading }}</h2>
      <p>{{ section.settings.cta_text }}</p>
      {%- if section.settings.signup_mode == 'account' -%}
        {%- comment -%} Pointprogrammet kraever en kundekonto: medlemskab = oprettelse af konto. {%- endcomment -%}
        <p style="margin-top: 18px;">
          <a class="nc-btn nc-btn--sage" href="{{ routes.account_register_url }}">{{ section.settings.cta_button }}</a>
        </p>
      {%- else -%}
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,kundeklub">
        <div class="nc-klub__form">
          <label class="nc-visually-hidden" for="nc-klub-email">{{ 'forms.email' | t }}</label>
          <input id="nc-klub-email" class="nc-input" type="email" name="contact[email]" placeholder="{{ 'forms.email_placeholder' | t }}" autocomplete="email" required>
          <button class="nc-btn nc-btn--sage" type="submit">{{ section.settings.cta_button }}</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p role="status" style="margin-top: 12px; color: var(--sage-700);">{{ 'forms.welcome' | t }}</p>
        {%- elsif form.errors -%}
          <p role="alert" style="margin-top: 12px;">{{ 'forms.email_error' | t }}</p>
        {%- endif -%}
      {%- endform -%}
      {%- endif -%}
      <p class="nc-klub__fine">{{ section.settings.cta_fine }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kundeklub",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Overlinje", "default": "Bliv medlem · Gratis" },
    { "type": "text", "id": "hero_heading", "label": "Overskrift", "default": "NatureCell Kundeklub" },
    { "type": "textarea", "id": "hero_text", "label": "Tekst", "default": "Bliv en del af klubben og få mere ud af din hudpleje. Optjen point på hvert køb, få 10% velkomstrabat, en fødselsdagsgave og tidlig adgang til nyheder og medlemspriser." },
    { "type": "text", "id": "hero_cta1", "label": "Primær knap", "default": "Bliv medlem →" },
    { "type": "text", "id": "hero_cta2", "label": "Sekundær knap", "default": "Allerede medlem? Log ind" },
    { "type": "header", "content": "Fordele" },
    { "type": "text", "id": "perks_eyebrow", "label": "Overlinje", "default": "Medlemsfordele" },
    { "type": "text", "id": "perks_heading", "label": "Overskrift", "default": "Fordele der plejer dig" },
    { "type": "header", "content": "Sådan virker det" },
    { "type": "text", "id": "steps_heading", "label": "Overskrift", "default": "Sådan virker det" },
    { "type": "header", "content": "Tilmelding" },
    { "type": "select", "id": "signup_mode", "label": "Tilmelding sker via", "options": [ { "value": "email", "label": "E-mailfelt (nyhedsbrev + tag kundeklub)" }, { "value": "account", "label": "Kundekonto (kræves af pointprogrammet)" } ], "default": "email", "info": "Vælg Kundekonto, når Yotpo Loyalty er aktivt: point optjenes kun på en konto." },
    { "type": "text", "id": "cta_heading", "label": "Overskrift", "default": "Meld dig ind på 30 sekunder" },
    { "type": "textarea", "id": "cta_text", "label": "Tekst", "default": "Tilmeld dig med din e-mail og få 10% på din første ordre med det samme." },
    { "type": "text", "id": "cta_button", "label": "Knaptekst", "default": "Bliv medlem" },
    { "type": "text", "id": "cta_fine", "label": "Fin print", "default": "Gratis medlemskab · afmeld når som helst · vi deler ikke dine data." }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Fordel",
      "settings": [
        { "type": "select", "id": "icon", "label": "Ikon", "options": [ { "value": "star", "label": "Stjerne" }, { "value": "percent", "label": "Procent" }, { "value": "gift", "label": "Gave" }, { "value": "clock", "label": "Ur" } ], "default": "star" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Optjen point" },
        { "type": "textarea", "id": "text", "label": "Tekst", "default": "Tjen point på hvert køb og indløs dem til rabat på din næste ordre." }
      ]
    },
    {
      "type": "step",
      "name": "Trin",
      "settings": [
        { "type": "text", "id": "num", "label": "Nummer", "default": "01" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Meld dig ind" },
        { "type": "textarea", "id": "text", "label": "Tekst", "default": "Tilmeld dig gratis med din e-mail, det tager under et minut." }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Kundeklub",
      "blocks": [
        { "type": "perk", "settings": { "icon": "star", "title": "Optjen point", "text": "Tjen point på hvert køb og indløs dem til rabat på din næste ordre." } },
        { "type": "perk", "settings": { "icon": "percent", "title": "10% velkomstrabat", "text": "Få 10% på din første ordre, når du melder dig ind i klubben." } },
        { "type": "perk", "settings": { "icon": "gift", "title": "Fødselsdagsgave", "text": "En lille overraskelse i din indbakke i din fødselsdagsmåned." } },
        { "type": "perk", "settings": { "icon": "clock", "title": "Tidlig adgang", "text": "Vær først med nyheder, kampagner og eksklusive medlemspriser." } },
        { "type": "step", "settings": { "num": "01", "title": "Meld dig ind", "text": "Tilmeld dig gratis med din e-mail, det tager under et minut." } },
        { "type": "step", "settings": { "num": "02", "title": "Handl som vanligt", "text": "Optjen point automatisk på hvert køb i webshoppen." } },
        { "type": "step", "settings": { "num": "03", "title": "Indløs & nyd", "text": "Brug dine point og fordele på din næste hudplejerutine." } }
      ]
    }
  ]
}
{% endschema %}
