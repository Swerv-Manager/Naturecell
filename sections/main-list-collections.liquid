{% comment %} Kollektionsoversigt, skelet. {% endcomment %}

{%- style -%}
  .nc-collections__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
  }

  .nc-collections__media {
    aspect-ratio: 1 / 1;
    border-radius: var(--nc-radius-media);
    overflow: hidden;
    background: var(--nc-white);
  }

  .nc-collections__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{%- endstyle -%}

<div class="nc-section">
  <div class="nc-container">
    <header style="margin-bottom: clamp(24px, 3vw, 44px);">
      <h1>{{ 'nav.collections' | t }}</h1>
    </header>

    <ul class="nc-grid" style="list-style: none; margin: 0; padding: 0;">
      {%- for collection in collections -%}
        <li>
          <a class="nc-collections__card" href="{{ collection.url }}">
            <div class="nc-collections__media">
              {%- if collection.featured_image -%}
                {{
                  collection.featured_image
                  | image_url: width: 720
                  | image_tag: alt: collection.title, loading: 'lazy'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <h2 class="nc-product-card__title">{{ collection.title }}</h2>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Kollektionsliste",
  "tag": "section",
  "settings": []
}
{% endschema %}
