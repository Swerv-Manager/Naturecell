{% comment %}
  Produktside: kundecase-split (afloeser designets opdigtede "ambassadoer").
  Kun aegte kundehistorier: kundens egne ord som citat, vores korte ramme, navn,
  link til hele casen og kundens egen video, der foerst indlaeses, naar man trykker afspil.
  Den faste disclaimer vises altid. "Vis kun paa" begraenser sektionen til de produkter,
  kunden faktisk bruger; tom liste = alle produkter.
{% endcomment %}

{%- liquid
  assign amb_show = true
  if section.settings.products != blank
    assign amb_show = false
    for p in section.settings.products
      if p.handle == product.handle
        assign amb_show = true
        break
      endif
    endfor
  endif

  assign amb_case = blank
  assign amb_case_url = section.settings.case_url
  if amb_case_url != blank and amb_case_url contains '/blogs/'
    assign amb_case_key = amb_case_url | split: '/blogs/' | last | split: '?' | first | split: '#' | first
    assign amb_case = articles[amb_case_key]
  endif

  assign amb_yt = section.settings.youtube_id | strip
  assign amb_poster = section.settings.image
  if amb_poster == blank and amb_case != blank
    assign amb_poster = amb_case.image
  endif
-%}

{%- if amb_show -%}
{%- style -%}
  #shopify-section-{{ section.id }} .nc-pdpamb { background: var(--nc-founder-bg, var(--paper-2)); border-top: 1px solid var(--border-soft); }
  #shopify-section-{{ section.id }} .nc-pdpamb__inner { max-width: 1100px; margin: 0 auto; padding: clamp(35px, 6vw, 64px) var(--gutter); display: grid; gap: clamp(28px, 5vw, 48px); grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 700px) {
    #shopify-section-{{ section.id }} .nc-pdpamb__inner { grid-template-columns: 1.15fr 0.85fr; }
  }
  #shopify-section-{{ section.id }} .nc-pdpamb__text { display: flex; flex-direction: column; gap: 16px; }
  #shopify-section-{{ section.id }} .nc-pdpamb__pill { display: inline-flex; align-self: flex-start; background: var(--sage-100); color: var(--sage-700); font-weight: 600; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; padding: 6px 13px; border-radius: 999px; }
  #shopify-section-{{ section.id }} .nc-pdpamb__text h2 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(21px, 3.3vw, 34px); line-height: 1.15; letter-spacing: normal; color: var(--sage-700); text-wrap: wrap; }
  #shopify-section-{{ section.id }} .nc-pdpamb__text > p { margin: 0; font-size: 16px; line-height: 1.8; color: var(--ink-700); }
  #shopify-section-{{ section.id }} .nc-pdpamb__who { display: flex; align-items: center; gap: 12px; margin-top: 6px; }
  #shopify-section-{{ section.id }} .nc-pdpamb__avatar { width: 44px; height: 44px; border-radius: 999px; background: var(--sage-200); flex: none; overflow: hidden; }
  #shopify-section-{{ section.id }} .nc-pdpamb__avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .nc-pdpamb__who-name { display: flex; flex-direction: column; }
  #shopify-section-{{ section.id }} .nc-pdpamb__who-name strong { font-weight: 600; font-size: 14px; color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-pdpamb__who-name span { font-size: 12.5px; color: var(--ink-400); }
  #shopify-section-{{ section.id }} .nc-pdpamb__link { display: inline-flex; align-self: flex-start; gap: 8px; margin-top: 4px; font-weight: 600; font-size: 14.5px; color: var(--sage-700); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  #shopify-section-{{ section.id }} .nc-pdpamb__note { margin: 0; font-size: 12.5px; line-height: 1.6; color: var(--ink-400); }
  #shopify-section-{{ section.id }} .nc-pdpamb__media { position: relative; width: 100%; max-width: 360px; justify-self: center; aspect-ratio: 9 / 16; border-radius: 18px; overflow: hidden; background: var(--sage-200); box-shadow: var(--shadow-sm); }
  #shopify-section-{{ section.id }} .nc-pdpamb__media--photo { max-width: none; aspect-ratio: 4 / 5; }
  #shopify-section-{{ section.id }} .nc-pdpamb__media img, #shopify-section-{{ section.id }} .nc-pdpamb__media iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; object-fit: cover; }
  #shopify-section-{{ section.id }} .nc-pdpamb__play { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: pointer; }
  #shopify-section-{{ section.id }} .nc-pdpamb__play span { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 66px; height: 66px; border-radius: 999px; background: rgba(255, 255, 255, 0.94); display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-md); transition: transform var(--dur-fast) var(--ease-soft); }
  #shopify-section-{{ section.id }} .nc-pdpamb__play:hover span, #shopify-section-{{ section.id }} .nc-pdpamb__play:focus-visible span { transform: translate(-50%, -50%) scale(1.06); }
{%- endstyle -%}

<section class="nc-pdpamb">
  <div class="nc-pdpamb__inner">
    <div class="nc-pdpamb__text">
      {%- if section.settings.pill != blank -%}<span class="nc-pdpamb__pill">{% render 'nc-cbd', text: section.settings.pill %}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{% render 'nc-cbd', text: section.settings.heading %}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<p>{% render 'nc-cbd', text: section.settings.body %}</p>{%- endif -%}
      {%- if section.settings.name != blank -%}
        <div class="nc-pdpamb__who">
          <span class="nc-pdpamb__avatar">
            {%- if section.settings.avatar != blank -%}
              {{ section.settings.avatar | image_url: width: 120 | image_tag: alt: '', loading: 'lazy' }}
            {%- elsif amb_case.image -%}
              {{ amb_case.image | image_url: width: 120 | image_tag: alt: '', loading: 'lazy' }}
            {%- endif -%}
          </span>
          <span class="nc-pdpamb__who-name">
            <strong>{% render 'nc-cbd', text: section.settings.name %}</strong>
            {%- if section.settings.role != blank -%}<span>{% render 'nc-cbd', text: section.settings.role %}</span>{%- endif -%}
          </span>
        </div>
      {%- endif -%}
      {%- if amb_case_url != blank and section.settings.link_label != blank -%}
        <a class="nc-pdpamb__link" href="{% render 'nc-url', url: amb_case_url %}">{% render 'nc-cbd', text: section.settings.link_label %} <span aria-hidden="true">→</span></a>
      {%- endif -%}
      <p class="nc-pdpamb__note">{{ 'general.reviews_disclaimer' | t }}</p>
    </div>
    {%- if amb_yt != blank or amb_poster != blank -%}
      <div class="nc-pdpamb__media{% if amb_yt == blank %} nc-pdpamb__media--photo{% endif %}">
        {%- if amb_poster != blank -%}
          {{ amb_poster | image_url: width: 900 | image_tag: alt: '', loading: 'lazy', sizes: '(min-width: 700px) 360px, 90vw' }}
        {%- elsif amb_yt != blank -%}
          <img src="https://img.youtube.com/vi/{{ amb_yt }}/hqdefault.jpg" alt="" loading="lazy" width="480" height="360">
        {%- endif -%}
        {%- if amb_yt != blank -%}
          {%- assign amb_label = section.settings.name | default: section.settings.pill -%}
          <button type="button" class="nc-pdpamb__play" data-nc-embed="https://www.youtube-nocookie.com/embed/{{ amb_yt }}?autoplay=1&rel=0&playsinline=1" data-nc-embed-title="{{ amb_label | escape }}" aria-label="{{ 'general.play_video' | t }}: {{ amb_label | escape }}">
            <span aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="var(--sage-700)"><path d="M8 5v14l11-7z"/></svg></span>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Produkt: kundecase",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Kun ægte kundehistorier. Overskriften er kundens egne ord, brødteksten er vores korte ramme uden løfter. Den faste disclaimer vises altid." },
    { "type": "product_list", "id": "products", "label": "Vis kun på disse produkter", "info": "Tom = alle produkter. Vælg de produkter, kunden selv bruger.", "limit": 50 },
    { "type": "text", "id": "pill", "label": "Pill", "default": "Kundecase" },
    { "type": "text", "id": "heading", "label": "Kundens egne ord (citat)" },
    { "type": "textarea", "id": "body", "label": "Brødtekst" },
    { "type": "text", "id": "name", "label": "Navn" },
    { "type": "text", "id": "role", "label": "Undertekst under navnet" },
    { "type": "image_picker", "id": "avatar", "label": "Avatar", "info": "Tom = kundecasens billede." },
    { "type": "url", "id": "case_url", "label": "Link til kundecasen", "info": "Vælg blogindlægget. Billedet fra casen bruges som plakat, hvis der ikke er valgt et billede herunder." },
    { "type": "text", "id": "link_label", "label": "Linktekst", "default": "Læs hele historien" },
    { "type": "text", "id": "youtube_id", "label": "YouTube-video (id)", "info": "Fx UQQF2NPfATE. Indlæses først, når kunden trykker afspil." },
    { "type": "image_picker", "id": "image", "label": "Plakat (valgfri)" }
  ],
  "presets": [ { "name": "Produkt: kundecase" } ]
}
{% endschema %}
