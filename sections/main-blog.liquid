{% comment %}
  Blogoversigt 1:1 fra NatureCell.dc.html.
  Kundecases: bleg groen hero, omraadechips + soegning, 4-kolonners
  case-kort med omraade-tag, VIDEO-pill og play-cirkel, navn under titlen.
  Artikler: samme hero, tag-chips + soegning, featured "NYESTE"-kort og
  3-kolonners artikelkort med tag-pill paa billedet, uddrag og "Laes mere".
{% endcomment %}

{%- liquid
  assign is_cases = false
  if blog.handle == 'kundecases'
    assign is_cases = true
  endif

  assign eyebrow = section.settings.eyebrow
  assign intro = section.settings.intro
  if eyebrow == blank
    if is_cases
      assign eyebrow = 'Ægte oplevelser'
    else
      assign eyebrow = 'Viden & inspiration'
    endif
  endif
  if intro == blank
    if is_cases
      assign intro = 'Vi lover ikke mirakler. I stedet lader vi vores kunder fortælle deres egen historie — med billeder, video og de produkter, de bruger. Resultater kan variere fra person til person.'
    else
      assign intro = 'Guides, ekspertråd og historierne bag NatureCell — om CBD, hudpleje og en hud i balance. Resultater kan variere fra person til person.'
    endif
  endif
-%}

{%- style -%}
  .nc-band__title { font-size: clamp(30px, 3vw, 42px); }

  .nc-blogidx__grid { display: grid; gap: clamp(18px, 2.4vw, 26px); grid-template-columns: repeat(2, 1fr); list-style: none; margin: 0; padding: 0; }
  .nc-blogidx__grid--cases { gap: clamp(16px, 2.2vw, 24px); }
  @media (min-width: 700px) { .nc-blogidx__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 990px) { .nc-blogidx__grid--cases { grid-template-columns: repeat(4, 1fr); } }

  .nc-featart { display: grid; grid-template-columns: 1fr; border-radius: var(--radius-lg); overflow: hidden; background: var(--cloud); box-shadow: var(--shadow-sm); margin-bottom: clamp(26px, 3.6vw, 42px); text-decoration: none; color: inherit; }
  .nc-featart:hover { text-decoration: none; }
  @media (min-width: 900px) { .nc-featart { grid-template-columns: 1.05fr 1fr; } }
  .nc-featart__media { position: relative; min-height: 260px; background: var(--sage-100); }
  .nc-featart__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .nc-featart__body { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 14px; padding: clamp(22px, 3.4vw, 48px); }
  .nc-featart__pill { display: inline-flex; padding: 6px 12px; border-radius: var(--radius-pill); background: var(--sage-50); color: var(--sage-700); font-size: 11px; font-weight: 600; letter-spacing: var(--tracking-wider); text-transform: uppercase; }
  .nc-featart__body h2 { margin: 0; font-size: clamp(24px, 2.7vw, 34px); line-height: 1.2; color: var(--sage-700); }
  .nc-featart__body p { margin: 0; color: var(--ink-700); line-height: 1.7; }
  .nc-featart__more { display: inline-flex; align-items: center; gap: 6px; font-size: 14.5px; font-weight: 600; color: var(--ink-900); }
  .nc-featart:hover .nc-featart__more { color: var(--sage-700); }

  .nc-blogidx__empty { padding: 40px 0; color: var(--ink-500); }
{%- endstyle -%}

<div class="nc-band nc-band--pale nc-band--center">
  <div class="nc-container">
    <p class="nc-band__eyebrow">{{ eyebrow }}</p>
    <h1 class="nc-band__title">{{ blog.title }}</h1>
    <p class="nc-band__intro">{{ intro }}</p>
  </div>
</div>

<div class="nc-section" style="padding-top: clamp(6px, 0.6vw, 8px); padding-bottom: 0;">
  <div class="nc-container" data-nc-bloglist>
    {%- paginate blog.articles by 24 -%}
      <div class="nc-blogtools">
        {%- if section.settings.show_tags -%}
          <div class="nc-blogtools__chips" aria-label="Filtrér efter emne">
            <a class="nc-chip {% unless current_tags %}is-active{% endunless %}" href="{{ blog.url }}">{% if is_cases %}Alle cases{% else %}Alle{% endif %}</a>
            {%- if is_cases -%}
              {%- assign area_names = 'Ansigt,Hænder,Fødder' | split: ',' -%}
              {%- for area in area_names -%}
                {%- assign area_dc = area | downcase -%}
                {%- assign chip_tag = '' -%}
                {%- for tag in blog.all_tags -%}
                  {%- assign tag_dc = tag | downcase -%}
                  {%- if tag_dc == area_dc -%}
                    {%- assign chip_tag = tag -%}
                    {%- break -%}
                  {%- elsif chip_tag == blank and tag_dc contains area_dc -%}
                    {%- assign chip_tag = tag -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if chip_tag != blank -%}
                  <a class="nc-chip {% if current_tags contains chip_tag %}is-active{% endif %}" href="{{ blog.url }}/tagged/{{ chip_tag | handle }}">{{ area }}</a>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- for tag in blog.all_tags limit: 15 -%}
                <a class="nc-chip {% if current_tags contains tag %}is-active{% endif %}" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}
        <div class="nc-blogtools__search">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.4-3.4"/></svg>
          <label class="nc-visually-hidden" for="nc-blog-search">Søg</label>
          <input id="nc-blog-search" type="search" placeholder="{% if is_cases %}Søg på område, navn ...{% else %}Søg i artikler ...{% endif %}" data-nc-blog-search autocomplete="off">
        </div>
      </div>

      {%- unless is_cases or current_tags or paginate.current_page > 1 -%}
        {%- assign feat = blog.articles.first -%}
        {%- if feat -%}
          <a class="nc-featart" href="{{ feat.url }}">
            <span class="nc-featart__media">
              {%- if feat.image -%}
                {{ feat.image | image_url: width: 1400 | image_tag: alt: feat.title, loading: 'eager', sizes: '(min-width: 900px) 620px, 94vw' }}
              {%- endif -%}
            </span>
            <span class="nc-featart__body">
              <span class="nc-featart__pill">Nyeste{% if feat.tags.first %} · {{ feat.tags.first }}{% endif %}</span>
              <h2>{{ feat.title | split: ' | ' | first }}</h2>
              <p>{{ feat.excerpt_or_content | strip_html | truncate: 300 }}</p>
              <span class="nc-featart__more">Læs mere <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </span>
          </a>
        {%- endif -%}
      {%- endunless -%}

      <ul class="nc-blogidx__grid {% if is_cases %}nc-blogidx__grid--cases{% endif %}">
        {%- for article in blog.articles -%}
          {%- if is_cases == false and current_tags == blank and paginate.current_page == 1 and forloop.first -%}
            {%- continue -%}
          {%- endif -%}

          {%- liquid
            assign area_tag = ''
            assign area_label = ''
            for tag in article.tags
              assign lt = tag | downcase
              if area_label == blank
                if lt contains 'ansigt'
                  assign area_label = 'Ansigt'
                  assign area_tag = tag
                elsif lt contains 'hænder' or lt contains 'haender' or lt contains 'håndcreme'
                  assign area_label = 'Hænder'
                  assign area_tag = tag
                elsif lt contains 'fødder' or lt contains 'foedder' or lt contains 'fodcreme'
                  assign area_label = 'Fødder'
                  assign area_tag = tag
                elsif lt == 'krop'
                  assign area_label = 'Krop'
                  assign area_tag = tag
                endif
              endif
            endfor
            assign has_video = false
            if article.content contains 'youtube' or article.content contains 'youtu.be' or article.content contains '<video'
              assign has_video = true
            endif
            assign clean_title = article.title | split: ' | ' | first
            assign person = article.metafields.ncell.name | default: ''
          -%}

          <li data-nc-blog-item data-nc-search-text="{{ clean_title | downcase | escape }} {{ person | downcase | escape }} {{ article.tags | join: ' ' | downcase | escape }}">
            <a class="nc-ccard" href="{{ article.url }}">
              <span class="nc-ccard__media {% unless is_cases %}nc-ccard__media--wide{% endunless %}">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 640 | image_tag: alt: article.title, loading: 'lazy', sizes: '(min-width: 990px) 300px, 46vw' }}
                {%- endif -%}
                {%- if is_cases -%}
                  {%- if area_label != blank -%}
                    <span class="nc-ccard__area">{{ area_label }}</span>
                  {%- endif -%}
                  {%- if has_video -%}
                    <span class="nc-ccard__video"><svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>Video</span>
                    <span class="nc-ccard__play" aria-hidden="true"><span><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span></span>
                  {%- endif -%}
                {%- elsif article.tags.first -%}
                  <span class="nc-ccard__area">{{ article.tags.first }}</span>
                {%- endif -%}
              </span>
              <h3 class="nc-ccard__title">{{ clean_title }}</h3>
              {%- if is_cases -%}
                {%- if person != blank -%}
                  <span class="nc-ccard__who">{{ person }}</span>
                {%- endif -%}
              {%- else -%}
                <p class="nc-ccard__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 260 }}</p>
                <span class="nc-ccard__more">Læs mere <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
      <p class="nc-blogidx__empty" data-nc-blog-empty hidden>Ingen resultater. Prøv et andet søgeord.</p>

      {%- if paginate.pages > 1 -%}
        <nav class="nc-pagination" aria-label="Sider">
          {{ paginate | default_pagination }}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

<script>
  (function () {
    var wrap = document.querySelector('[data-nc-bloglist]');
    if (!wrap) return;
    var input = wrap.querySelector('[data-nc-blog-search]');
    var items = wrap.querySelectorAll('[data-nc-blog-item]');
    var empty = wrap.querySelector('[data-nc-blog-empty]');
    if (!input || !items.length) return;
    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase();
      var shown = 0;
      items.forEach(function (li) {
        var hit = !q || (li.getAttribute('data-nc-search-text') || '').indexOf(q) !== -1;
        li.hidden = !hit;
        if (hit) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    });
  })();
</script>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "info": "Tom = automatisk pr. blog (Ægte oplevelser / Viden & inspiration)" },
    { "type": "textarea", "id": "intro", "label": "Introtekst", "info": "Tom = automatisk pr. blog" },
    { "type": "checkbox", "id": "show_tags", "label": "Vis emne-chips", "default": true }
  ]
}
{% endschema %}
