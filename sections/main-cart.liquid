{% comment %} Kurv, skelet. {% endcomment %}

{%- style -%}
  .nc-cart__item {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .nc-cart__item img {
    width: 72px;
    height: 72px;
    object-fit: contain;
    border-radius: var(--nc-radius-media);
    background: var(--nc-white);
    padding: 6px;
  }

  .nc-cart__item a {
    text-decoration: none;
    font-weight: 500;
  }

  .nc-cart__qty {
    width: 80px;
  }

  .nc-cart__footer {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    margin-top: 24px;
  }

  .nc-cart__subtotal {
    font-size: clamp(18px, 1.8vw, 22px);
    font-family: var(--nc-font-display);
    font-weight: var(--nc-weight-display);
  }

  .nc-cart__note {
    font-size: 12px;
    color: rgba(44, 70, 61, 0.65);
  }

  .nc-cart__meta { font-size: 13px; color: rgba(44, 70, 61, 0.65); }
  .nc-cart__discount { color: var(--accent-berry); }
  .nc-cart__was { color: var(--ink-400); font-weight: 400; margin-right: 4px; }
  .nc-cart__savings { font-size: 14px; color: var(--accent-berry); }
{%- endstyle -%}

<div class="nc-section">
  <div class="nc-container">
    <h1>{{ 'nav.cart' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      {%- form 'cart', cart -%}
        <table class="nc-cart__table">
          <thead>
            <tr>
              <th scope="col">{{ 'cart.item' | t }}</th>
              <th scope="col">{{ 'cart.quantity' | t }}</th>
              <th scope="col">{{ 'cart.price' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <div class="nc-cart__item">
                    {%- if item.image -%}
                      {{ item.image | image_url: width: 144 | image_tag: alt: item.title, loading: 'lazy' }}
                    {%- endif -%}
                    <div>
                      <a href="{{ item.url }}">{{ item.product.title }}</a>
                      {%- unless item.product.has_only_default_variant -%}
                        <div style="font-size: 13px; color: rgba(44,70,61,0.65);">{{ item.variant.title }}</div>
                      {%- endunless -%}
                      {%- if item.unit_price_measurement -%}
                        <div class="nc-cart__meta">{{ item.unit_price | money }} / {% if item.unit_price_measurement.reference_value != 1 %}{{ item.unit_price_measurement.reference_value }} {% endif %}{{ item.unit_price_measurement.reference_unit }}</div>
                      {%- endif -%}
                      {%- comment -%} Rabatter (fx Katchings maengderabat) kommer fra Shopify som discount allocations. {%- endcomment -%}
                      {%- for d in item.line_level_discount_allocations -%}
                        <div class="nc-cart__meta nc-cart__discount">{{ d.discount_application.title }} (−{{ d.amount | money }})</div>
                      {%- endfor -%}
                      <div>
                        <a href="{{ item.url_to_remove }}" style="font-size: 13px;">{{ 'cart.remove' | t }}</a>
                      </div>
                    </div>
                  </div>
                </td>
                <td>
                  <label class="nc-visually-hidden" for="nc-cart-qty-{{ forloop.index }}">{{ 'cart.quantity' | t }}</label>
                  <input
                    id="nc-cart-qty-{{ forloop.index }}"
                    class="nc-input nc-cart__qty"
                    type="number"
                    name="updates[]"
                    min="0"
                    value="{{ item.quantity }}"
                  >
                </td>
                <td>
                  {%- if item.line_level_total_discount > 0 -%}<s class="nc-cart__was">{{ item.original_line_price | money }}</s> {% endif -%}
                  {{ item.final_line_price | money }}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="nc-cart__footer">
          {%- if cart.total_discount > 0 -%}
            <div class="nc-cart__savings">{{ 'cart.you_save' | t }}: {{ cart.total_discount | money }}</div>
          {%- endif -%}
          <div class="nc-cart__subtotal">{{ 'cart.subtotal' | t }}: {{ cart.total_price | money }}</div>
          <p class="nc-cart__note">{{ section.settings.shipping_note }}</p>
          <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <button class="nc-btn nc-btn--outline" type="submit" name="update">{{ 'cart.update' | t }}</button>
            <button class="nc-btn nc-btn--primary" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      {%- endform -%}
    {%- else -%}
      <p>{{ 'cart.empty_dot' | t }}</p>
      <a class="nc-btn nc-btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'general.view_all_products' | t }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kurv",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Fragtnote",
      "default": "Fragt beregnes ved kassen. Gratis levering ved ordrer over 399 kr.",
      "info": "Hold beløbsgrænsen i sync med butikkens faktiske fragtindstillinger."
    }
  ]
}
{% endschema %}
