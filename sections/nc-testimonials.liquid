{% comment %}
  "Det siger vores kunder" fra designet: centreret overskrift,
  samlet rating-linje og to modsat-loebende marquee-raekker af
  anmeldelseskort.
{% endcomment %}

{%- style -%}
  /* 1:1 fra designets TESTIMONIALS: sage-50 flade, 1px linje over, 64px top/bund, hoved + 40 under, raekker gap 20 */
  .nc-testi { background: var(--nc-testimonials-bg); border-top: 1px solid var(--border-soft); overflow: hidden; }
  #shopify-section-{{ section.id }} .nc-testi.nc-section { padding: clamp(37px, 7vw, 64px) 0; }
  .nc-testi__head { max-width: var(--container-max); margin: 0 auto 40px; padding: 0 var(--gutter); text-align: center; }
  /* Designets eyebrow er en inline span i en 16px/1.7 linjeboks (27.2px) */
  #shopify-section-{{ section.id }} .nc-testi__head .nc-eyebrow { margin: 0; line-height: 27.2px; letter-spacing: 0.14em; color: var(--sage-600); }
  .nc-testi__head h2 { margin: 10px 0 14px; font-size: clamp(24px, 3.7vw, 38px); line-height: 1.7; letter-spacing: normal; color: var(--sage-700); }
  .nc-testi__agg { display: inline-flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 12px; margin: 0; font-size: 15px; line-height: 1.7; color: var(--ink-700); vertical-align: top; }
  .nc-testi__agg .nc-stars { gap: 3px; color: var(--sage-500); }
  .nc-testi__agg .nc-stars svg { width: 22px; height: 22px; }
  .nc-testi__agg strong { color: var(--sage-700); }
  .nc-testi__rows { display: flex; flex-direction: column; gap: 20px; }
  .nc-testi .nc-rail { gap: 20px; animation-duration: 60s; }
  /* Kort: 360px, hvid, 1px soft-kant, 24px padding, kolonne-gap 12, citat i Philosopher 16/1.6 sage-700 */
  .nc-testi__card { display: flex; flex-direction: column; gap: 12px; width: 360px; flex: none; background: var(--cloud); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow-sm); }
  .nc-testi__card .nc-stars { gap: 2px; color: var(--sage-500); }
  .nc-testi__card .nc-stars svg { width: 16px; height: 16px; }
  .nc-testi__card p { margin: 0; font-family: var(--font-display); font-size: 16px; line-height: 1.6; color: var(--sage-700); }
  .nc-testi__who { margin-top: auto; display: flex; flex-direction: column; gap: 2px; }
  .nc-testi__card strong { display: block; font-size: 14px; font-weight: 600; line-height: 1.7; color: var(--sage-700); }
  .nc-testi__card small { display: block; font-size: 12.5px; line-height: 1.7; color: var(--ink-400); }
{%- endstyle -%}

<section class="nc-testi nc-section">
  <div class="nc-testi__head">
    <p class="nc-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.agg_text != blank -%}
      <div class="nc-testi__agg">
        <span class="nc-stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 24 24"><path d="m12 2 3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.4 21.7l1.8-7.3L1.5 9.5 9 8.9Z"/></svg>
          {%- endfor -%}
        </span>
        <span>{{ section.settings.agg_text }}</span>
      </div>
    {%- endif -%}
  </div>

  <div class="nc-testi__rows">
    {%- assign half = section.blocks.size | divided_by: 2 -%}
    <div class="nc-marqwrap">
      <div class="nc-rail">
        {%- for i in (1..2) -%}
          {%- for block in section.blocks limit: half -%}
            <div class="nc-testi__card" {{ block.shopify_attributes }}>
              <span class="nc-stars" aria-hidden="true">
                {%- for s in (1..5) -%}
                  <svg viewBox="0 0 24 24"><path d="m12 2 3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.4 21.7l1.8-7.3L1.5 9.5 9 8.9Z"/></svg>
                {%- endfor -%}
              </span>
              <p>"{{ block.settings.text }}"</p>
              <div class="nc-testi__who">
                <strong>{{ block.settings.name }}</strong>
                <small>{{ block.settings.meta }}</small>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="nc-marqwrap">
      <div class="nc-rail nc-rail--rev">
        {%- for i in (1..2) -%}
          {%- for block in section.blocks offset: half -%}
            <div class="nc-testi__card">
              <span class="nc-stars" aria-hidden="true">
                {%- for s in (1..5) -%}
                  <svg viewBox="0 0 24 24"><path d="m12 2 3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.4 21.7l1.8-7.3L1.5 9.5 9 8.9Z"/></svg>
                {%- endfor -%}
              </span>
              <p>"{{ block.settings.text }}"</p>
              <div class="nc-testi__who">
                <strong>{{ block.settings.name }}</strong>
                <small>{{ block.settings.meta }}</small>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Anmeldelser",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Anmeldelser" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Det siger vores kunder" },
    { "type": "inline_richtext", "id": "agg_text", "label": "Samlet rating", "default": "<strong>4,8</strong> ud af 5 · <strong>2.143</strong> anmeldelser", "info": "Skal matche jeres aktuelle, dokumenterbare tal." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Anmeldelse",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Citat", "default": "Jeg er vild med olien. Den trækker hurtigt ind og min hud føles blød hele dagen." },
        { "type": "text", "id": "name", "label": "Navn", "default": "Mette K." },
        { "type": "text", "id": "meta", "label": "Meta", "default": "Verificeret køb · CBD Hudplejeolie" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Anmeldelser",
      "blocks": [
        { "type": "review", "settings": { "text": "Jeg er vild med olien. Den trækker hurtigt ind og min hud føles blød hele dagen.", "name": "Mette K.", "meta": "Verificeret køb · CBD Hudplejeolie" } },
        { "type": "review", "settings": { "text": "Hele sættet er bare gennemtænkt. Fragten var hurtig, og jeg sparede en del på pakken.", "name": "Lars P.", "meta": "Verificeret køb · Komplet pakke" } },
        { "type": "review", "settings": { "text": "Endelig en dagcreme der ikke strammer. Let og fugtgivende. Den er fast i min rutine nu.", "name": "Camilla B.", "meta": "Verificeret køb · Dagcreme" } },
        { "type": "review", "settings": { "text": "Bruger den efter træning hver dag. Ingen parfume, bare god pleje.", "name": "Jonas H.", "meta": "Verificeret køb · Bodylotion" } },
        { "type": "review", "settings": { "text": "Serummet giver lige det ekstra fugt min hud manglede. Mærkbar forskel.", "name": "Rikke S.", "meta": "Verificeret køb · Serum" } },
        { "type": "review", "settings": { "text": "Tryg handel og dansk produktion. Det betyder noget for mig.", "name": "Thomas E.", "meta": "Verificeret køb · CBD Drops" } },
        { "type": "review", "settings": { "text": "Efter kun 3 uger med olien ser min hud meget roligere og mere ensartet ud. Fantastisk.", "name": "Bente", "meta": "Verificeret køb · CBD Hudplejeolie" } },
        { "type": "review", "settings": { "text": "Min hud føltes rød og irriteret. Efter en måned føles den mere rolig og velplejet.", "name": "Emma", "meta": "Verificeret køb · Komplet pakke" } },
        { "type": "review", "settings": { "text": "Jeg brugte olien før cremen. Efter et par måneder føltes huden mere jævn. Helt vildt.", "name": "Birte", "meta": "Verificeret køb · CBD Hudplejeolie" } },
        { "type": "review", "settings": { "text": "Jeg bruger rens og olie hver aften. Min hud føles nu mere i balance.", "name": "Julie", "meta": "Verificeret køb · CBD Rensegel" } },
        { "type": "review", "settings": { "text": "Allerede fra første påføring føltes min hud mere rolig og i bedre balance.", "name": "Sally", "meta": "Verificeret køb · CBD Hudplejeolie" } },
        { "type": "review", "settings": { "text": "Efter en måneds brug virkede huden mere rolig og velplejet. Jeg har kun godt at sige.", "name": "Karin", "meta": "Verificeret køb · CBD Håndcreme" } },
        { "type": "review", "settings": { "text": "NatureCells CBD hudpleje har gjort en forskel for min hud. Rigtig gode produkter.", "name": "Jan", "meta": "Verificeret køb · Komplet pakke" } },
        { "type": "review", "settings": { "text": "Natcremen er blevet mit lille aftenritual. Huden føles mere udhvilet om morgenen.", "name": "Pernille M.", "meta": "Verificeret køb · Natcreme" } }
      ]
    }
  ]
}
{% endschema %}
