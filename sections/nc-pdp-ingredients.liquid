{% comment %}
  Produktside: "Hovedingredienser"-kort 1:1 fra NatureCell.dc.html.
  4 kort med foto, badge-pill (formaal), navn og funktionslinje, plus
  outline-knap til ingredienssiden. Egen sektion saa den delte
  nc-ingredients (page.ingredienser) ikke roeres.
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} .nc-pdping { padding: 64px 0 0; }
  #shopify-section-{{ section.id }} .nc-pdping__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  #shopify-section-{{ section.id }} .nc-pdping__intro { display: flex; flex-direction: column; gap: 6px; max-width: 560px; }
  #shopify-section-{{ section.id }} .nc-pdping__eyebrow { font-family: var(--font-body); font-weight: 600; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sage-600); }
  #shopify-section-{{ section.id }} .nc-pdping__intro h2 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 28px; line-height: var(--leading-relaxed); letter-spacing: normal; color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-pdping__intro p { margin: 2px 0 0; font-size: 15px; line-height: 1.6; color: var(--ink-500); }
  #shopify-section-{{ section.id }} .nc-pdping__btn { display: inline-flex; align-items: center; border: 1.5px solid var(--sage-500); background: transparent; cursor: pointer; font-family: var(--font-body); font-weight: 600; font-size: 14px; color: var(--sage-700); padding: 12px 22px; border-radius: 999px; white-space: nowrap; text-decoration: none; line-height: normal; }
  #shopify-section-{{ section.id }} .nc-pdping__btn:hover { background: var(--sage-50); }
  #shopify-section-{{ section.id }} .nc-pdping__rail { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; overscroll-behavior-x: contain; padding-bottom: 6px; }
  #shopify-section-{{ section.id }} .nc-pdping__rail::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .nc-pdping__card { scroll-snap-align: start; flex: 0 0 calc((100% - 48px) / 4); min-width: 172px; border: 1px solid var(--border-soft); border-radius: var(--radius-lg); overflow: hidden; background: var(--cloud); display: flex; flex-direction: column; padding: 0; text-align: left; text-decoration: none; transition: box-shadow var(--dur-base) var(--ease-soft), transform var(--dur-base) var(--ease-soft); }
  #shopify-section-{{ section.id }} .nc-pdping__card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }
  #shopify-section-{{ section.id }} .nc-pdping__media { position: relative; width: 100%; aspect-ratio: 1 / 1; background: var(--sage-50); overflow: hidden; }
  #shopify-section-{{ section.id }} .nc-pdping__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .nc-pdping__pill { position: absolute; left: 10px; bottom: 10px; background: var(--paper); color: var(--sage-700); font-family: var(--font-body); font-weight: 700; font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; padding: 6px 12px; border-radius: 999px; box-shadow: var(--shadow-sm); line-height: normal; }
  #shopify-section-{{ section.id }} .nc-pdping__meta { padding: 14px 14px 16px; display: flex; flex-direction: column; gap: 3px; line-height: normal; }
  #shopify-section-{{ section.id }} .nc-pdping__name { font-family: var(--font-display); font-weight: 400; font-size: 15px; color: var(--sage-700); line-height: 1.2; }
  /* Designets kort er en <button> uden font-family: funktionslinjen arver browserens
     knap-skrift (Arial-metrik) — ikke Roboto Flex. Spejles, saa bredden matcher (160px). */
  #shopify-section-{{ section.id }} .nc-pdping__fn { font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: var(--ink-400); }
{%- endstyle -%}

<div class="nc-pdping">
  <div class="nc-container">
    <div class="nc-pdping__head">
      <div class="nc-pdping__intro">
        <span class="nc-pdping__eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.intro | replace: '[produkt]', product.title }}</p>
      </div>
      <a class="nc-pdping__btn" href="{{ section.settings.button_url }}">{{ section.settings.button_label }}</a>
    </div>
    <div class="nc-pdping__rail">
      {%- for block in section.blocks -%}
        <a class="nc-pdping__card" href="{{ section.settings.button_url }}#ing-{{ block.settings.name | handleize }}" {{ block.shopify_attributes }}>
          <span class="nc-pdping__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 480 | image_tag: alt: block.settings.name, loading: 'lazy' }}
            {%- elsif block.settings.image_url != blank -%}
              <img src="{{ block.settings.image_url }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="480" height="480">
            {%- endif -%}
            <span class="nc-pdping__pill">{{ block.settings.purpose }}</span>
          </span>
          <span class="nc-pdping__meta">
            <span class="nc-pdping__name">{{ block.settings.name }}</span>
            <span class="nc-pdping__fn">{{ block.settings.fn }}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Produkt: ingredienser",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Hovedingredienser" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Hvad der virker – og hvorfor" },
    { "type": "textarea", "id": "intro", "label": "Intro ([produkt] = produktnavn)", "default": "De vigtigste aktive ingredienser i [produkt] — hver med sit tydelige formål for din hud." },
    { "type": "text", "id": "button_label", "label": "Knap: tekst", "default": "Udforsk alle ingredienser →" },
    { "type": "text", "id": "button_url", "label": "Knap: link", "info": "Sti eller URL. Shopify tillader ikke standardværdi på url-typen.", "default": "/pages/ingredienser" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingrediens",
      "settings": [
        { "type": "text", "id": "name", "label": "Navn", "default": "CBD" },
        { "type": "text", "id": "purpose", "label": "Badge (formål)", "default": "Balance" },
        { "type": "text", "id": "fn", "label": "Funktion", "default": "Skin conditioning · antioxidant" },
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "image_url", "label": "Foto-URL (fallback)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Produkt: ingredienser",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "CBD", "purpose": "Balance", "fn": "Skin conditioning · antioxidant", "image_url": "https://cdn.shopify.com/s/files/1/0600/7111/6981/files/NatureCell_Ingrediens_Slider_CBD_180x480px.jpg?v=1762184205" } },
        { "type": "ingredient", "settings": { "name": "MCT-olie", "purpose": "Silkeblød", "fn": "Emollient", "image_url": "https://cdn.shopify.com/s/files/1/0600/7111/6981/files/NatureCell_Ingrediens_Slider_Caprylic_Capric_Triglyceride_180x480px.jpg?v=1762792242" } },
        { "type": "ingredient", "settings": { "name": "Hampolie", "purpose": "Næring", "fn": "Skin conditioning", "image_url": "https://cdn.shopify.com/s/files/1/0600/7111/6981/files/NatureCell_Ingrediens_Slider_Cannabis_Sativa_Leaf_Extract_180x480px.jpg?v=1762792242" } },
        { "type": "ingredient", "settings": { "name": "E-vitamin", "purpose": "Beskyttelse", "fn": "Antioxidant", "image_url": "https://cdn.shopify.com/s/files/1/0600/7111/6981/files/NatureCell_Ingrediens_Slider_Tocopherol_180x480px.jpg?v=1762792241" } }
      ]
    }
  ]
}
{% endschema %}
