{% comment %}
  "Kundernes favoritter" fra designet: eyebrow + overskrift, Se alle-link
  og produktgrid paa lys flade. Bruges ogsaa som generel produktsektion.
{% endcomment %}

{%- style -%}
  /* 1:1 fra designets BESTSELLERS: paper-2 flade med 1px linje over/under, 64px top/bund, hoved (gap 6) + 30 under, grid gap 20 */
  .nc-best { background: {{ section.settings.bg | default: 'var(--nc-bestsellers-bg)' }}; border-top: 1px solid var(--border-soft); border-bottom: 1px solid var(--border-soft); }
  #shopify-section-{{ section.id }} .nc-best.nc-section { padding: clamp(35px, 6vw, 64px) 0; }
  .nc-best__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 30px; }
  .nc-best__head > div { display: flex; flex-direction: column; gap: 6px; }
  #shopify-section-{{ section.id }} .nc-best__head .nc-eyebrow { margin: 0; line-height: 1.7; letter-spacing: 0.12em; color: var(--sage-600); }
  .nc-best__head h2 { margin: 0; font-size: clamp(20px, 3.1vw, 32px); line-height: 1.7; letter-spacing: normal; color: var(--sage-700); }
  .nc-best__link { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-body); font-size: 14px; font-weight: 600; line-height: normal; color: var(--sage-700); text-decoration: none; }
  .nc-best__link:hover { color: var(--sage-600); }
  #shopify-section-{{ section.id }} .nc-best .nc-grid { gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(47%, 238px), 1fr)); }
{%- endstyle -%}

<section class="nc-best nc-section">
  <div class="nc-container">
    <div class="nc-best__head">
      <div>
        <p class="nc-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.collection != blank -%}
        <a class="nc-best__link" href="{{ section.settings.collection.url }}">{{ section.settings.link_text }} →</a>
      {%- endif -%}
    </div>

    <ul class="nc-grid">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          <li>{% render 'nc-product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li>
            <div class="nc-product-card">
              <div class="nc-product-card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
              <div class="nc-product-card__info"><h3 class="nc-product-card__title">Vælg en kollektion</h3></div>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Produktgrid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Mest elskede" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Kundernes favoritter" },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "limit", "label": "Antal produkter", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "link_text", "label": "Linktekst", "default": "Se alle" },
    { "type": "text", "id": "bg", "label": "Baggrund (CSS-variabel, avanceret)", "info": "Standard: lys grøn flade fra designsystemet." }
  ],
  "presets": [ { "name": "Produktgrid" } ]
}
{% endschema %}
