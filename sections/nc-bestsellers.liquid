{% comment %}
  "Kundernes favoritter" fra designet: eyebrow + overskrift, Se alle-link
  og produktgrid paa lys flade. Bruges ogsaa som generel produktsektion.
{% endcomment %}

{%- style -%}
  .nc-best { background: {{ section.settings.bg | default: 'var(--nc-bestsellers-bg)' }}; }
  .nc-best__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: clamp(22px, 3vw, 34px); }
  .nc-best__head h2 { margin: 0; }
  .nc-best__link { font-size: 14.5px; font-weight: 600; color: var(--ink-900); text-decoration: none; }
  .nc-best__link:hover { color: var(--sage-600); }
{%- endstyle -%}

<section class="nc-best nc-section">
  <div class="nc-container">
    <div class="nc-best__head">
      <div>
        <p class="nc-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.collection != blank -%}
        <a class="nc-best__link" href="{{ section.settings.collection.url }}">{{ section.settings.link_text }} →</a>
      {%- endif -%}
    </div>

    <ul class="nc-grid">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          <li>{% render 'nc-product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li>
            <div class="nc-product-card">
              <div class="nc-product-card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
              <div class="nc-product-card__info"><h3 class="nc-product-card__title">Vælg en kollektion</h3></div>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Produktgrid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Mest elskede" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Kundernes favoritter" },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "limit", "label": "Antal produkter", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "link_text", "label": "Linktekst", "default": "Se alle" },
    { "type": "text", "id": "bg", "label": "Baggrund (CSS-variabel, avanceret)", "info": "Standard: lys grøn flade fra designsystemet." }
  ],
  "presets": [ { "name": "Produktgrid" } ]
}
{% endschema %}
