{% comment %}
  Interaktiv vaelger fra Om CBD-designet. Bruges to steder:
  - "Velegnet til alle hudtyper": lys baggrund, liste til venstre,
    aktivt punkt som sage-pill med pil, kort med billede + hvid tekstboks.
  - "Ingredienser & egenskaber": sage-baggrund, liste til hoejre,
    kort med billede og tekst-overlay.
  Klik paa et punkt viser det tilhoerende kort. Foerste punkt er aktivt.
{% endcomment %}

{%- liquid
  assign tone = section.settings.tone
  assign uid = section.id
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .nc-ttabs { padding: clamp(44px, 6vw, 84px) 0; }
  #shopify-section-{{ section.id }} .nc-ttabs--light { background: var(--paper); }
  #shopify-section-{{ section.id }} .nc-ttabs--sage { background: var(--sage-500); }
  #shopify-section-{{ section.id }} .nc-ttabs__head { text-align: center; max-width: 64ch; margin: 0 auto clamp(26px, 3.6vw, 44px); }
  #shopify-section-{{ section.id }} .nc-ttabs__head h2 { margin: 0 0 10px; font-size: clamp(26px, 3.2vw, 40px); }
  #shopify-section-{{ section.id }} .nc-ttabs__head p { margin: 0; color: var(--ink-700); }
  #shopify-section-{{ section.id }} .nc-ttabs--sage .nc-ttabs__head h2 { color: var(--cloud); }
  #shopify-section-{{ section.id }} .nc-ttabs--sage .nc-ttabs__head p { color: rgba(255, 255, 255, 0.85); }
  #shopify-section-{{ section.id }} .nc-ttabs--sage .nc-ttabs__head .nc-eyebrow { color: rgba(255, 255, 255, 0.75); }

  #shopify-section-{{ section.id }} .nc-ttabs__grid { display: grid; gap: clamp(20px, 3vw, 40px); grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 900px) {
    #shopify-section-{{ section.id }} .nc-ttabs__grid { grid-template-columns: 0.9fr 1.1fr; }
    #shopify-section-{{ section.id }} .nc-ttabs__grid--listright .nc-ttabs__list { order: 2; }
  }

  #shopify-section-{{ section.id }} .nc-ttabs__list { display: flex; flex-direction: column; gap: 6px; margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ section.id }} .nc-ttabs__item { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; padding: 13px 18px; border: 0; border-radius: var(--radius-md); background: transparent; font-family: inherit; font-size: 15.5px; text-align: left; cursor: pointer; color: var(--ink-700); transition: background-color 140ms cubic-bezier(0.4, 0, 0.2, 1), color 140ms cubic-bezier(0.4, 0, 0.2, 1); }
  #shopify-section-{{ section.id }} .nc-ttabs__item svg { flex: none; opacity: 0; transition: opacity 140ms cubic-bezier(0.4, 0, 0.2, 1); }
  #shopify-section-{{ section.id }} .nc-ttabs--light .nc-ttabs__item[aria-selected="true"] { background: var(--sage-500); color: var(--cloud); }
  #shopify-section-{{ section.id }} .nc-ttabs--light .nc-ttabs__item:hover:not([aria-selected="true"]) { background: var(--sage-50); }
  #shopify-section-{{ section.id }} .nc-ttabs--sage .nc-ttabs__item { color: rgba(246, 244, 238, 0.75); }
  #shopify-section-{{ section.id }} .nc-ttabs--sage .nc-ttabs__item[aria-selected="true"] { background: rgba(255, 255, 255, 0.16); color: var(--cloud); }
  #shopify-section-{{ section.id }} .nc-ttabs--sage .nc-ttabs__item:hover:not([aria-selected="true"]) { background: rgba(255, 255, 255, 0.08); }
  #shopify-section-{{ section.id }} .nc-ttabs__item[aria-selected="true"] svg { opacity: 1; }

  #shopify-section-{{ section.id }} .nc-ttabs__panel { display: none; }
  #shopify-section-{{ section.id }} .nc-ttabs__panel.is-active { display: block; }
  #shopify-section-{{ section.id }} .nc-ttabs__card { border-radius: var(--radius-lg); overflow: hidden; background: var(--cloud); box-shadow: var(--shadow-sm); }
  #shopify-section-{{ section.id }} .nc-ttabs__card-media { aspect-ratio: 16 / 10; background: var(--sage-100); }
  #shopify-section-{{ section.id }} .nc-ttabs__card-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .nc-ttabs__card-body { padding: clamp(20px, 2.6vw, 30px); }
  #shopify-section-{{ section.id }} .nc-ttabs__card-body h3 { margin: 0 0 10px; font-size: clamp(20px, 2.2vw, 25px); }
  #shopify-section-{{ section.id }} .nc-ttabs__card-body p { margin: 0; font-size: 15px; line-height: 1.7; color: var(--ink-700); }
  #shopify-section-{{ section.id }} .nc-ttabs__card-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; font-size: 14.5px; font-weight: 600; color: var(--ink-900); text-decoration: none; }
  #shopify-section-{{ section.id }} .nc-ttabs__card-link:hover { color: var(--sage-700); text-decoration: underline; text-underline-offset: 3px; }
{%- endstyle -%}

<div class="nc-ttabs nc-ttabs--{{ tone }}">
  <div class="nc-container">
    <div class="nc-ttabs__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nc-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.sub != blank -%}
        <p>{{ section.settings.sub }}</p>
      {%- endif -%}
    </div>

    <div class="nc-ttabs__grid {% if section.settings.list_side == 'right' %}nc-ttabs__grid--listright{% endif %}" data-nc-ttabs>
      <ul class="nc-ttabs__list" role="tablist">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <button
              class="nc-ttabs__item"
              type="button"
              role="tab"
              id="ttab-{{ uid }}-{{ forloop.index }}"
              aria-controls="tpanel-{{ uid }}-{{ forloop.index }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              data-nc-ttab
            >
              {{ block.settings.title }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
          </li>
        {%- endfor -%}
      </ul>

      <div>
        {%- for block in section.blocks -%}
          <div
            class="nc-ttabs__panel {% if forloop.first %}is-active{% endif %}"
            role="tabpanel"
            id="tpanel-{{ uid }}-{{ forloop.index }}"
            aria-labelledby="ttab-{{ uid }}-{{ forloop.index }}"
            data-nc-tpanel
          >
            <div class="nc-ttabs__card">
              <div class="nc-ttabs__card-media">
                {%- assign card_alt = block.settings.title | escape -%}
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1000 | image_tag: alt: card_alt, loading: 'lazy', sizes: '(min-width: 900px) 620px, 94vw' }}
                {%- elsif block.settings.image_url contains '//' -%}
                  <img src="{{ block.settings.image_url }}" alt="{{ card_alt }}" loading="lazy" width="1000" height="625">
                {%- elsif block.settings.image_url != blank -%}
                  <img src="{{ block.settings.image_url | asset_url }}" alt="{{ card_alt }}" loading="lazy" width="1000" height="625">
                {%- endif -%}
              </div>
              <div class="nc-ttabs__card-body">
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
                {%- if block.settings.link_label != blank and block.settings.link != blank -%}
                  <a class="nc-ttabs__card-link" href="{{ block.settings.link }}">
                    {{ block.settings.link_label }}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    document.querySelectorAll('#shopify-section-{{ section.id }} [data-nc-ttabs]').forEach(function (root) {
      var tabs = root.querySelectorAll('[data-nc-ttab]');
      var panels = root.querySelectorAll('[data-nc-tpanel]');
      tabs.forEach(function (tab, i) {
        tab.addEventListener('click', function () {
          tabs.forEach(function (t) { t.setAttribute('aria-selected', 'false'); });
          panels.forEach(function (p) { p.classList.remove('is-active'); });
          tab.setAttribute('aria-selected', 'true');
          if (panels[i]) panels[i].classList.add('is-active');
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "NC vælger (tabs)",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "tone", "label": "Baggrund", "options": [ { "value": "light", "label": "Lys (papir)" }, { "value": "sage", "label": "Sage (mørk)" } ], "default": "light" },
    { "type": "select", "id": "list_side", "label": "Liste-side", "options": [ { "value": "left", "label": "Venstre" }, { "value": "right", "label": "Højre" } ], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Velegnet til alle hudtyper" },
    { "type": "textarea", "id": "sub", "label": "Undertekst" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Punkt",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Punkt" },
        { "type": "textarea", "id": "text", "label": "Tekst" },
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "text", "id": "image_url", "label": "Billede-URL/asset (fallback)" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Linktekst" }
      ]
    }
  ],
  "presets": [ { "name": "NC vælger (tabs)" } ]
}
{% endschema %}
