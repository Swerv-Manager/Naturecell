{% comment %}
  Interaktiv vaelger fra Om CBD-designet (template.html:2177-2252). Bruges to steder:
  - "Velegnet til alle hudtyper": lys baggrund, liste til venstre,
    aktivt punkt som sage-pill med pil, hvidt kort med billede + tekst.
  - "Ingredienser & egenskaber": sage-baggrund, liste til hoejre,
    gennemsigtigt sage-kort (rgba hvid 6%) med lys tekst.
  Klik paa et punkt viser det tilhoerende kort. Foerste punkt er aktivt.
{% endcomment %}

{%- liquid
  assign tone = section.settings.tone
  assign uid = section.id
-%}

{%- style -%}
  {%- comment -%} Designets sektion: container 1180, padding clamp(46,6vw,84). {%- endcomment -%}
  #shopify-section-{{ section.id }} .nc-ttabs { padding: clamp(46px, 6vw, 84px) 0; }
  #shopify-section-{{ section.id }} .nc-ttabs .nc-container { max-width: 1180px; }
  #shopify-section-{{ section.id }} .nc-ttabs--light { background: var(--paper); }
  #shopify-section-{{ section.id }} .nc-ttabs--sage { background: var(--sage-500); color: var(--paper); }
  {%- comment -%} Designets hoved: centreret, max-width 680, margin-bottom 44, flex-kolonne gap 12;
      eyebrow 12px (linjehoejde normal), h2 clamp(24,3.7vw,38)/1.08, undertekst 16px/1.7 ink-500. {%- endcomment -%}
  #shopify-section-{{ section.id }} .nc-ttabs__head { display: flex; flex-direction: column; gap: 12px; align-items: center; text-align: center; max-width: 680px; margin: 0 auto 44px; }
  #shopify-section-{{ section.id }} .nc-ttabs__head .nc-eyebrow { margin: 0; line-height: var(--leading-relaxed); font-size: 12px; letter-spacing: 0.12em; color: var(--sage-600); }
  #shopify-section-{{ section.id }} .nc-ttabs__head h2 { margin: 0; font-size: clamp(24px, 3.7vw, 38px); line-height: 1.08; letter-spacing: normal; }
  #shopify-section-{{ section.id }} .nc-ttabs__head p { margin: 0; font-size: 16px; line-height: 1.7; color: var(--ink-500); }
  #shopify-section-{{ section.id }} .nc-ttabs--sage .nc-ttabs__head h2 { color: var(--paper); }
  #shopify-section-{{ section.id }} .nc-ttabs--sage .nc-ttabs__head p { color: rgba(246, 244, 238, 0.8); }
  #shopify-section-{{ section.id }} .nc-ttabs--sage .nc-ttabs__head .nc-eyebrow { color: var(--sage-200); }

  {%- comment -%} Designets grid: auto-fit minmax(280,1fr) → to lige kolonner, gap 32, align stretch. {%- endcomment -%}
  #shopify-section-{{ section.id }} .nc-ttabs__grid { display: grid; gap: 32px; grid-template-columns: 1fr; align-items: stretch; }
  @media (min-width: 900px) {
    #shopify-section-{{ section.id }} .nc-ttabs__grid { grid-template-columns: 1fr 1fr; }
    #shopify-section-{{ section.id }} .nc-ttabs__grid--listright .nc-ttabs__list { order: 2; }
  }

  {%- comment -%} Designets liste: kolonne gap 6; punkt = knap i Philosopher 18px, padding 14px 18px, radius-md,
      space-between med 18px pil; lys: ink-700 / aktiv sage-500 + hvid; sage: rgba(246,244,238,.72) / aktiv hvid 16%. {%- endcomment -%}
  #shopify-section-{{ section.id }} .nc-ttabs__list { display: flex; flex-direction: column; gap: 6px; margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ section.id }} .nc-ttabs__item { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; padding: 14px 18px; border: 0; border-radius: var(--radius-md); background: transparent; font-family: var(--font-display); font-weight: 400; font-size: 18px; line-height: normal; text-align: left; cursor: pointer; color: var(--ink-700); transition: background-color 140ms cubic-bezier(0.4, 0, 0.2, 1), color 140ms cubic-bezier(0.4, 0, 0.2, 1); }
  #shopify-section-{{ section.id }} .nc-ttabs__item svg { flex: none; opacity: 0; transition: opacity 140ms cubic-bezier(0.4, 0, 0.2, 1); }
  #shopify-section-{{ section.id }} .nc-ttabs--light .nc-ttabs__item[aria-selected="true"] { background: var(--sage-500); color: #fff; }
  #shopify-section-{{ section.id }} .nc-ttabs--light .nc-ttabs__item:hover:not([aria-selected="true"]) { background: var(--sage-50); }
  #shopify-section-{{ section.id }} .nc-ttabs--sage .nc-ttabs__item { color: rgba(246, 244, 238, 0.72); }
  #shopify-section-{{ section.id }} .nc-ttabs--sage .nc-ttabs__item[aria-selected="true"] { background: rgba(255, 255, 255, 0.16); color: #fff; }
  #shopify-section-{{ section.id }} .nc-ttabs--sage .nc-ttabs__item:hover:not([aria-selected="true"]) { background: rgba(255, 255, 255, 0.08); }
  #shopify-section-{{ section.id }} .nc-ttabs__item[aria-selected="true"] svg { opacity: 1; }

  #shopify-section-{{ section.id }} .nc-ttabs__panel { display: none; height: 100%; }
  #shopify-section-{{ section.id }} .nc-ttabs__panel.is-active { display: block; }
  {%- comment -%} Designets kort: lys = cloud, 1px border-soft, radius-xl, shadow-sm;
      sage = rgba(255,255,255,.06), 1px rgba(246,244,238,.16), radius-xl, ingen skygge. {%- endcomment -%}
  #shopify-section-{{ section.id }} .nc-ttabs__card { display: flex; flex-direction: column; border-radius: var(--radius-xl); overflow: hidden; background: var(--cloud); border: 1px solid var(--border-soft); box-shadow: var(--shadow-sm); }
  #shopify-section-{{ section.id }} .nc-ttabs--sage .nc-ttabs__card { background: rgba(255, 255, 255, 0.06); border-color: rgba(246, 244, 238, 0.16); box-shadow: none; }
  #shopify-section-{{ section.id }} .nc-ttabs__card-media { position: relative; aspect-ratio: 16 / 10; background: var(--sage-50); overflow: hidden; }
  #shopify-section-{{ section.id }} .nc-ttabs--sage .nc-ttabs__card-media { background: rgba(255, 255, 255, 0.06); }
  #shopify-section-{{ section.id }} .nc-ttabs__card-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  {%- comment -%} Designets korttekst: padding 26px 30px 30px, kolonne gap 10; h3 24px/1.15; p 15.5px/1.75; link 14.5px/600 sage-700, gap 7, margin-top 4. {%- endcomment -%}
  #shopify-section-{{ section.id }} .nc-ttabs__card-body { padding: 26px 30px 30px; display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  #shopify-section-{{ section.id }} .nc-ttabs__card-body h3 { margin: 0; font-size: 24px; line-height: 1.15; letter-spacing: normal; color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-ttabs__card-body p { margin: 0; font-size: 15.5px; line-height: 1.75; color: var(--ink-700); }
  #shopify-section-{{ section.id }} .nc-ttabs--sage .nc-ttabs__card-body h3 { color: var(--paper); }
  #shopify-section-{{ section.id }} .nc-ttabs--sage .nc-ttabs__card-body p { color: rgba(246, 244, 238, 0.85); }
  #shopify-section-{{ section.id }} .nc-ttabs__card-link { display: inline-flex; align-items: center; gap: 7px; margin-top: 4px; font-family: var(--font-body); font-size: 14.5px; font-weight: 600; line-height: normal; color: var(--sage-700); text-decoration: none; }
  #shopify-section-{{ section.id }} .nc-ttabs__card-link:hover { text-decoration: underline; text-underline-offset: 3px; }
{%- endstyle -%}

<div class="nc-ttabs nc-ttabs--{{ tone }}">
  <div class="nc-container">
    <div class="nc-ttabs__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nc-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.sub != blank -%}
        <p>{{ section.settings.sub }}</p>
      {%- endif -%}
    </div>

    <div class="nc-ttabs__grid {% if section.settings.list_side == 'right' %}nc-ttabs__grid--listright{% endif %}" data-nc-ttabs>
      <ul class="nc-ttabs__list" role="tablist">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <button
              class="nc-ttabs__item"
              type="button"
              role="tab"
              id="ttab-{{ uid }}-{{ forloop.index }}"
              aria-controls="tpanel-{{ uid }}-{{ forloop.index }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              data-nc-ttab
            >
              {{ block.settings.title }}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
            </button>
          </li>
        {%- endfor -%}
      </ul>

      <div>
        {%- for block in section.blocks -%}
          <div
            class="nc-ttabs__panel {% if forloop.first %}is-active{% endif %}"
            role="tabpanel"
            id="tpanel-{{ uid }}-{{ forloop.index }}"
            aria-labelledby="ttab-{{ uid }}-{{ forloop.index }}"
            data-nc-tpanel
          >
            <div class="nc-ttabs__card">
              <div class="nc-ttabs__card-media">
                {%- assign card_alt = block.settings.title | escape -%}
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1000 | image_tag: alt: card_alt, loading: 'lazy', sizes: '(min-width: 900px) 560px, 94vw' }}
                {%- elsif block.settings.image_url contains '//' -%}
                  <img src="{{ block.settings.image_url }}" alt="{{ card_alt }}" loading="lazy" width="1000" height="625">
                {%- elsif block.settings.image_url != blank -%}
                  <img src="{{ block.settings.image_url | asset_url }}" alt="{{ card_alt }}" loading="lazy" width="1000" height="625">
                {%- endif -%}
              </div>
              <div class="nc-ttabs__card-body">
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
                {%- if block.settings.link_label != blank and block.settings.link != blank -%}
                  <a class="nc-ttabs__card-link" href="{{ block.settings.link }}">
                    {{ block.settings.link_label }}
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    document.querySelectorAll('#shopify-section-{{ section.id }} [data-nc-ttabs]').forEach(function (root) {
      var tabs = root.querySelectorAll('[data-nc-ttab]');
      var panels = root.querySelectorAll('[data-nc-tpanel]');
      tabs.forEach(function (tab, i) {
        tab.addEventListener('click', function () {
          tabs.forEach(function (t) { t.setAttribute('aria-selected', 'false'); });
          panels.forEach(function (p) { p.classList.remove('is-active'); });
          tab.setAttribute('aria-selected', 'true');
          if (panels[i]) panels[i].classList.add('is-active');
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "NC vælger (tabs)",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "tone", "label": "Baggrund", "options": [ { "value": "light", "label": "Lys (papir)" }, { "value": "sage", "label": "Sage (mørk)" } ], "default": "light" },
    { "type": "select", "id": "list_side", "label": "Liste-side", "options": [ { "value": "left", "label": "Venstre" }, { "value": "right", "label": "Højre" } ], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Velegnet til alle hudtyper" },
    { "type": "textarea", "id": "sub", "label": "Undertekst" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Punkt",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Punkt" },
        { "type": "textarea", "id": "text", "label": "Tekst" },
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "text", "id": "image_url", "label": "Billede-URL/asset (fallback)" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Linktekst" }
      ]
    }
  ],
  "presets": [ { "name": "NC vælger (tabs)" } ]
}
{% endschema %}
