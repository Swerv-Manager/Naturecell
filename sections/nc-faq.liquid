{% comment %}
  FAQ-accordion fra designet. Bruges paa produktsider, kollektioner og
  FAQ-siden. Grupper laves med overskrift-blokke. Kompakt tilstand
  (kollektionssider): lille venstrestillet overskrift + 2-kolonne grid,
  alle lukkede, plus valgfri "Populaere soegninger"-chips og disclaimer.
{% endcomment %}

{%- style -%}
  .nc-faqsec__wrap { max-width: 780px; margin: 0 auto; }
  .nc-faqsec__group { margin: 26px 0 10px; }
  /* Spoergsmaalstekst i dyb salvie som i godkendt design */
  .nc-faqsec .nc-acc__head { color: var(--sage-700); }
  .nc-faqsec--compact .nc-faqsec__wrap { max-width: none; margin: 0; }
  /* Strammere sektionsrytme paa kollektionssider (fra godkendt design) */
  .nc-faqsec--compact.nc-section { padding-top: clamp(10px, 1.2vw, 16px); padding-bottom: 4px; }
  .nc-faqsec--compact .nc-section-head { max-width: none; text-align: left; }
  .nc-faqsec--compact .nc-section-head h2 { font-size: 18px; font-weight: var(--weight-heading, 700); color: var(--sage-700); }
  .nc-faqsec--compact .nc-acc { border-top: 0; }
  .nc-faqsec--compact .nc-acc__head { padding-block: 12px; }
  @media (min-width: 860px) {
    .nc-faqsec--compact .nc-acc { display: grid; grid-template-columns: 1fr 1fr; column-gap: clamp(36px, 5vw, 72px); align-items: start; }
  }
  /* PDP-variant (valgfri): Philosopher-spoergsmaal som i godkendt PDP-design */
  .nc-faqsec--display.nc-section { padding-top: clamp(38px, 5vw, 64px); padding-bottom: clamp(48px, 6vw, 80px); }
  .nc-faqsec--display .nc-faqsec__wrap { max-width: 712px; }
  /* Designets h2 arver body-linjehoejden (1.7) og head'et har ingen ekstra margin */
  .nc-faqsec--display .nc-section-head { margin-bottom: 0 !important; }
  .nc-faqsec--display .nc-section-head h2 { margin-bottom: 24px; font-size: clamp(19px, 2.9vw, 30px); font-weight: 400; line-height: var(--leading-relaxed); letter-spacing: normal; color: var(--sage-700); }
  {%- if request.page_type == 'product' -%}
  /* PDP: designets FAQ slutter med 80px foer footeren; footerens egen margin-top leverer dem */
  .nc-faqsec--display.nc-section { padding-bottom: 0; }
  {%- endif -%}
  .nc-faqsec--display .nc-acc__head { font-family: var(--font-display); font-weight: 400; font-size: 18px; line-height: 22px; color: var(--sage-700); }
  .nc-faqsec--display .nc-acc__body p:last-child { margin-bottom: 0; }
  .nc-faqsec--display .nc-acc__head svg { color: var(--ink-400); }
  .nc-faqsec--display .nc-acc__body { padding: 0 2px 20px; font-size: 15px; line-height: 1.7; color: var(--ink-700); }
  .nc-faqsec__links-block { margin-top: clamp(30px, 4vw, 48px); }
  .nc-faqsec__links-label { margin-bottom: 12px; }
  .nc-faqsec__links { display: flex; flex-wrap: wrap; gap: 8px; }
  .nc-faqsec__disclaimer { max-width: 46rem; margin: clamp(22px, 3vw, 32px) 0 0; font-size: 12.5px; line-height: 1.7; color: var(--ink-500); }
  /* FAQ-siden: designets aabne liste (template.html:2313-2327), alle svar synlige, ingen accordion.
     Designet: kolonne 820px inkl. 24px sidepadding = 772px indhold. */
  /* Designets 80px bund-padding leveres af footerens margin-top (var(--section-y)); egen bund-padding = 0,
     ellers stakkes de to og giver 160px foer footeren. */
  .nc-faqsec--list.nc-section { padding-top: clamp(14px, 5vw, 24px); padding-bottom: 0; }
  .nc-faqsec--list .nc-faqsec__wrap { max-width: 772px; }
  .nc-faqsec--list .nc-faqsec__grp { margin-bottom: 44px; }
  .nc-faqsec--list .nc-faqsec__grp h2 { margin: 0 0 6px; font-family: var(--font-display); font-weight: 400; font-size: 24px; line-height: var(--leading-relaxed); letter-spacing: normal; color: var(--sage-700); }
  .nc-faqsec--list .nc-faqsec__qa { border-top: 1px solid var(--border-soft); padding: 22px 2px; display: flex; flex-direction: column; gap: 8px; }
  .nc-faqsec--list .nc-faqsec__qa h3 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 20px; line-height: 1.25; letter-spacing: normal; color: var(--sage-700); }
  .nc-faqsec--list .nc-faqsec__qa p { margin: 0; font-size: 15.5px; line-height: 1.7; color: var(--ink-700); }
  .nc-faqsec--list .nc-faqsec__note { border-top: 1px solid var(--border-soft); padding-top: 28px; margin-top: 8px; text-align: center; }
  .nc-faqsec--list .nc-faqsec__note p { margin: 0; font-size: 15px; color: var(--ink-500); }
{%- endstyle -%}

<section class="nc-section nc-faqsec {% if section.settings.compact %}nc-faqsec--compact{% endif %} {% if section.settings.display_style %}nc-faqsec--display{% endif %} {% if section.settings.list_style %}nc-faqsec--list{% endif %}" id="faq">
  <div class="nc-container">
    <div class="nc-faqsec__wrap">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.subtext != blank -%}
      <div class="nc-section-head {% unless section.settings.compact %}nc-section-head--center{% endunless %}" style="margin-bottom: 8px;">
        {%- if section.settings.eyebrow != blank -%}
          <p class="nc-eyebrow">{% render 'nc-cbd', text: section.settings.eyebrow %}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{% render 'nc-cbd', text: section.settings.heading %}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p>{% render 'nc-cbd', text: section.settings.subtext %}</p>
        {%- endif -%}
      </div>
      {%- endif -%}

      {%- if section.settings.list_style -%}
      {%- comment -%} Aaben liste: gruppeoverskrift + alle spoergsmaal/svar synlige, som paa designets FAQ-side. {%- endcomment -%}
      {%- assign grp_open = false -%}
      {%- assign list_ld = '' -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'group' -%}
          {%- if grp_open -%}</div>{%- endif -%}
          <div class="nc-faqsec__grp" {{ block.shopify_attributes }}>
            <h2>{% render 'nc-cbd', text: block.settings.heading %}</h2>
          {%- assign grp_open = true -%}
        {%- else -%}
          {%- capture list_q %}{% render 'nc-faq-qa', block: block, product: product, part: 'q' %}{% endcapture -%}
          {%- capture list_a %}{% render 'nc-faq-qa', block: block, product: product, part: 'a' %}{% endcapture -%}
          <div class="nc-faqsec__qa" {{ block.shopify_attributes }}>
            {%- assign list_q_s = list_q | strip -%}<h3>{% render 'nc-cbd', text: list_q_s %}</h3>
            {{ list_a }}
          </div>
          {%- capture list_one -%}{"@type":"Question","name":{{ list_q | strip | json }},"acceptedAnswer":{"@type":"Answer","text":{{ list_a | strip_html | strip | json }}}}{%- endcapture -%}
          {%- assign list_ld = list_ld | append: list_one | append: ',' -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if grp_open -%}</div>{%- endif -%}
      {%- assign list_ld = list_ld | remove_last: ',' -%}
      {%- if list_ld != blank and section.settings.schema -%}
        <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ list_ld }}]}</script>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <div class="nc-faqsec__note"><p>{% render 'nc-cbd', text: section.settings.note %}</p></div>
      {%- endif -%}
      {%- else -%}
      {%- comment -%}
        Kollektionssider: unik FAQ fra kollektionens metafelt ncell.faq (liste af metaobjektet faq_item).
        Produktsider: produktets ncell.faq, ellers FAQ'en fra produktets primaere kollektion, efterfulgt af
        sektionens generelle blokke (en blok skjules, hvis dens "dubletord" allerede staar i et spoergsmaal).
        Ellers: sektionens blokke.
      {%- endcomment -%}
      {%- assign mf_faq = collection.metafields.ncell.faq.value -%}
      {%- assign is_pdp = false -%}
      {%- if request.page_type == 'product' -%}
        {%- assign is_pdp = true -%}
        {%- capture faq_handle %}{% render 'nc-primary-collection', product: product %}{% endcapture -%}
        {%- assign faq_handle = faq_handle | strip -%}
        {%- assign mf_faq = product.metafields.ncell.faq.value | default: collections[faq_handle].metafields.ncell.faq.value -%}
      {%- endif -%}
      {%- assign faq_qs = '' -%}
      {%- assign faq_ld = '' -%}
      <div class="nc-acc">
        {%- assign use_mf = false -%}
        {%- if mf_faq != blank -%}
          {%- if request.page_type == 'collection' or is_pdp -%}{%- assign use_mf = true -%}{%- endif -%}
        {%- endif -%}
        {%- comment -%}
          Metaobjekt-spoergsmaal med et ord fra "Erstat spoergsmaal med" (fx fragt) springes over; temaets
          eget leveringssvar (blokken "Fast spoergsmaal") tager over, saa beloebet passer til kundens valuta.
        {%- endcomment -%}
        {%- assign mf_skip = section.settings.mf_skip | downcase | split: ',' -%}
        {%- assign mf_shown = 0 -%}
        {%- if use_mf -%}
          {%- for item in mf_faq -%}
            {%- assign mf_q = item.question.value | downcase -%}
            {%- assign mf_skipped = false -%}
            {%- for w in mf_skip -%}
              {%- assign w = w | strip -%}
              {%- if w != blank and mf_q contains w -%}{%- assign mf_skipped = true -%}{%- endif -%}
            {%- endfor -%}
            {%- if mf_skipped -%}{%- continue -%}{%- endif -%}
            {%- assign mf_shown = mf_shown | plus: 1 -%}
            <details class="nc-acc__item" {% if mf_shown == 1 and section.settings.open_first %}open{% endif %}>
              <summary class="nc-acc__head">
                <span>{% render 'nc-cbd', text: item.question.value %}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              {%- capture mf_answer %}{{ item.answer | metafield_tag }}{% endcapture -%}
              <div class="nc-acc__body">{% render 'nc-cbd', text: mf_answer %}</div>
            </details>
            {%- assign faq_qs = faq_qs | append: item.question.value | downcase | append: ' ¶ ' -%}
            {%- capture faq_one -%}{"@type":"Question","name":{{ item.question.value | json }},"acceptedAnswer":{"@type":"Answer","text":{{ item.answer | metafield_text | json }}}}{%- endcapture -%}
            {%- assign faq_ld = faq_ld | append: faq_one | append: ',' -%}
          {%- endfor -%}
        {%- endif -%}
        {%- comment -%}
          Kollektioner med egen FAQ viser kun de faste, oversatte blokke (locale_qa) efter metaobjekterne.
          Produktsider viser alle blokke efter metaobjekterne. Uden metaobjekter: alle blokke.
        {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if use_mf and is_pdp == false and block.type != 'locale_qa' -%}{%- continue -%}{%- endif -%}
          {%- if product.gift_card? and block.type == 'locale_qa' -%}
            {%- comment -%} Gavekort sendes pr. e-mail og skal ikke opbevares: ingen levering- og opbevaringssvar. {%- endcomment -%}
            {%- if block.settings.key == 'ship' or block.settings.key == 'storage' -%}{%- continue -%}{%- endif -%}
          {%- endif -%}
          {%- if block.type == 'group' -%}
            <h3 class="nc-eyebrow nc-faqsec__group" {{ block.shopify_attributes }}>{% render 'nc-cbd', text: block.settings.heading %}</h3>
          {%- else -%}
            {%- assign is_dupe = false -%}
            {%- assign dupe_words = block.settings.dedupe | downcase | split: ',' -%}
            {%- for dw in dupe_words -%}
              {%- assign dw = dw | strip -%}
              {%- if dw != blank and faq_qs contains dw -%}{%- assign is_dupe = true -%}{%- endif -%}
            {%- endfor -%}
            {%- unless is_dupe -%}
            {%- capture block_q %}{% render 'nc-faq-qa', block: block, product: product, part: 'q' %}{% endcapture -%}
            {%- capture block_a %}{% render 'nc-faq-qa', block: block, product: product, part: 'a' %}{% endcapture -%}
            {%- assign block_q = block_q | strip -%}
            {%- if block_q != blank -%}
            <details class="nc-acc__item" {% if forloop.first and section.settings.open_first and mf_shown == 0 %}open{% endif %} {{ block.shopify_attributes }}>
              <summary class="nc-acc__head">
                <span>{% render 'nc-cbd', text: block_q %}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="nc-acc__body">{% render 'nc-cbd', text: block_a %}</div>
            </details>
            {%- capture faq_one -%}{"@type":"Question","name":{{ block_q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block_a | strip_html | strip | json }}}}{%- endcapture -%}
            {%- assign faq_ld = faq_ld | append: faq_one | append: ',' -%}
            {%- endif -%}
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- assign faq_ld = faq_ld | remove_last: ',' -%}
      {%- if faq_ld != blank and section.settings.schema -%}
        <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_ld }}]}</script>
      {%- endif -%}
      {%- endif -%}

      {%- if section.settings.links != blank -%}
        <div class="nc-faqsec__links-block">
          {%- if section.settings.links_label != blank -%}
            <p class="nc-eyebrow nc-faqsec__links-label">{% render 'nc-cbd', text: section.settings.links_label %}</p>
          {%- endif -%}
          <div class="nc-faqsec__links">
            {%- assign rows = section.settings.links | newline_to_br | split: '<br />' -%}
            {%- for row in rows -%}
              {%- assign parts = row | strip | split: '|' -%}
              {%- if parts[0] != blank and parts[1] != blank -%}
                {%- assign link_text = parts[0] | strip -%}<a class="nc-chip" href="{% render 'nc-url', url: parts[1] %}">{% render 'nc-cbd', text: link_text %}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.disclaimer != blank -%}
        <p class="nc-faqsec__disclaimer">{% render 'nc-cbd', text: section.settings.disclaimer %}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "schema", "label": "Tilføj FAQPage-markup (strukturerede data)", "default": true },
    { "type": "text", "id": "mf_skip", "label": "Erstat spørgsmål med", "default": "fragt, versand, shipping", "info": "Spørgsmål fra metaobjekterne (kollektionens eller produktets FAQ), der indeholder et af ordene, springes over. Tilføj blokken \"Fast spørgsmål: Levering og fri fragt\", så temaets valuta-korrekte svar vises i stedet." },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Spørgsmål & svar" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Ofte stillede spørgsmål" },
    { "type": "textarea", "id": "subtext", "label": "Undertekst" },
    { "type": "checkbox", "id": "open_first", "label": "Åbn første spørgsmål", "default": true },
    { "type": "checkbox", "id": "compact", "label": "Kompakt (lille overskrift, 2 kolonner)", "default": false },
    { "type": "checkbox", "id": "display_style", "label": "PDP-stil (Philosopher-spørgsmål, smal)", "default": false },
    { "type": "checkbox", "id": "list_style", "label": "Åben liste (FAQ-siden: alle svar synlige, ingen accordion)", "default": false },
    { "type": "text", "id": "note", "label": "Afsluttende note under listen (kun åben liste)" },
    { "type": "text", "id": "links_label", "label": "Label over chips", "default": "Populære søgninger" },
    { "type": "textarea", "id": "links", "label": "Chips (én pr. linje: Tekst | /url)" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer-tekst" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Spørgsmål",
      "settings": [
        { "type": "text", "id": "q", "label": "Spørgsmål", "default": "Hvad er CBD-hudpleje?" },
        { "type": "richtext", "id": "a", "label": "Svar", "default": "<p>Hudpleje, hvor CBD (cannabidiol) indgår sammen med planteolier, antioxidanter og fugtgivende ingredienser. Produkterne er kosmetiske.</p>" },
        { "type": "text", "id": "dedupe", "label": "Dubletord", "info": "Blokken skjules, hvis FAQ'en fra metaobjekterne allerede har et spørgsmål med et af ordene (komma mellem, gerne på alle sprog), fx opbevar, aufbewahr." }
      ]
    },
    {
      "type": "locale_qa",
      "name": "Fast spørgsmål (oversat)",
      "settings": [
        {
          "type": "select",
          "id": "key",
          "label": "Spørgsmål",
          "options": [
            { "value": "ship", "label": "Levering og fri fragt" },
            { "value": "return", "label": "Fortrydelsesret" },
            { "value": "storage", "label": "Opbevaring" },
            { "value": "advice", "label": "Personlig rådgivning" }
          ],
          "default": "ship"
        },
        { "type": "paragraph", "content": "Teksten ligger i temaets sprogfiler og er oversat til tysk og engelsk. Levering følger leveringspolitikken; fri fragt nævnes kun i valutaer med en grænse." },
        { "type": "text", "id": "dedupe", "label": "Dubletord", "info": "Blokken skjules, hvis FAQ'en fra metaobjekterne allerede har et spørgsmål med et af ordene (komma mellem, gerne på alle sprog), fx opbevar, aufbewahr." }
      ]
    },
    {
      "type": "group",
      "name": "Gruppeoverskrift",
      "settings": [
        { "type": "text", "id": "heading", "label": "Overskrift", "default": "CBD & lovgivning" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa", "settings": { "q": "Hvad er CBD-hudpleje?", "a": "<p>Hudpleje, hvor CBD (cannabidiol) indgår sammen med planteolier, antioxidanter og fugtgivende ingredienser. Produkterne er kosmetiske.</p>" } },
        { "type": "qa", "settings": { "q": "Er NatureCell godkendt i Danmark?", "a": "<p>Ja. NatureCell blev i 2019 den første CBD-hudplejeserie godkendt til salg i Danmark, og alle produkter er sikkerhedsvurderet efter EU's kosmetikregler.</p>" } },
        { "type": "qa", "settings": { "q": "Er produkterne veganske?", "a": "<p>Ja. Veganske, uden syntetisk parfume og udviklet i Danmark.</p>" } },
        { "type": "locale_qa", "settings": { "key": "ship" } },
        { "type": "locale_qa", "settings": { "key": "return" } }
      ]
    }
  ]
}
{% endschema %}
