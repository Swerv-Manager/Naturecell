{% comment %}
  Kollektionsside fra NatureCell.dc.html: brødkrumme, titel + beskrivelse,
  søgefelt (Shopify-søg), tre labelede filterrækker (OMRÅDE / BEHOV /
  SORTIMENT), grid med sampakker først-sortering via kollektionens egen
  sortering, paginering og SEO-bundtekst med FAQ (egne sektioner nedenfor).
{% endcomment %}

{%- style -%}
  {%- comment -%}
    Alle maal er spejlet 1:1 fra designets inline-styles (template.html 1540-1588):
    section padding clamp(20px,5vw,34px) top / 0 bottom (SEO-sektionen leverer 72px),
    broedkrumme 13px ink-400 + 18px, titel 40px sage-700, beskrivelse 16px/1.6 ink-500,
    toolbar 18px 0 24px + 28px, soegefelt 43px, chips 13px/600 7px 15px 1.5px border,
    raekke-gap 14px, taelling 13.5px + 16px, grid gap 20px.
  {%- endcomment -%}
  .nc-coll-main.nc-section { padding-top: clamp(20px, 5vw, 34px); padding-bottom: 0; }
  .nc-coll__crumbs { display: flex; align-items: center; gap: 9px; font-size: 13px; line-height: 1.7; color: var(--ink-400); margin: 0 0 18px; }
  .nc-coll__crumbs a { color: var(--ink-400); text-decoration: none; }
  .nc-coll__crumbs a:hover { color: var(--sage-700); }
  .nc-coll__crumbs span:last-child { color: var(--ink-700); }
  .nc-coll__header { max-width: 660px; margin: 0 0 26px; }
  .nc-coll__header h1 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(25px, 3.9vw, 40px); line-height: 1.7; letter-spacing: -0.01em; color: var(--sage-700); text-transform: capitalize; }
  .nc-coll__desc { margin: 10px 0 0; font-size: 16px; line-height: 1.6; color: var(--ink-500); }
  .nc-coll__desc p { margin: 0; font-size: inherit; line-height: inherit; color: inherit; }
  .nc-coll__toolbar { display: flex; flex-direction: column; gap: 14px; border-top: 1px solid var(--border-soft); border-bottom: 1px solid var(--border-soft); padding: 18px 0 24px; margin: 0 0 28px; }
  .nc-coll__search { display: flex; align-items: center; gap: 8px; width: min(440px, 100%); box-sizing: border-box; height: 43px; padding: 0 18px 0 16px; margin: 0; background: var(--cloud); border: 1px solid var(--border-default); border-radius: var(--radius-pill); color: var(--ink-400); }
  .nc-coll__search svg { flex: none; }
  .nc-coll__search input { flex: 1; min-width: 0; height: 17px; border: 0; padding: 0; background: none; font-family: var(--font-body); font-size: 14.5px; line-height: 17px; box-sizing: border-box; color: var(--sage-700); outline: none; }
  .nc-coll__search input::placeholder { color: var(--ink-400); }
  .nc-coll__filter-row { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin: 0; }
  .nc-coll__filter-row--sort { border-top: 1px dashed var(--border-default); padding-top: 14px; margin-top: 4px; }
  .nc-coll__filter-label { flex: none; min-width: 64px; font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-400); }
  .nc-coll__row-chips { display: contents; }
  .nc-coll-main .nc-coll__filter-row .nc-chip { gap: 7px; padding: 7px 15px; border-width: 1.5px; font-size: 13px; font-weight: 600; line-height: 15px; color: var(--ink-700); }
  .nc-coll-main .nc-coll__filter-row .nc-chip.is-active { color: #fff; }
  .nc-coll__count { font-size: 13.5px; line-height: 24px; color: var(--ink-400); text-align: right; margin: 0 0 16px; }
  .nc-chip__mars { flex: none; width: 13px; height: 13px; color: currentColor; opacity: 1; }
  /* Grid og kort som i designet: gap 20px, kvadratisk medie, rating uden
     ekstra top-margin, pris fastgjort til bunden (kroppen = 196px ved
     een titellinje som i det godkendte design) */
  .nc-coll-main .nc-grid { gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(47%, 238px), 1fr)); }
  .nc-coll-main .nc-grid > li { display: flex; }
  .nc-coll-main .nc-grid .nc-product-card { width: 100%; }
  .nc-coll-main .nc-product-card__media { aspect-ratio: 1 / 1; }
  .nc-coll-main .nc-product-card__info { flex: 1 1 auto; padding-bottom: 23px; }
  .nc-coll-main .nc-product-card__rating { margin-top: 0; }
  .nc-coll-main .nc-product-card__price { margin-top: auto; padding-top: 14px; }
  .nc-coll__empty { border: 1px dashed var(--border-default); border-radius: var(--radius-lg); padding: clamp(31px, 6vw, 56px) clamp(16px, 4vw, 24px); text-align: center; display: flex; flex-direction: column; gap: 12px; align-items: center; }
  .nc-coll__empty p { margin: 0; font-size: 15.5px; color: var(--ink-500); }
  .nc-coll__empty a { display: inline-flex; border: 1.5px solid var(--sage-500); color: var(--sage-700); font-weight: 600; font-size: 14px; padding: 11px 22px; border-radius: var(--radius-pill); text-decoration: none; }
  .nc-coll-main .nc-pagination { margin-top: 40px; }
{%- endstyle -%}

<div class="nc-section nc-coll-main">
  <div class="nc-container">
    {%- if section.settings.show_breadcrumb -%}
      <nav class="nc-coll__crumbs" aria-label="Brødkrumme">
        <a href="{{ routes.root_url }}">Forside</a>
        <span aria-hidden="true">/</span>
        <span>{{ collection.title | capitalize }}</span>
      </nav>
    {%- endif -%}

    <header class="nc-coll__header">
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="nc-coll__desc">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- if section.settings.show_search or section.settings.show_chips -%}
      <div class="nc-coll__toolbar">
        {%- if section.settings.show_search -%}
          <form class="nc-coll__search" action="{{ routes.search_url }}" method="get" role="search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="search" name="q" placeholder="{{ section.settings.search_placeholder | escape }}" aria-label="{{ section.settings.search_placeholder | escape }}">
            <input type="hidden" name="type" value="product">
          </form>
        {%- endif -%}

        {%- if section.settings.show_chips -%}
          {%- if section.settings.chips != blank -%}
            <div class="nc-coll__filter-row" aria-label="{{ section.settings.chips_label | escape }}">
              <span class="nc-coll__filter-label">{{ section.settings.chips_label }}</span>
              <div class="nc-coll__row-chips">
                {%- assign chips = section.settings.chips | newline_to_br | split: '<br />' -%}
                {%- for chip in chips -%}
                  {%- assign parts = chip | strip | split: '|' -%}
                  {%- if parts[0] != blank and parts[1] != blank -%}
                    {%- assign chip_url = parts[1] | strip -%}
                    <a class="nc-chip {% if chip_url == collection.url %}is-active{% endif %}" href="{{ chip_url }}">{{ parts[0] | strip }}</a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.need_chips != blank -%}
            <div class="nc-coll__filter-row" aria-label="{{ section.settings.need_label | escape }}">
              <span class="nc-coll__filter-label">{{ section.settings.need_label }}</span>
              <div class="nc-coll__row-chips">
                {%- assign chips = section.settings.need_chips | newline_to_br | split: '<br />' -%}
                {%- for chip in chips -%}
                  {%- assign parts = chip | strip | split: '|' -%}
                  {%- if parts[0] != blank and parts[1] != blank -%}
                    {%- assign chip_url = parts[1] | strip -%}
                    {%- comment -%} Behov-chips er tag-filtre (/collections/<handle>/<tag>): aktiv når tagget er valgt. {%- endcomment -%}
                    {%- assign chip_tag = chip_url | split: '/' | last -%}
                    <a class="nc-chip {% if chip_url == collection.url or current_tags contains chip_tag %}is-active{% endif %}" href="{{ chip_url }}">{{ parts[0] | strip }}</a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.sort_chips != blank -%}
            <div class="nc-coll__filter-row nc-coll__filter-row--sort" aria-label="{{ section.settings.sort_label | escape }}">
              <span class="nc-coll__filter-label">{{ section.settings.sort_label }}</span>
              <div class="nc-coll__row-chips">
                {%- assign chips = section.settings.sort_chips | newline_to_br | split: '<br />' -%}
                {%- for chip in chips -%}
                  {%- assign parts = chip | strip | split: '|' -%}
                  {%- if parts[0] != blank and parts[1] != blank -%}
                    {%- assign chip_url = parts[1] | strip -%}
                    {%- assign chip_label = parts[0] | strip -%}
                    <a class="nc-chip {% if chip_url == collection.url %}is-active{% endif %}" href="{{ chip_url }}">
                      {%- if chip_label contains '♂' -%}
                        <svg class="nc-chip__mars" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="14" r="6"/><path d="m14.5 9.5 6-6"/><path d="M15 3h6v6"/></svg>
                        {{- chip_label | remove: '♂' | strip -}}
                      {%- else -%}
                        {{- chip_label -}}
                      {%- endif -%}
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if current_tags -%}
      <p class="nc-coll__count" style="text-align: left;">
        Filtreret: {{ current_tags | join: ', ' }} · <a href="{{ collection.url }}">Nulstil</a>
      </p>
    {%- endif -%}

    {%- paginate collection.products by 28 -%}
      <p class="nc-coll__count">{{ collection.products_count }} produkter</p>

      {%- if collection.products.size > 0 -%}
        <ul class="nc-grid">
          {%- for product in collection.products -%}
            <li>{% render 'nc-product-card', product: product %}</li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="nc-coll__empty">
          <span style="color: var(--sage-400);"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg></span>
          <p>Ingen produkter matcher. Prøv en anden søgning eller nulstil filtrene.</p>
          <a href="{{ collection.url }}">Nulstil filtre</a>
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="nc-pagination" aria-label="Sider">
          {{ paginate | default_pagination }}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Kollektion",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Vis brødkrumme", "default": true },
    { "type": "checkbox", "id": "show_search", "label": "Vis søgefelt", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Placeholder i søgefeltet", "default": "Søg på produkt, ingrediens, behov …" },
    { "type": "checkbox", "id": "show_chips", "label": "Vis filterrækker", "default": true },
    { "type": "text", "id": "chips_label", "label": "Label for 1. række", "default": "Område" },
    {
      "type": "textarea",
      "id": "chips",
      "label": "Chips, 1. række (én pr. linje: Tekst | /url)",
      "default": "Alle | /collections/cbd-hudpleje\nAnsigt | /collections/cbd-ansigtspleje\nHænder | /collections/cbd-handpleje\nKrop | /collections/cbd-kropspleje\nFødder | /collections/cbd-fodpleje\nHår | /collections/cbd-haarpleje\nIntim | /collections/cbd-hudpleje/intim"
    },
    { "type": "text", "id": "need_label", "label": "Label for 2. række", "default": "Behov" },
    {
      "type": "textarea",
      "id": "need_chips",
      "label": "Chips, 2. række (én pr. linje: Tekst | /url)",
      "default": "Tør hud | /collections/cbd-hudpleje/tor-hud\nFugt | /collections/cbd-hudpleje/fugt\nModen hud | /collections/cbd-hudpleje/moden-hud\nSensitiv hud | /collections/cbd-hudpleje/sensitiv-hud\nUren hud | /collections/cbd-hudpleje/uren-hud\nGenopbygning | /collections/cbd-hudpleje/genopbygning"
    },
    { "type": "text", "id": "sort_label", "label": "Label for 3. række", "default": "Sortiment" },
    {
      "type": "textarea",
      "id": "sort_chips",
      "label": "Chips, 3. række (én pr. linje: Tekst | /url)",
      "default": "Hele sortimentet | /collections/cbd-hudpleje\n♂ Herre hudpleje | /collections/herre-hudpleje\nTilbud | /collections/nedsatte-varer"
    }
  ]
}
{% endschema %}
