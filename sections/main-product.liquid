{% comment %}
  Produktside fra NatureCell.dc.html: galleri med thumbnails, eyebrow,
  titel, rating, USP-badges, maengdevalg (1/2/3 med maengderabat-tekst),
  laeg-i-kurv, accordion og sticky koebsbar paa mobil.

  Maengderabatten SKAL vaere sat op som Shopify-rabat, foer fanen
  aktiveres i indstillingerne; temaet regner aldrig selv rabatter.
{% endcomment %}

{%- liquid
  assign v = product.selected_or_first_available_variant
  assign is_bundle = false
  if product.tags contains 'pakker' or product.tags contains 'Pakker' or product.tags contains 'bundle'
    assign is_bundle = true
  endif
  assign eyebrow = 'NatureCell'
  if product.title contains 'ALFALAB'
    assign eyebrow = 'ALFALAB'
  endif
  if is_bundle
    assign eyebrow = eyebrow | append: ' Sampakke'
  endif
  assign title_parts = product.title | split: ' | '
  assign main_title = title_parts[0]
  assign sub_title = title_parts[1]
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign on_sale = false
  if v.compare_at_price > v.price
    assign on_sale = true
    assign save_pct = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round
  endif
-%}

{%- style -%}
  .nc-pdp { display: grid; gap: clamp(28px, 4vw, 64px); grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 900px) {
    .nc-pdp { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); }
  }

  .nc-pdp__gallery { position: sticky; top: 20px; display: flex; flex-direction: column; gap: 12px; }
  .nc-pdp__main { position: relative; aspect-ratio: 1 / 1; border-radius: var(--radius-lg); overflow: hidden; background: var(--nc-product-tint); display: flex; align-items: center; justify-content: center; }
  .nc-pdp__main img { max-width: 88%; max-height: 88%; object-fit: contain; }
  .nc-pdp__badges { position: absolute; top: 14px; left: 14px; display: flex; flex-direction: column; gap: 6px; align-items: flex-start; z-index: 2; }
  .nc-pdp__thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(68px, 1fr)); gap: 10px; }
  .nc-pdp__thumbs button { padding: 0; border: 1.5px solid var(--border-soft); border-radius: var(--radius-md); background: var(--nc-product-tint); cursor: pointer; aspect-ratio: 1 / 1; overflow: hidden; }
  .nc-pdp__thumbs button.is-active { border-color: var(--sage-500); }
  .nc-pdp__thumbs img { width: 100%; height: 100%; object-fit: contain; padding: 6px; }

  .nc-pdp__info { display: flex; flex-direction: column; gap: 16px; }
  .nc-pdp__title { margin: 0; font-size: clamp(30px, 3.4vw, 42px); }
  .nc-pdp__sub { color: var(--ink-500); font-size: 15px; margin: -8px 0 0; }
  .nc-pdp__rating { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; color: var(--ink-700); }

  .nc-pdp__usps { display: flex; gap: 14px; flex-wrap: wrap; }
  .nc-pdp__usp { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink-700); }
  .nc-pdp__usp img { width: 34px; height: 34px; }

  .nc-pdp__price { font-size: clamp(22px, 2.4vw, 28px); font-weight: 700; color: var(--ink-900); }
  .nc-pdp__price.is-sale { color: var(--sale); }
  .nc-pdp__price s { margin-left: 10px; font-size: 0.7em; font-weight: 400; color: var(--ink-400); }

  .nc-pdp__tiers { display: grid; gap: 10px; }
  .nc-pdp__tier { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; border: 1.5px solid var(--border-default); border-radius: var(--radius-md); background: var(--cloud); cursor: pointer; text-align: left; font-family: inherit; }
  .nc-pdp__tier.is-active { border-color: var(--sage-500); background: var(--sage-50); }
  .nc-pdp__tier strong { display: block; font-size: 15px; color: var(--ink-900); }
  .nc-pdp__tier small { font-size: 12.5px; color: var(--ink-500); }
  .nc-pdp__tier-pop { position: absolute; top: -9px; right: 12px; }

  .nc-pdp__form { display: flex; flex-direction: column; gap: 14px; }
  .nc-pdp__addrow { display: flex; gap: 10px; }
  .nc-pdp__addrow .nc-btn { flex: 1; }
  .nc-qty { display: inline-flex; align-items: center; border: 1px solid var(--border-default); border-radius: var(--radius-pill); background: var(--cloud); }
  .nc-qty button { width: 42px; height: 44px; border: 0; background: none; font-size: 18px; color: var(--ink-700); cursor: pointer; }
  .nc-qty input { width: 40px; border: 0; background: none; text-align: center; font-size: 15px; font-weight: 600; color: var(--ink-900); -moz-appearance: textfield; }
  .nc-qty input::-webkit-outer-spin-button, .nc-qty input::-webkit-inner-spin-button { -webkit-appearance: none; }

  .nc-pdp__meta { font-size: 13px; color: var(--ink-500); display: flex; gap: 16px; flex-wrap: wrap; }

  .nc-buybar { position: fixed; left: 0; right: 0; bottom: 0; z-index: var(--z-sticky); background: var(--cloud); border-top: 1px solid var(--border-default); padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom)); display: none; align-items: center; gap: 12px; transform: translateY(110%); transition: transform var(--dur-base) var(--ease-soft); }
  .nc-buybar.is-visible { transform: translateY(0); }
  .nc-buybar__title { flex: 1; min-width: 0; font-family: var(--font-display); font-size: 15px; color: var(--sage-700); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (max-width: 899px) {
    .nc-buybar { display: flex; }
    .nc-pdp__gallery { position: static; }
  }
{%- endstyle -%}

<div class="nc-section" data-nc-buybar-anchor>
  <div class="nc-container">
    <div class="nc-pdp">
      <div class="nc-pdp__gallery" data-nc-gallery>
        <div class="nc-pdp__main" data-nc-gallery-main>
          <div class="nc-pdp__badges">
            {%- if on_sale and settings.show_save_badge -%}
              <span class="nc-tag nc-tag--sale">Spar {{ save_pct }}%</span>
            {%- endif -%}
            {%- if is_bundle -%}
              <span class="nc-tag nc-tag--sage">Sampakke</span>
            {%- endif -%}
          </div>
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 1200 | image_tag: alt: product.featured_image.alt | default: main_title, widths: '480, 720, 960, 1200', sizes: '(min-width: 900px) 600px, 94vw' }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="nc-pdp__thumbs">
            {%- for image in product.images limit: 8 -%}
              <button
                type="button"
                data-nc-thumb="{{ image | image_url: width: 1200 }}"
                {% if forloop.first %}class="is-active"{% endif %}
                aria-label="Vis billede {{ forloop.index }}"
              >
                {{ image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="nc-pdp__info">
        <p class="nc-eyebrow" style="margin: 0;">{{ eyebrow }}</p>
        <h1 class="nc-pdp__title">{{ main_title }}</h1>
        {%- if sub_title != blank -%}
          <p class="nc-pdp__sub">{{ sub_title }}</p>
        {%- endif -%}

        {%- if rating != blank and rating_count != blank -%}
          <span class="nc-pdp__rating">
            <span class="nc-stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 24 24"><path d="m12 2 3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.4 21.7l1.8-7.3L1.5 9.5 9 8.9Z"/></svg>
              {%- endfor -%}
            </span>
            {{ rating.rating | default: rating }}/5 · {{ rating_count }} anmeldelser
          </span>
        {%- endif -%}

        {%- assign badge_map = section.settings.badges | split: ',' -%}
        {%- if badge_map.size > 0 and section.settings.show_badges -%}
          <div class="nc-pdp__usps">
            {%- for pair in badge_map limit: 3 -%}
              {%- assign p = pair | split: ':' -%}
              <span class="nc-pdp__usp">
                <img src="{{ p[0] | strip | prepend: 'nc-badge-' | append: '.svg' | asset_url }}" alt="" width="34" height="34" loading="lazy">
                {{ p[1] | strip }}
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="nc-pdp__price{% if on_sale %} is-sale{% endif %}">
          {{ v.price | money }}
          {%- if on_sale -%}
            <s><span class="nc-visually-hidden">Normalpris </span>{{ v.compare_at_price | money }}</s>
          {%- endif -%}
        </div>

        {%- comment -%}
          App-blokke (fx Katching bundles til maengderabat). Placeres i
          temaeditoren mellem pris og koebsknap, hvor designets
          maengdevaelger sidder.
        {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- render block -%}
        {%- endfor -%}

        {%- form 'product', product, data-nc-product-form: '' -%}
          {%- unless product.has_only_default_variant -%}
            <div>
              <label class="nc-label" for="nc-variant">Variant</label>
              <select id="nc-variant" class="nc-select" name="id">
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}" {% if variant == v %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title }} · {{ variant.price | money }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ v.id }}">
          {%- endunless -%}

          <div class="nc-pdp__form">
            <div class="nc-pdp__addrow" data-nc-qty-wrap>
              <span class="nc-qty">
                <button type="button" data-nc-step="-1" aria-label="Færre">−</button>
                <input type="number" name="quantity" min="1" value="1" aria-label="Antal">
                <button type="button" data-nc-step="1" aria-label="Flere">+</button>
              </span>
              <button class="nc-btn nc-btn--primary" type="submit" name="add" {% unless v.available %}disabled{% endunless %}>
                {%- if v.available %}Tilføj til kurv{% else %}Udsolgt{% endif -%}
              </button>
            </div>
            <div class="nc-pdp__meta">
              <span>Fri fragt over 399 kr.</span>
              <span>Levering 1-3 hverdage</span>
              <span>30 dages returret</span>
            </div>
          </div>
        {%- endform -%}

        <div class="nc-acc">
          <details class="nc-acc__item" open>
            <summary class="nc-acc__head">
              Beskrivelse
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="nc-acc__body">{{ product.description }}</div>
          </details>
          {%- if product.metafields.nc.usage.value != blank or section.settings.usage_fallback != blank -%}
            <details class="nc-acc__item">
              <summary class="nc-acc__head">
                Sådan bruger du den
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="nc-acc__body">{{ product.metafields.nc.usage.value | default: section.settings.usage_fallback }}</div>
            </details>
          {%- endif -%}
          {%- if product.metafields.nc.ingredients.value != blank or section.settings.ingredients_fallback != blank -%}
            <details class="nc-acc__item">
              <summary class="nc-acc__head">
                Ingredienser
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="nc-acc__body">{{ product.metafields.nc.ingredients.value | default: section.settings.ingredients_fallback }}</div>
            </details>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<div class="nc-buybar" data-nc-buybar>
  <span class="nc-buybar__title">{{ main_title }}</span>
  <button class="nc-btn nc-btn--primary" data-nc-add="{{ v.id }}" {% unless v.available %}disabled{% endunless %}>
    {%- if v.available %}Tilføj · {{ v.price | money }}{% else %}Udsolgt{% endif -%}
  </button>
</div>

{% schema %}
{
  "name": "Produkt",
  "tag": "section",
  "blocks": [
    { "type": "@app" }
  ],
  "settings": [
    { "type": "checkbox", "id": "show_badges", "label": "Vis claim-badges", "default": true },
    {
      "type": "text",
      "id": "badges",
      "label": "Badges (nøgle: tekst, kommasepareret)",
      "default": "cbd: Med CBD, moisture: Fugtgivende, vegan: Vegansk",
      "info": "Nøgler: cbd, moisture, easy, mild, barrier, vegan, balancing, aftersun, alle, lab. Overstyres pr. produkt med metafeltet nc.badges."
    },
    {
      "type": "textarea",
      "id": "usage_fallback",
      "label": "Sådan bruger du den (fallback)",
      "default": "Påfør på ren, tør hud morgen og/eller aften. Til udvortes brug. Undgå direkte kontakt med øjnene. Opbevares køligt og mørkt.",
      "info": "Vises når produktet ikke har metafeltet nc.usage."
    },
    {
      "type": "textarea",
      "id": "ingredients_fallback",
      "label": "Ingredienser (fallback)",
      "default": "CBD (Cannabidiol), naturlige planteolier og botaniske ekstrakter. Vegansk. Uden tilsatte syntetiske duftstoffer.",
      "info": "Vises når produktet ikke har metafeltet nc.ingredients."
    }
  ]
}
{% endschema %}
