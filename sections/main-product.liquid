{% comment %}
  Produktside 1:1 fra NatureCell.dc.html (PDP):
  "Tilbage til shop"-knap, galleri (hovedkort + kvadratiske thumbs under),
  koebskolonne i designets raekkefoelge: eyebrow, titel, stoerrelse, stjerner,
  pris, beskrivelse, 3 claim-badges, "Køb flere, spar mere"-label med
  app-blok-slot (Katching lejer felterne), fuldbredde CTA, lyst USP-loeb
  og accordions (Beskrivelse aaben som standard).

  Maengderabatten ejes af Katching-appen (app-blok); temaet regner aldrig
  selv rabatter.
{% endcomment %}

{%- liquid
  assign v = product.selected_or_first_available_variant
  assign is_bundle = false
  if product.tags contains 'pakker' or product.tags contains 'Pakker' or product.tags contains 'bundle'
    assign is_bundle = true
  endif
  assign eyebrow = 'NatureCell'
  if product.title contains 'ALFALAB'
    assign eyebrow = 'ALFALAB'
  endif
  if is_bundle
    assign eyebrow = eyebrow | append: ' Sampakke'
  endif
  assign title_parts = product.title | split: ' | '
  assign main_title = title_parts[0]
  assign sub_title = title_parts[1]
  assign size_line = product.metafields.ncell.size.value | default: sub_title
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign on_sale = false
  if v.compare_at_price > v.price
    assign on_sale = true
    assign save_pct = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round
  endif
-%}

{%- style -%}
  .nc-pdp-top { padding: clamp(18px, 5vw, 30px) 0 0; }
  .nc-pdp-back { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 22px; padding: 1px 6px; border: 0; background: none; cursor: pointer; font-family: var(--font-body); font-weight: 600; font-size: 14px; line-height: normal; color: var(--sage-700); text-decoration: none; }

  .nc-pdp { display: grid; gap: clamp(28px, 5vw, 56px); grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 900px) {
    .nc-pdp { grid-template-columns: 1fr 1fr; }
    /* Designet: galleri-flisen sidder ~24px lavere end tekstkolonnens top */
    .nc-pdp__gallery { margin-top: 24px; }
  }

  .nc-pdp__gallery { position: sticky; top: 96px; display: flex; flex-direction: column; gap: 12px; }
  .nc-pdp__main { position: relative; background: var(--nc-product-tint, var(--sage-50)); border: 1px solid var(--border-soft); border-radius: var(--radius-xl); aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; padding: 32px; overflow: hidden; }
  .nc-pdp__main img { max-width: 88%; max-height: 88%; object-fit: contain; }
  .nc-pdp__badges { position: absolute; top: 18px; left: 18px; display: flex; flex-direction: column; gap: 6px; align-items: flex-start; z-index: 2; }
  .nc-pdp__thumbs { display: flex; gap: 10px; flex-wrap: wrap; }
  .nc-pdp__thumbs button { width: 72px; height: 72px; border-radius: var(--radius-md); border: 2px solid var(--border-soft); background: var(--sage-50); cursor: pointer; padding: 6px; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .nc-pdp__thumbs button.is-active { border-color: var(--sage-500); }
  .nc-pdp__thumbs img { max-width: 100%; max-height: 100%; object-fit: contain; }

  .nc-pdp__info { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .nc-pdp__eyebrow { font-family: var(--font-body); font-weight: 600; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sage-600); }
  .nc-pdp__title { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(24px, 3.7vw, 38px); line-height: 1.08; letter-spacing: -0.01em; color: var(--sage-700); }
  .nc-pdp__size { font-size: 15px; color: var(--ink-400); }

  .nc-pdp__rating { display: inline-flex; align-items: center; gap: 7px; }
  .nc-pdp__rating .nc-pdp__stars { display: inline-flex; gap: 2px; }
  .nc-pdp__rating svg { display: block; }
  .nc-pdp__count { font-family: var(--font-body); font-size: var(--text-sm); color: var(--ink-500); }

  .nc-pdp__price { display: inline-flex; align-items: baseline; gap: 10px; font-family: var(--font-body); }
  .nc-pdp__price-now { font-size: var(--text-2xl); font-weight: 500; color: var(--ink-900); line-height: 1; }
  .nc-pdp__price.is-sale .nc-pdp__price-now { color: var(--sale); }
  .nc-pdp__price-was { font-size: var(--text-md); color: var(--ink-400); text-decoration: line-through; line-height: 1; }
  .nc-pdp__pricebox { display: flex; flex-direction: column; align-items: flex-start; gap: 7px; }
  .nc-pdp__unit { font-family: var(--font-body); font-size: 13px; line-height: 1.3; color: var(--ink-500); }
  .nc-pdp__taxnote { font-family: var(--font-body); font-size: 12.5px; line-height: 1.3; color: var(--ink-400); }

  .nc-pdp__desc { margin: 0; max-width: 500px; font-size: 16px; line-height: 1.7; color: var(--ink-700); }
  .nc-pdp__desc p { margin: 0; }

  .nc-pdp__usps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding: 18px 0; border-top: 1px solid var(--border-soft); border-bottom: 1px solid var(--border-soft); margin: 2px 0 4px; }
  .nc-pdp__usp { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 11px; padding: 0 6px; }
  .nc-pdp__usp img { width: 62px; height: 62px; flex: none; display: block; }
  .nc-pdp__usp span { font-size: 12.5px; font-weight: 500; color: var(--ink-700); line-height: 1.3; }

  .nc-pdp__tiers { display: flex; flex-direction: column; gap: 10px; margin-top: 6px; }
  .nc-pdp__tierlabel { font-family: var(--font-body); font-weight: 600; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-500); }

  .nc-pdp__form { margin-top: 6px; }
  .nc-pdp__add { display: flex; width: 100%; align-items: center; justify-content: center; gap: 9px; padding: 15px 32px; font-family: var(--font-body); font-weight: 600; font-size: var(--text-lg); line-height: 1.1; letter-spacing: 0.01em; border-radius: var(--radius-pill); border: 1.5px solid var(--action); background: var(--action); color: var(--action-contrast, var(--cloud)); cursor: pointer; transition: background var(--dur-fast) var(--ease-soft), border-color var(--dur-fast) var(--ease-soft); }
  .nc-pdp__add:hover, .nc-pdp__add:focus-visible { background: var(--action-hover); border-color: var(--action-hover); }
  .nc-pdp__add[disabled] { opacity: 0.45; cursor: not-allowed; }

  .nc-pdp__ticker { margin-top: 10px; background: var(--sage-50); border-radius: var(--radius-md); overflow: hidden; padding: 14px 0; width: 100%; min-width: 0; }
  .nc-pdp__ticker-rail { display: flex; width: max-content; animation: nc-marquee 24s linear infinite; }
  .nc-pdp__ticker-item { display: flex; align-items: center; gap: 8px; padding: 0 22px; white-space: nowrap; color: var(--sage-700); }
  .nc-pdp__ticker-item svg { flex: none; display: block; }
  .nc-pdp__ticker-item span { font-family: var(--font-body); font-weight: 600; font-size: 13.5px; }

  .nc-pdp__acc { margin-top: 8px; border-top: 1px solid var(--border-soft); }
  .nc-pdp__acc details { border-bottom: 1px solid var(--border-soft); }
  .nc-pdp__acc summary { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 2px; cursor: pointer; text-align: left; font-family: var(--font-display); font-weight: 400; font-size: 17px; line-height: 1.3; color: var(--sage-700); list-style: none; }
  .nc-pdp__acc summary::-webkit-details-marker { display: none; }
  .nc-pdp__acc summary svg { flex: none; color: var(--ink-400); transition: transform var(--dur-fast) var(--ease-out); }
  .nc-pdp__acc details[open] summary svg { transform: rotate(180deg); }
  .nc-pdp__acc-body { margin: 0 2px 18px; font-size: 14px; line-height: 1.7; color: var(--ink-500); max-width: 500px; }
  .nc-pdp__acc-body p { margin: 0; }

  {%- comment -%} Mobil koebsbar 1:1 fra designet (shell.html 2998-3005): 44px billede, navn + stoerrelse, sage-knap. {%- endcomment -%}
  .nc-buybar { position: fixed; left: 0; right: 0; bottom: 0; z-index: var(--z-sticky); background: rgba(246, 244, 238, 0.96); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border-top: 1px solid var(--border-default); box-shadow: 0 -6px 24px rgba(44, 70, 61, 0.10); padding: 10px 14px calc(10px + env(safe-area-inset-bottom)); display: none; align-items: center; gap: 12px; transform: translateY(110%); transition: transform var(--dur-base) var(--ease-soft); }
  .nc-buybar.is-visible { transform: translateY(0); }
  .nc-buybar__img { width: 44px; height: 44px; flex: none; object-fit: contain; border-radius: 10px; background: var(--nc-product-tint, var(--sage-50)); }
  .nc-buybar__text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .nc-buybar__title { font-family: var(--font-body); font-weight: 600; font-size: 13px; color: var(--sage-700); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nc-buybar__size { font-size: 12px; color: var(--ink-500); }
  .nc-buybar__add { flex: none; border: 0; cursor: pointer; background: var(--sage-500); color: #fff; font-family: var(--font-body); font-weight: 600; font-size: 14px; min-height: 46px; padding: 0 20px; border-radius: 999px; }
  .nc-buybar__add:hover, .nc-buybar__add:focus-visible { background: var(--sage-600); }
  .nc-buybar__add[disabled] { opacity: 0.45; cursor: not-allowed; }
  @media (max-width: 899px) {
    .nc-buybar { display: flex; }
    .nc-pdp__gallery { position: static; }
  }
{%- endstyle -%}

<div class="nc-pdp-top" data-nc-buybar-anchor>
  <div class="nc-container">
    <a class="nc-pdp-back" href="{{ section.settings.back_url }}">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>
      {{ section.settings.back_label }}
    </a>

    <div class="nc-pdp">
      <div class="nc-pdp__gallery" data-nc-gallery>
        <div class="nc-pdp__main" data-nc-gallery-main>
          <div class="nc-pdp__badges">
            {%- if on_sale and settings.show_save_badge -%}
              <span class="nc-tag nc-tag--sale">Spar {{ save_pct }}%</span>
            {%- endif -%}
          </div>
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 1200 | image_tag: alt: product.featured_image.alt | default: main_title, widths: '480, 720, 960, 1200', sizes: '(min-width: 900px) 600px, 94vw' }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="nc-pdp__thumbs">
            {%- for image in product.images limit: 8 -%}
              <button
                type="button"
                data-nc-thumb="{{ image | image_url: width: 1200 }}"
                {% if forloop.first %}class="is-active"{% endif %}
                aria-label="Vis billede {{ forloop.index }}"
              >
                {{ image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="nc-pdp__info">
        <span class="nc-pdp__eyebrow">{{ eyebrow }}</span>
        <h1 class="nc-pdp__title">{{ main_title }}</h1>
        {%- if size_line != blank -%}
          <span class="nc-pdp__size">{{ size_line }}</span>
        {%- endif -%}

        {%- if rating != blank and rating_count != blank -%}
          {%- assign rating_round = rating.rating | default: rating | times: 1.0 | round -%}
          <span class="nc-pdp__rating">
            <span class="nc-pdp__stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                {%- if i <= rating_round -%}
                  <svg width="16" height="16" viewBox="0 0 24 24"><path d="M12 2.6l2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.95 6.2 21.05l1.1-6.45L2.6 9.95l6.5-.95L12 2.6z" fill="var(--sage-500)" stroke="var(--sage-500)" stroke-width="1.5" stroke-linejoin="round"/></svg>
                {%- else -%}
                  <svg width="16" height="16" viewBox="0 0 24 24"><path d="M12 2.6l2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.95 6.2 21.05l1.1-6.45L2.6 9.95l6.5-.95L12 2.6z" fill="none" stroke="var(--ink-300)" stroke-width="1.5" stroke-linejoin="round"/></svg>
                {%- endif -%}
              {%- endfor -%}
            </span>
            <span class="nc-pdp__count">({{ rating_count }})</span>
          </span>
        {%- endif -%}

        <div class="nc-pdp__pricebox">
          <span class="nc-pdp__price{% if on_sale %} is-sale{% endif %}">
            <span class="nc-pdp__price-now">{{ v.price | money }}</span>
            {%- if on_sale -%}
              <span class="nc-pdp__price-was"><span class="nc-visually-hidden">{{ 'product.regular_price' | t }} </span>{{ v.compare_at_price | money }}</span>
            {%- endif -%}
          </span>
          {%- comment -%}
            Enhedspris (Grundpreis) er lovpligtig i Tyskland (PAngV) for varer solgt efter
            maengde. Vises kun naar varianten har "pris pr. enhed" udfyldt i Shopify.
            Momsnoten "inkl. MwSt., zzgl. Versand" er ligeledes et tysk krav taet paa prisen.
          {%- endcomment -%}
          {%- if v.unit_price_measurement -%}
            <span class="nc-pdp__unit"><span class="nc-visually-hidden">{{ 'product.unit_price' | t }} </span>{{ v.unit_price | money }} / {% if v.unit_price_measurement.reference_value != 1 %}{{ v.unit_price_measurement.reference_value }} {% endif %}{{ v.unit_price_measurement.reference_unit }}</span>
          {%- endif -%}
          {%- comment -%}
            Det godkendte danske design har ingen momsnote under prisen; noten vises derfor kun
            paa andre sprog (tysk lovkrav), medmindre "ogsaa paa dansk" er slaaet til.
          {%- endcomment -%}
          {%- if section.settings.show_tax_note -%}
            {%- if request.locale.iso_code != 'da' or section.settings.tax_note_da -%}
              <span class="nc-pdp__taxnote">{{ 'product.tax_note' | t }}</span>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- comment -%} Beskrivelsen vises kun én gang: i "Beskrivelse"-accordionen under CTA'en (kundens ønske). {%- endcomment -%}

        {%- assign badge_lines = product.metafields.ncell.badges.value | default: section.settings.badges | newline_to_br | split: '<br />' -%}
        {%- if section.settings.show_badges and badge_lines.size > 0 -%}
          <div class="nc-pdp__usps">
            {%- for line in badge_lines limit: 3 -%}
              {%- assign p = line | strip | split: ':' -%}
              <div class="nc-pdp__usp">
                <img src="{{ p[0] | strip | prepend: 'nc-badge-' | append: '.svg' | asset_url }}" alt="" width="62" height="62" loading="lazy">
                <span>{{ p[1] | strip }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%}
          App-slot: app-blokke (Katching maengderabat, Yotpo Loyalty-point m.fl.) lejer
          felterne her. Temaet viser kun labelen og slottet og regner aldrig selv rabatter.
          Uden en "Label"-blok vises labelen "Køb flere, spar mere" foerst og alle app-blokke
          under den. Tilfoejes en Label-blok, styrer raekkefoelgen i temaeditoren placeringen,
          fx: [Yotpo-point] [Label] [Katching].
        {%- endcomment -%}
        {%- assign has_label_block = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'label' -%}{%- assign has_label_block = true -%}{%- endif -%}
        {%- endfor -%}
        {%- comment -%} Uden blokke vises hverken label eller slot, saa der ikke staar en forladt overskrift. {%- endcomment -%}
        {%- if section.blocks.size > 0 -%}
        <div class="nc-pdp__tiers">
          {%- unless has_label_block -%}
            <span class="nc-pdp__tierlabel">{{ section.settings.tiers_label }}</span>
          {%- endunless -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'label' -%}
              <span class="nc-pdp__tierlabel" {{ block.shopify_attributes }}>{{ block.settings.text | default: section.settings.tiers_label }}</span>
            {%- elsif block.type == 'yotpo_widget' -%}
              {%- if block.settings.instance_id != blank -%}
                <div class="yotpo-widget-instance" data-yotpo-instance-id="{{ block.settings.instance_id | strip }}" data-yotpo-product-id="{{ product.id }}" {{ block.shopify_attributes }}></div>
              {%- endif -%}
            {%- else -%}
              {%- render block -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- endif -%}

        <div class="nc-pdp__form">
        {%- form 'product', product, data-nc-product-form: '' -%}
          {%- unless product.has_only_default_variant -%}
            <div style="margin-bottom: 12px;">
              <label class="nc-label" for="nc-variant">{{ 'product.variant' | t }}</label>
              <select id="nc-variant" class="nc-select" name="id">
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}" {% if variant == v %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title }} · {{ variant.price | money }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ v.id }}">
          {%- endunless -%}
          <input type="hidden" name="quantity" value="1">
          <button class="nc-pdp__add" type="submit" name="add" {% unless v.available %}disabled{% endunless %}>
            {%- if v.available %}Tilføj til kurv · {{ v.price | money_without_trailing_zeros }}.{% else %}Udsolgt{% endif -%}
          </button>
        {%- endform -%}
        </div>

        {%- assign ticker_lines = section.settings.ticker_items | newline_to_br | split: '<br />' -%}
        {%- if ticker_lines.size > 0 -%}
          <div class="nc-pdp__ticker" aria-label="{{ 'cart.benefits_title' | t }}">
            <div class="nc-pdp__ticker-rail">
              {%- for i in (1..2) -%}
                {%- for line in ticker_lines -%}
                  {%- assign tp = line | split: ' | ' -%}
                  <div class="nc-pdp__ticker-item" {% if i == 2 %}aria-hidden="true"{% endif %}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="{{ tp[1] | strip }}"/></svg>
                    <span>{{ tp[0] | strip }}</span>
                  </div>
                {%- endfor -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <div class="nc-pdp__acc">
          <details open>
            <summary>
              Beskrivelse
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="nc-pdp__acc-body">{{ product.description }}</div>
          </details>
          {%- if product.metafields.ncell.usage.value != blank or section.settings.usage_fallback != blank -%}
            <details>
              <summary>
                Sådan bruger du den
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="nc-pdp__acc-body">{{ product.metafields.ncell.usage.value | default: section.settings.usage_fallback }}</div>
            </details>
          {%- endif -%}
          {%- if product.metafields.ncell.ingredients.value != blank or section.settings.ingredients_fallback != blank -%}
            <details>
              <summary>
                {{ 'nav.ingredients' | t }}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="nc-pdp__acc-body">{{ product.metafields.ncell.ingredients.value | default: section.settings.ingredients_fallback }}</div>
            </details>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<div class="nc-buybar" data-nc-buybar>
  {%- if product.featured_image -%}
    {{ product.featured_image | image_url: width: 88 | image_tag: class: 'nc-buybar__img', alt: '', loading: 'lazy', widths: '44, 88' }}
  {%- endif -%}
  <div class="nc-buybar__text">
    <span class="nc-buybar__title">{{ main_title }}</span>
    {%- if size_line != blank -%}<span class="nc-buybar__size">{{ size_line }}</span>{%- endif -%}
  </div>
  <button class="nc-buybar__add" type="button" data-nc-add="{{ v.id }}" {% unless v.available %}disabled{% endunless %}>
    {%- if v.available %}Tilføj til kurv · {{ v.price | money_without_trailing_zeros }}.{% else %}{{ 'product.sold_out' | t }}{% endif -%}
  </button>
</div>

{% schema %}
{
  "name": "Produkt",
  "tag": "section",
  "blocks": [
    { "type": "@app" },
    {
      "type": "label",
      "name": "Label til app-slot",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Tekst", "default": "Køb flere, spar mere", "info": "Placér labelen mellem app-blokkene for at styre, hvad der står over hvad, fx Yotpo-point først, så labelen, så Kaching." }
      ]
    },
    {
      "type": "yotpo_widget",
      "name": "Yotpo Loyalty-widget",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "instance_id", "label": "Yotpo instans-id", "info": "Fx produktsidens pointvisning (Points on product page). Findes i Yotpo Loyalty under Display on site → Widgets." }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "back_label", "label": "Tilbage-knap: tekst", "default": "Tilbage til shop" },
    { "type": "text", "id": "back_url", "label": "Tilbage-knap: link", "info": "Sti eller URL. Shopify tillader ikke standardværdi på url-typen.", "default": "/collections/cbd-hudpleje" },
