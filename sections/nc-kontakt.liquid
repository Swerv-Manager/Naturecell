{% comment %}
  Kontaktside 1:1 fra designet (design-src/extracted/shell.html 2318-2357):
  1100px-hero med "Vi sidder klar", 72px-overskrift og intro, derefter to
  kolonner: kontaktblokke med hairlines til venstre (butiksblokken har
  aabningstider under en stiplet linje) og hvidt "Skriv til os"-kort med
  Shopifys kontaktformular til hoejre. Tekster foelger brandprofilen: ingen
  tankestreger, derfor "Mandag til fredag" i stedet for designets streger.
{% endcomment %}

{%- style -%}
  .nc-kontakt__hero { max-width: 1100px; margin: 0 auto; padding: clamp(43px, 5vw, 72px) clamp(16px, 4vw, 24px) clamp(16px, 6vw, 26px); }
  .nc-kontakt__hero .nc-eyebrow { margin: 0; font-size: 12px; letter-spacing: 0.14em; color: var(--sage-600); }
  .nc-kontakt__hero h1 { margin: 12px 0 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(44px, 6vw, 72px); line-height: 1; letter-spacing: -0.015em; color: var(--sage-700); }
  .nc-kontakt__hero p { margin: 18px 0 0; max-width: 520px; font-size: 17px; line-height: 1.7; color: var(--ink-700); }

  .nc-kontakt__grid { max-width: 1100px; margin: 0 auto; padding: clamp(16px, 5vw, 26px) clamp(16px, 4vw, 24px) clamp(54px, 6vw, 90px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .nc-kontakt__blocks { display: flex; flex-direction: column; }
  .nc-kontakt__block { padding: 22px 0; border-top: 1px solid var(--border-soft); display: flex; flex-direction: column; gap: 5px; }
  .nc-kontakt__block strong { font-family: var(--font-body); font-weight: 700; font-size: 15.5px; color: var(--sage-700); }
  .nc-kontakt__block a { align-self: flex-start; font-family: var(--font-body); font-size: 19px; line-height: 1.4; color: var(--sage-600); text-decoration: none; border-bottom: 1px solid var(--sage-300); }
  .nc-kontakt__block span { font-size: 16px; line-height: 1.6; color: var(--ink-500); }
  .nc-kontakt__hours { display: flex; flex-direction: column; gap: 5px; margin-top: 10px; padding-top: 12px; border-top: 1px dashed var(--border-default); max-width: 320px; }
  .nc-kontakt__hours-label { font-family: var(--font-body); font-weight: 600; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--sage-600); margin-bottom: 2px; }
  .nc-kontakt__row { display: flex; justify-content: space-between; gap: 20px; font-size: 16px; line-height: 1.7; color: var(--ink-500); }
  .nc-kontakt__row em { font-style: normal; color: var(--sage-700); }

  .nc-kontakt__card { background: var(--cloud); border: 1px solid var(--border-soft); border-radius: var(--radius-xl); box-shadow: var(--shadow-sm); padding: 32px; display: flex; flex-direction: column; gap: 16px; }
  .nc-kontakt__card h2 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 24px; letter-spacing: normal; color: var(--sage-700); }
  .nc-kontakt__card form { display: flex; flex-direction: column; gap: 16px; }
  .nc-kontakt__field { display: flex; flex-direction: column; gap: 6px; }
  .nc-kontakt__field label { font-family: var(--font-body); font-weight: 600; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-500); }
  .nc-kontakt__field input, .nc-kontakt__field textarea { width: 100%; border: 1px solid var(--border-default); background: var(--cloud); border-radius: var(--radius-md); padding: 12px 14px; font-family: var(--font-body); font-size: 15px; color: var(--sage-700); outline: none; }
  .nc-kontakt__field textarea { background: var(--paper); resize: vertical; }
  .nc-kontakt__field input:focus-visible, .nc-kontakt__field textarea:focus-visible { border-color: var(--sage-500); box-shadow: var(--shadow-focus); }
  .nc-kontakt__submit { border: 0; cursor: pointer; background: var(--sage-500); color: #fff; font-family: var(--font-body); font-weight: 600; font-size: 15px; padding: 14px; border-radius: 999px; }
  .nc-kontakt__submit:hover, .nc-kontakt__submit:focus-visible { background: var(--sage-600); }
  .nc-kontakt__status { margin: 0; font-size: 14.5px; line-height: 1.6; color: var(--sage-700); }
  .nc-kontakt__status[role="alert"] { color: var(--accent-berry); }
{%- endstyle -%}

<section class="nc-kontakt__hero">
  {%- if section.settings.eyebrow != blank -%}
    <p class="nc-eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  <h1>{{ section.settings.heading | default: page.title }}</h1>
  {%- if section.settings.intro != blank -%}
    <p>{{ section.settings.intro }}</p>
  {%- endif -%}
</section>

<section class="nc-kontakt__grid">
  <div class="nc-kontakt__blocks">
    {%- for block in section.blocks -%}
      <div class="nc-kontakt__block" {{ block.shopify_attributes }}>
        <strong>{{ block.settings.title }}</strong>
        {%- if block.settings.link_text != blank -%}
          <a href="{{ block.settings.link_url }}">{{ block.settings.link_text }}</a>
        {%- endif -%}
        {%- assign lines = block.settings.lines | newline_to_br | split: '<br />' -%}
        {%- for line in lines -%}
          {%- assign clean = line | strip -%}
          {%- if clean != blank -%}<span>{{ clean }}</span>{%- endif -%}
        {%- endfor -%}
        {%- if block.settings.show_hours and section.settings.hours != blank -%}
          <div class="nc-kontakt__hours">
            <span class="nc-kontakt__hours-label">{{ section.settings.hours_label }}</span>
            {%- assign rows = section.settings.hours | newline_to_br | split: '<br />' -%}
            {%- for row in rows -%}
              {%- assign parts = row | strip | split: '|' -%}
              {%- if parts[0] != blank -%}
                <div class="nc-kontakt__row"><span>{{ parts[0] | strip }}</span><em>{{ parts[1] | strip }}</em></div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="nc-kontakt__card">
    <h2>{{ section.settings.form_heading }}</h2>
    {%- form 'contact', id: 'nc-kontakt-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="nc-kontakt__status" role="status">{{ 'forms.contact_success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="nc-kontakt__status" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="nc-kontakt__field">
        <label for="nc-kontakt-name">{{ 'forms.name' | t }}</label>
        <input id="nc-kontakt-name" type="text" name="contact[name]" placeholder="{{ 'forms.name_placeholder' | t }}" autocomplete="name">
      </div>
      <div class="nc-kontakt__field">
        <label for="nc-kontakt-email">{{ 'forms.email' | t }}</label>
        <input id="nc-kontakt-email" type="email" name="contact[email]" placeholder="{{ 'forms.email_placeholder' | t }}" autocomplete="email" required>
      </div>
      <div class="nc-kontakt__field">
        <label for="nc-kontakt-body">{{ 'forms.message' | t }}</label>
        <textarea id="nc-kontakt-body" name="contact[body]" rows="4" placeholder="{{ 'forms.message_placeholder' | t }}" required></textarea>
      </div>
      <button class="nc-kontakt__submit" type="submit">{{ 'forms.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Kontakt",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Vi sidder klar" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Kontakt os" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Spørgsmål om produkter, din ordre eller CBD? Vores danske kundeservice hjælper dig gerne." },
    { "type": "header", "content": "Åbningstider (vises i blokken med flueben)" },
    { "type": "text", "id": "hours_label", "label": "Label", "default": "Butikkens åbningstider" },
    { "type": "textarea", "id": "hours", "label": "Rækker (én pr. linje: Dage | Tid)", "default": "Mandag til fredag | 10.00 til 17.30\nLørdag | 10.00 til 15.00\nSøn- & helligdage | Lukket" },
    { "type": "header", "content": "Formular" },
    { "type": "text", "id": "form_heading", "label": "Overskrift", "default": "Skriv til os" }
  ],
  "blocks": [
    {
      "type": "block",
      "name": "Kontaktblok",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Kundeservice" },
        { "type": "text", "id": "link_text", "label": "Linktekst", "default": "hello@naturecell.dk" },
        { "type": "text", "id": "link_url", "label": "Link", "default": "mailto:hello@naturecell.dk" },
        { "type": "textarea", "id": "lines", "label": "Linjer (én pr. linje)", "default": "Skriv til os. Vi svarer typisk inden for én hverdag." },
        { "type": "checkbox", "id": "show_hours", "label": "Vis åbningstider under blokken", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kontakt",
      "blocks": [
        { "type": "block", "settings": { "title": "Kundeservice", "link_text": "hello@naturecell.dk", "link_url": "mailto:hello@naturecell.dk", "lines": "Skriv til os. Vi svarer typisk inden for én hverdag." } },
        { "type": "block", "settings": { "title": "Telefon", "link_text": "+45 40 55 00 42", "link_url": "tel:+4540550042", "lines": "Mandag til fredag 9.00 til 15.00" } },
        { "type": "block", "settings": { "title": "Butik Lille Nyhavn", "link_text": "", "link_url": "", "lines": "Lille Nyhavn 4-7\n8660 Skanderborg\nShop-in-shop med personlig vejledning", "show_hours": true } },
        { "type": "block", "settings": { "title": "NatureCell Denmark ApS", "link_text": "", "link_url": "", "lines": "Lille Nyhavn 10, 2. tv.\n8660 Skanderborg\nCVR 42256013" } }
      ]
    }
  ]
}
{% endschema %}
