{% comment %} Kontaktside fra designet: fire infokort + aabningstider. {% endcomment %}

{%- style -%}
  .nc-kontakt__grid { display: grid; gap: clamp(14px, 2vw, 22px); grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .nc-kontakt__card { background: var(--cloud); border-radius: var(--radius-lg); padding: clamp(20px, 2.6vw, 30px); box-shadow: var(--shadow-xs); }
  .nc-kontakt__card h3 { font-size: 19px; margin-bottom: 8px; }
  .nc-kontakt__card p { margin: 0 0 8px; font-size: 14.5px; color: var(--ink-700); }
  .nc-kontakt__card a { font-weight: 600; }
  .nc-kontakt__hours { max-width: 460px; margin-top: clamp(26px, 3.4vw, 40px); }
  .nc-kontakt__hours table { width: 100%; border-collapse: collapse; }
  .nc-kontakt__hours td { padding: 10px 0; border-bottom: 1px solid var(--border-soft); font-size: 14.5px; }
  .nc-kontakt__hours td:last-child { text-align: right; font-weight: 600; color: var(--ink-900); }
{%- endstyle -%}

<section class="nc-section" style="padding-top: 10px;">
  <div class="nc-container">
    <div class="nc-kontakt__grid">
      {%- for block in section.blocks -%}
        <div class="nc-kontakt__card" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text | newline_to_br }}</p>
          {%- if block.settings.link_text != blank -%}
            <a href="{{ block.settings.link_url }}">{{ block.settings.link_text }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_hours -%}
      <div class="nc-kontakt__hours">
        <h2>{{ section.settings.hours_heading }}</h2>
        <table>
          {%- assign rows = section.settings.hours | newline_to_br | split: '<br />' -%}
          {%- for row in rows -%}
            {%- assign parts = row | strip | split: '|' -%}
            {%- if parts[0] != blank -%}
              <tr><td>{{ parts[0] | strip }}</td><td>{{ parts[1] | strip }}</td></tr>
            {%- endif -%}
          {%- endfor -%}
        </table>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Kontaktkort",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_hours", "label": "Vis åbningstider", "default": true },
    { "type": "text", "id": "hours_heading", "label": "Åbningstider, overskrift", "default": "Åbningstider · Butik Lille Nyhavn" },
    { "type": "textarea", "id": "hours", "label": "Åbningstider (én pr. linje: Dage | Tid)", "default": "Mandag, fredag | 10.00, 17.30\nLørdag | 10.00, 15.00\nSøn- & helligdage | Lukket" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Infokort",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Kundeservice" },
        { "type": "textarea", "id": "text", "label": "Tekst", "default": "Skriv til os. Vi svarer typisk inden for én hverdag." },
        { "type": "text", "id": "link_text", "label": "Linktekst", "default": "hello@naturecell.dk" },
        { "type": "text", "id": "link_url", "label": "Link-URL", "default": "mailto:hello@naturecell.dk" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kontaktkort",
      "blocks": [
        { "type": "card", "settings": { "title": "Kundeservice", "text": "Skriv til os. Vi svarer typisk inden for én hverdag.", "link_text": "hello@naturecell.dk", "link_url": "mailto:hello@naturecell.dk" } },
        { "type": "card", "settings": { "title": "Telefon", "text": "Mandag, fredag 9.00, 15.00", "link_text": "+45 40 55 00 42", "link_url": "tel:+4540550042" } },
        { "type": "card", "settings": { "title": "Butik Lille Nyhavn", "text": "Lille Nyhavn 4-7\n8660 Skanderborg\nShop-in-shop med personlig vejledning", "link_text": "", "link_url": "" } },
        { "type": "card", "settings": { "title": "NatureCell Denmark ApS", "text": "Lille Nyhavn 10, 2. tv.\n8660 Skanderborg\nCVR 42256013", "link_text": "", "link_url": "" } }
      ]
    }
  ]
}
{% endschema %}
