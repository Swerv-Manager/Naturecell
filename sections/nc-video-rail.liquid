{% comment %}
  Videorail fra designet: "Hør vores kunder fortælle" — kort med
  YouTube-thumbnail og playknap, aabner paa YouTube.
{% endcomment %}

{%- style -%}
  .nc-vidrail { background: var(--nc-foundervid-bg); }
  .nc-vidrail__card { position: relative; display: flex; flex-direction: column; gap: 8px; text-decoration: none; }
  .nc-vidrail__media { position: relative; aspect-ratio: 16 / 10; border-radius: var(--radius-lg); overflow: hidden; background: var(--sage-100); }
  .nc-vidrail__media img { width: 100%; height: 100%; object-fit: cover; }
  .nc-vidrail__media span { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .nc-vidrail__media span i { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: var(--radius-pill); background: rgba(255, 255, 255, 0.92); color: var(--sage-700); box-shadow: var(--shadow-md); }
  .nc-vidrail__name { font-family: var(--font-display); font-size: 17px; color: var(--sage-700); }
{%- endstyle -%}

<section class="nc-vidrail nc-section">
  <div class="nc-container" data-nc-railwrap>
    <div class="nc-best__head" style="display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: clamp(20px, 3vw, 30px);">
      <div>
        <p class="nc-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 style="margin: 0;">{{ section.settings.heading }}</h2>
      </div>
      <div style="display: flex; gap: 10px;">
        <button class="nc-iconbtn" data-nc-rail-prev aria-label="Rul tilbage">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button class="nc-iconbtn" data-nc-rail-next aria-label="Rul frem">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
        </button>
      </div>
    </div>

    <div class="nc-rail-scroll nc-scroll" data-nc-railscroll>
      {%- for block in section.blocks -%}
        {%- assign yt = block.settings.youtube_id -%}
        <a class="nc-vidrail__card" href="https://www.youtube.com/watch?v={{ yt }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          <span class="nc-vidrail__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 640 | image_tag: alt: block.settings.name, loading: 'lazy' }}
            {%- elsif yt != blank -%}
              <img src="https://img.youtube.com/vi/{{ yt }}/hqdefault.jpg" alt="{{ block.settings.name | escape }}" loading="lazy" width="480" height="360">
            {%- endif -%}
            <span aria-hidden="true"><i>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </i></span>
          </span>
          <span class="nc-vidrail__name">{{ block.settings.name }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Videorail",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Ægte oplevelser" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Hør vores kunder fortælle" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "text", "id": "name", "label": "Navn", "default": "Mette" },
        { "type": "text", "id": "youtube_id", "label": "YouTube-ID", "default": "VRJSZeNlCoQ" },
        { "type": "image_picker", "id": "image", "label": "Thumbnail (valgfri)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Videorail",
      "blocks": [
        { "type": "video", "settings": { "name": "Mette", "youtube_id": "VRJSZeNlCoQ" } },
        { "type": "video", "settings": { "name": "Christian", "youtube_id": "RHGezLkTcO8" } },
        { "type": "video", "settings": { "name": "Astrid", "youtube_id": "7_Bpx7LJIGc" } },
        { "type": "video", "settings": { "name": "Vivi", "youtube_id": "HwVoEwGZmyc" } }
      ]
    }
  ]
}
{% endschema %}
