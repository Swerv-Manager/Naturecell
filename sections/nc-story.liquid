{% comment %}
  "Vores historie"-strib fra designet: tekst + noegletal + CTA til
  venstre, grundlaeggerfoto med billedtekst til hoejre.
{% endcomment %}

{%- style -%}
  /* 1:1 fra designets STORY STRIP: papir-flade, 90px top/bund, grid auto-fit 320 gap 64, tekstkolonne gap 20 max 500 */
  .nc-story { background: var(--nc-story-bg, var(--paper)); color: var(--sage-700); position: relative; overflow: hidden; }
  .nc-story.nc-section { padding-top: clamp(50px, 6vw, 90px); padding-bottom: clamp(50px, 6vw, 90px); }
  .nc-story__grid { display: grid; gap: clamp(26px, 5vw, 64px); grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); align-items: center; }
  .nc-story__text { display: flex; flex-direction: column; gap: 20px; max-width: 500px; }
  #shopify-section-{{ section.id }} .nc-story__text .nc-eyebrow { margin: 0; font-size: 12px; font-weight: 600; line-height: 1.7; letter-spacing: 0.14em; color: var(--sage-600); }
  /* text-wrap: wrap saa linjebrud matcher designet: "Danmarks første, og / stadig drevet af én / familie" */
  .nc-story__text h2 { margin: 0; font-size: clamp(34px, 4vw, 52px); line-height: 1.06; letter-spacing: -0.01em; color: var(--sage-700); text-wrap: wrap; }
  .nc-story__body { margin: 0; font-size: 17px; line-height: 1.75; color: var(--ink-700); }
  .nc-story__stats { display: flex; gap: 14px; flex-wrap: wrap; margin: 4px 0 0; }
  .nc-story__stat { display: flex; flex-direction: column; gap: 2px; padding-right: 22px; border-right: 1px solid var(--border-default); }
  .nc-story__stat:last-child { border-right: 0; padding-right: 0; }
  .nc-story__stat strong { font-family: var(--font-display); font-weight: 400; font-size: clamp(19px, 2.9vw, 30px); line-height: 1; color: var(--sage-700); }
  .nc-story__stat span { font-size: 12.5px; line-height: 1.7; color: var(--ink-500); }
  /* Designets knap: 14px 28px, 15px/600 => 46px hoej */
  #shopify-section-{{ section.id }} .nc-story__cta { align-self: flex-start; margin-top: 10px; min-height: 0; padding: 14px 28px; line-height: normal; border: 0; }
  .nc-story__media { position: relative; border-radius: var(--radius-xl); overflow: hidden; aspect-ratio: 4 / 3; box-shadow: 0 30px 70px rgba(0, 0, 0, 0.4); }
  .nc-story__media img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 43% 22%; }
  .nc-story__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(40, 64, 59, 0.55), transparent 45%); pointer-events: none; }
  .nc-story__caption { position: absolute; left: 22px; bottom: 20px; z-index: 1; color: var(--paper); }
  .nc-story__caption strong { display: block; font-family: var(--font-display); font-weight: 400; font-size: 19px; line-height: 1.2; }
  .nc-story__caption span { display: block; font-size: 13px; color: rgba(246, 244, 238, 0.85); margin-top: 2px; }
{%- endstyle -%}

{%- comment -%} nc-flush-footer: designet har ingen luft mellem historie-striben og footeren (footeren nulstiller sin margin-top). {%- endcomment -%}
<section class="nc-section nc-story nc-flush-footer">
  <div class="nc-container">
    <div class="nc-story__grid">
      <div class="nc-story__text">
        <p class="nc-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <p class="nc-story__body">{{ section.settings.body }}</p>
        <div class="nc-story__stats">
          {%- for block in section.blocks -%}
            <div class="nc-story__stat" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.num }}</strong>
              <span>{{ block.settings.label }}</span>
            </div>
          {%- endfor -%}
        </div>
        {%- if section.settings.cta_text != blank -%}
          <a class="nc-btn nc-btn--primary nc-story__cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_text }}</a>
        {%- endif -%}
      </div>
      <div class="nc-story__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: alt: section.settings.caption_title, widths: '600, 900, 1200', loading: 'lazy' }}
        {%- else -%}
          <img src="{{ 'nc-founders.webp' | asset_url }}" alt="{{ section.settings.caption_title | escape }}" loading="lazy" width="1200" height="1500">
        {%- endif -%}
        <div class="nc-story__caption">
          <strong>{{ section.settings.caption_title }}</strong>
          <span>{{ section.settings.caption_sub }}</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vores historie-strib",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Vores historie" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Danmarks første, og stadig drevet af én familie" },
    { "type": "textarea", "id": "body", "label": "Brødtekst", "default": "NatureCell blev i 2019 den første CBD-hudplejeserie godkendt til salg i Danmark. Bag det hele står Lizbeth Falk og Allan Gamborg, en familiedrevet virksomhed bygget på ærlighed, dansk produktion og rigtige resultater frem for løfter." },
    { "type": "text", "id": "cta_text", "label": "Knap", "default": "Læs vores historie →" },
    { "type": "url", "id": "cta_url", "label": "Knap: link" },
    { "type": "image_picker", "id": "image", "label": "Billede", "info": "Standard: grundlæggerfotoet fra designet." },
    { "type": "text", "id": "caption_title", "label": "Billedtekst", "default": "Lizbeth Falk & Allan Gamborg" },
    { "type": "text", "id": "caption_sub", "label": "Billedtekst, undertekst", "default": "Grundlæggere af NatureCell" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Nøgletal",
      "settings": [
        { "type": "text", "id": "num", "label": "Tal", "default": "2019" },
        { "type": "text", "id": "label", "label": "Etiket", "default": "Først godkendt i DK" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vores historie-strib",
      "blocks": [
        { "type": "stat", "settings": { "num": "2019", "label": "Først godkendt i DK" } },
        { "type": "stat", "settings": { "num": "100%", "label": "Dansk produktion" } },
        { "type": "stat", "settings": { "num": "7.000+", "label": "Glade kunder" } }
      ]
    }
  ]
}
{% endschema %}
