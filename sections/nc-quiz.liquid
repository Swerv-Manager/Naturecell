{% comment %}
  Hudpleje-quiz fra designet: intro → omraade → behov → top 3-resultat.
  Produktdata serialiseres fra en kollektion; omraade/behov laeses fra
  tags (ansigt/haender/krop/foedder/haar) og metafeltet nc.needs.
{% endcomment %}

{%- style -%}
  .nc-quiz { max-width: 720px; margin: 0 auto; }
  .nc-quiz__progress { height: 6px; border-radius: var(--radius-pill); background: var(--sage-100); overflow: hidden; margin-bottom: clamp(24px, 3vw, 36px); }
  .nc-quiz__progress div { height: 100%; width: 0; background: var(--sage-500); transition: width var(--dur-slow) var(--ease-soft); }
  .nc-quiz__opts { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); margin-top: 20px; }
  .nc-quiz__opt { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 18px 14px; border: 1.5px solid var(--border-default); border-radius: var(--radius-lg); background: var(--cloud); cursor: pointer; font-family: inherit; text-align: center; }
  .nc-quiz__opt:hover { border-color: var(--sage-500); }
  .nc-quiz__opt strong { font-family: var(--font-display); font-weight: 400; font-size: 18px; color: var(--sage-700); }
  .nc-quiz__opt span { font-size: 12.5px; color: var(--ink-500); }
  .nc-quiz__nav { margin-top: 22px; display: flex; gap: 10px; }
  .nc-quiz-hit { display: flex; gap: 14px; align-items: center; padding: 12px; border: 1px solid var(--border-soft); border-radius: var(--radius-lg); background: var(--cloud); text-decoration: none; margin-top: 10px; }
  .nc-quiz-hit__media { width: 84px; height: 84px; flex: none; border-radius: var(--radius-md); background: var(--nc-product-tint); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .nc-quiz-hit__media img { max-width: 90%; max-height: 90%; object-fit: contain; }
  .nc-quiz-hit__body { display: flex; flex-direction: column; gap: 2px; }
  .nc-quiz-hit__body strong { font-family: var(--font-display); font-weight: 400; font-size: 17px; color: var(--sage-700); }
{%- endstyle -%}

<section class="nc-section" style="padding-top: 10px;">
  <div class="nc-container">
    <div class="nc-quiz" data-nc-quiz>
      <div class="nc-quiz__progress"><div data-nc-quiz-progress></div></div>

      <div data-nc-quiz-step="0">
        <h2>{{ section.settings.intro_heading }}</h2>
        <p>{{ section.settings.intro_text }}</p>
        <button class="nc-btn nc-btn--primary" data-nc-quiz-start>{{ 'quiz.start' | t }}</button>
      </div>

      <div data-nc-quiz-step="1" hidden>
        <h2>{{ 'collection.where_q' | t }}</h2>
        <div class="nc-quiz__opts">
          <button class="nc-quiz__opt" data-nc-quiz-area="ansigt" data-nc-label="Ansigt"><strong>{{ 'areas.face' | t }}</strong><span>{{ 'areas_sub.face' | t }}</span></button>
          <button class="nc-quiz__opt" data-nc-quiz-area="haender" data-nc-label="Hænder"><strong>{{ 'areas.hands' | t }}</strong><span>{{ 'areas_sub.hands' | t }}</span></button>
          <button class="nc-quiz__opt" data-nc-quiz-area="krop" data-nc-label="Krop"><strong>{{ 'areas.body' | t }}</strong><span>{{ 'areas_sub.body' | t }}</span></button>
          <button class="nc-quiz__opt" data-nc-quiz-area="foedder" data-nc-label="Fødder"><strong>{{ 'areas.feet' | t }}</strong><span>{{ 'areas_sub.feet' | t }}</span></button>
          <button class="nc-quiz__opt" data-nc-quiz-area="haar" data-nc-label="Hår"><strong>{{ 'areas.hair' | t }}</strong><span>{{ 'areas_sub.hair' | t }}</span></button>
        </div>
        <div class="nc-quiz__nav"><button class="nc-btn nc-btn--outline" data-nc-quiz-back>{{ 'general.back' | t }}</button></div>
      </div>

      <div data-nc-quiz-step="2" hidden>
        <h2>{{ 'collection.what_q' | t }}</h2>
        <div class="nc-quiz__opts">
          <button class="nc-quiz__opt" data-nc-quiz-need="toer" data-nc-label="Tør hud"><strong>{{ 'needs.dry' | t }}</strong><span>{{ 'needs_sub.dry' | t }}</span></button>
          <button class="nc-quiz__opt" data-nc-quiz-need="fugt" data-nc-label="Fugt"><strong>{{ 'needs.moisture' | t }}</strong><span>{{ 'needs_sub.moisture' | t }}</span></button>
          <button class="nc-quiz__opt" data-nc-quiz-need="moden" data-nc-label="Moden hud"><strong>{{ 'needs.mature' | t }}</strong><span>{{ 'needs_sub.mature' | t }}</span></button>
          <button class="nc-quiz__opt" data-nc-quiz-need="sensitiv" data-nc-label="Sensitiv hud"><strong>{{ 'needs.sensitive' | t }}</strong><span>{{ 'needs_sub.sensitive' | t }}</span></button>
          <button class="nc-quiz__opt" data-nc-quiz-need="uren" data-nc-label="Uren hud"><strong>{{ 'needs.blemish' | t }}</strong><span>{{ 'needs_sub.blemish' | t }}</span></button>
          <button class="nc-quiz__opt" data-nc-quiz-need="genopbygning" data-nc-label="Genopbygning"><strong>{{ 'needs.repair' | t }}</strong><span>{{ 'needs_sub.repair' | t }}</span></button>
        </div>
        <div class="nc-quiz__nav"><button class="nc-btn nc-btn--outline" data-nc-quiz-back>{{ 'general.back' | t }}</button></div>
      </div>

      <div data-nc-quiz-step="3" hidden>
        <h2>{{ 'cart.recommendation' | t }}</h2>
        <p data-nc-quiz-labels class="nc-eyebrow"></p>
        <div data-nc-quiz-result></div>
        <div class="nc-quiz__nav">
          <button class="nc-btn nc-btn--outline" data-nc-quiz-restart>{{ 'quiz.retake' | t }}</button>
          <a class="nc-btn nc-btn--primary" href="{{ section.settings.all_url | default: '/collections/cbd-hudpleje' }}">{{ 'general.view_all_products' | t }}</a>
        </div>
      </div>

      {%- assign coll = section.settings.collection -%}
      <script type="application/json" data-nc-quiz-data>
        [
          {%- if coll != blank -%}
            {%- for p in coll.products limit: 50 -%}
              {%- assign areas = '' -%}
              {%- for tag in p.tags -%}
                {%- assign lt = tag | downcase -%}
                {%- if lt == 'ansigt' or lt == 'haender' or lt == 'krop' or lt == 'foedder' or lt == 'haar' -%}
                  {%- assign areas = areas | append: lt | append: ',' -%}
                {%- endif -%}
              {%- endfor -%}
              {
                "title": {{ p.title | split: ' | ' | first | json }},
                "url": {{ p.url | json }},
                "img": {{ p.featured_image | image_url: width: 300 | json }},
                "price": {{ p.price | money | json }},
                "rating": {{ p.metafields.reviews.rating.value.rating | default: 4.5 | json }},
                "areas": {{ areas | split: ',' | json }},
                "needs": {{ p.metafields.ncell.needs.value | default: '' | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          {%- endif -%}
        ]
      </script>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hudpleje-quiz",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "intro_heading", "label": "Intro, overskrift", "default": "Find din rutine på ét minut" },
    { "type": "textarea", "id": "intro_text", "label": "Intro, tekst", "default": "Svar på to hurtige spørgsmål, så peger vi dig i retning af de produkter, der passer til dig. Ingen løfter, bare et godt sted at starte." },
    { "type": "collection", "id": "collection", "label": "Produktkilde" },
    { "type": "url", "id": "all_url", "label": "Se alle-link" }
  ],
  "presets": [ { "name": "Hudpleje-quiz" } ]
}
{% endschema %}
