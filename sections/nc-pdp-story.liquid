{% comment %}
  Produktside: to redaktionelle splits 1:1 fra NatureCell.dc.html —
  "Derfor elsker vores kunder den" (billede venstre) og "Sådan bruger
  du den" (billede hoejre). Tekst fra metafelter (ncell.story_title /
  ncell.story / ncell.usage) med sektionsindstillinger som fallback.
{% endcomment %}

{%- liquid
  assign gimgs = product.images
  assign img_a = gimgs[1] | default: product.featured_image
  assign img_b = product.featured_image
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .nc-pdpstory { border-top: 1px solid var(--border-soft); }
  #shopify-section-{{ section.id }} .nc-pdpstory__inner { max-width: 1140px; margin: 0 auto; padding: clamp(35px, 6vw, 64px) var(--gutter); display: grid; gap: clamp(28px, 5vw, 48px); grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 700px) {
    #shopify-section-{{ section.id }} .nc-pdpstory__inner { grid-template-columns: 1fr 1fr; }
    #shopify-section-{{ section.id }} .nc-pdpstory--flip .nc-pdpstory__media { order: 2; }
  }
  #shopify-section-{{ section.id }} .nc-pdpstory__media { width: 100%; height: 400px; border-radius: 18px; object-fit: contain; background: var(--sage-50); padding: 20px; display: block; }
  #shopify-section-{{ section.id }} .nc-pdpstory__text { display: flex; flex-direction: column; gap: 14px; }
  #shopify-section-{{ section.id }} .nc-pdpstory__eyebrow { font-family: var(--font-body); font-weight: 600; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sage-600); }
  #shopify-section-{{ section.id }} .nc-pdpstory__text h2 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(20px, 3.1vw, 32px); line-height: 1.1; color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-pdpstory__text p { margin: 0; font-size: 16px; line-height: 1.8; color: var(--ink-700); }
{%- endstyle -%}

<section class="nc-pdpstory">
  <div class="nc-pdpstory__inner">
    {%- if img_a -%}
      {{ img_a | image_url: width: 1000 | image_tag: alt: product.title, loading: 'lazy', class: 'nc-pdpstory__media' }}
    {%- endif -%}
    <div class="nc-pdpstory__text">
      <span class="nc-pdpstory__eyebrow">{{ section.settings.eyebrow_1 }}</span>
      <h2>{{ product.metafields.ncell.story_title.value | default: section.settings.heading_1 }}</h2>
      <p>{{ product.metafields.ncell.story.value | default: product.description | strip_html | truncate: 420 }}</p>
    </div>
  </div>
</section>

<section class="nc-pdpstory nc-pdpstory--flip">
  <div class="nc-pdpstory__inner">
    {%- if img_b -%}
      {{ img_b | image_url: width: 1000 | image_tag: alt: product.title, loading: 'lazy', class: 'nc-pdpstory__media' }}
    {%- endif -%}
    <div class="nc-pdpstory__text">
      <span class="nc-pdpstory__eyebrow">{{ section.settings.eyebrow_2 }}</span>
      <h2>{{ product.metafields.ncell.usage_title.value | default: section.settings.heading_2 }}</h2>
      <p>{{ product.metafields.ncell.usage.value | default: section.settings.usage_fallback }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produkt-fortælling",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow_1", "label": "Blok 1: overlinje", "default": "Derfor elsker vores kunder den" },
    { "type": "text", "id": "heading_1", "label": "Blok 1: overskrift (fallback)", "default": "Vores mest elskede — Vidunder Olien" },
    { "type": "text", "id": "eyebrow_2", "label": "Blok 2: overlinje", "default": "Sådan bruger du den" },
    { "type": "text", "id": "heading_2", "label": "Blok 2: overskrift (fallback)", "default": "Et par dråber er alt der skal til" },
    { "type": "textarea", "id": "usage_fallback", "label": "Brugstekst (fallback)", "default": "Dryp et par dråber i håndfladen og massér blidt ind i ren hud morgen og/eller aften — alene eller under din creme. Kan også blandes i din lotion eller creme." }
  ]
}
{% endschema %}
