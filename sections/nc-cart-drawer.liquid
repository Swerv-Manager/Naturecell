{% comment %}
  Kurv-skuffe, oversat fra designet: fri fragt-bar mod 399 kr.,
  linjer med antalsvaelger, subtotal, besparelseslinje og checkout.
  Genrenderes via Section Rendering API (nc-theme.js).
{% endcomment %}

{%- style -%}
  .nc-drawer { position: fixed; inset: 0; z-index: var(--z-modal); pointer-events: none; }
  .nc-drawer__overlay { position: absolute; inset: 0; background: rgba(35, 51, 48, 0.4); opacity: 0; transition: opacity var(--dur-base) var(--ease-soft); }
  .nc-drawer__panel {
    position: absolute; top: 0; right: 0; bottom: 0;
    width: min(440px, 94vw);
    background: var(--paper);
    transform: translateX(102%);
    transition: transform var(--dur-base) var(--ease-soft);
    display: flex; flex-direction: column;
  }
  .nc-drawer.is-open { pointer-events: auto; }
  .nc-drawer.is-open .nc-drawer__overlay { opacity: 1; }
  .nc-drawer.is-open .nc-drawer__panel { transform: translateX(0); }

  .nc-drawer__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 22px; border-bottom: 1px solid var(--border-soft); }
  .nc-drawer__head h2 { margin: 0; font-size: var(--text-xl); }

  .nc-drawer__ship { padding: 14px 22px 4px; }
  .nc-drawer__ship p { margin: 0 0 8px; font-size: 13.5px; color: var(--ink-700); }
  .nc-drawer__bar { height: 6px; border-radius: var(--radius-pill); background: var(--sage-100); overflow: hidden; }
  .nc-drawer__fill { height: 100%; border-radius: var(--radius-pill); background: var(--sage-500); transition: width var(--dur-slow) var(--ease-soft); }

  .nc-drawer__lines { flex: 1; overflow-y: auto; padding: 10px 22px; display: flex; flex-direction: column; }
  .nc-drawer__line { display: flex; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--border-soft); }
  .nc-drawer__line img { width: 76px; height: 76px; object-fit: contain; border-radius: var(--radius-md); background: var(--nc-product-tint); padding: 6px; flex: none; }
  .nc-drawer__line-info { flex: 1; min-width: 0; }
  .nc-drawer__line-title { display: block; font-family: var(--font-display); font-size: 16px; color: var(--sage-700); text-decoration: none; }
  .nc-drawer__line-meta { font-size: 12.5px; color: var(--ink-500); }
  .nc-drawer__line-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 8px; }
  .nc-drawer__qty { display: inline-flex; align-items: center; border: 1px solid var(--border-default); border-radius: var(--radius-pill); }
  .nc-drawer__qty button { width: 30px; height: 30px; border: 0; background: none; color: var(--ink-700); font-size: 16px; cursor: pointer; }
  .nc-drawer__qty span { min-width: 22px; text-align: center; font-size: 14px; font-weight: 600; }
  .nc-drawer__line-price { font-weight: 700; font-size: 14.5px; color: var(--ink-900); }
  .nc-drawer__remove { background: none; border: 0; padding: 0; font-size: 12px; color: var(--ink-500); text-decoration: underline; cursor: pointer; }

  .nc-drawer__empty { text-align: center; padding: 48px 22px; }

  .nc-drawer__foot { border-top: 1px solid var(--border-default); padding: 16px 22px 22px; background: var(--paper-2); }
  .nc-drawer__totals { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
  .nc-drawer__totals strong { font-size: var(--text-lg); color: var(--ink-900); }
  .nc-drawer__savings { display: flex; justify-content: space-between; font-size: 13px; color: var(--accent-berry); margin-bottom: 10px; }
  .nc-drawer__note { font-size: 12px; color: var(--ink-500); margin: 0 0 12px; }
  .nc-drawer__foot .nc-btn { width: 100%; }
{%- endstyle -%}

{%- assign free_limit = 39900 -%}
{%- assign pct = cart.total_price | times: 100 | divided_by: free_limit -%}
{%- if pct > 100 -%}{%- assign pct = 100 -%}{%- endif -%}

<div class="nc-drawer" data-nc-drawer inert aria-label="Kurv" role="dialog" aria-modal="true">
  <div class="nc-drawer__overlay" data-nc-drawer-overlay></div>
  <div class="nc-drawer__panel">
    <div class="nc-drawer__head">
      <h2>Kurv {% if cart.item_count > 0 %}({{ cart.item_count }}){% endif %}</h2>
      <button class="nc-iconbtn" data-nc-cart-close aria-label="Luk kurv">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>

    <div class="nc-drawer__ship">
      <p>
        {%- if cart.total_price >= free_limit -%}
          Du har fri fragt 🎉
        {%- else -%}
          {%- assign missing = free_limit | minus: cart.total_price -%}
          Køb for {{ missing | money }} mere og få fri fragt
        {%- endif -%}
      </p>
      <div class="nc-drawer__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}" aria-label="Fri fragt-status">
        <div class="nc-drawer__fill" style="width: {{ pct }}%;"></div>
      </div>
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="nc-drawer__lines">
        {%- for item in cart.items -%}
          <div class="nc-drawer__line">
            {%- if item.image -%}
              {{ item.image | image_url: width: 152 | image_tag: alt: item.title, loading: 'lazy' }}
            {%- endif -%}
            <div class="nc-drawer__line-info">
              <a class="nc-drawer__line-title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <div class="nc-drawer__line-meta">{{ item.variant.title }}</div>
              {%- endunless -%}
              {%- for d in item.line_level_discount_allocations -%}
                <div class="nc-drawer__line-meta">{{ d.discount_application.title }}</div>
              {%- endfor -%}
              <div class="nc-drawer__line-row">
                <span class="nc-drawer__qty">
                  <button data-nc-line="{{ item.key }}" data-nc-line-qty="{{ item.quantity | minus: 1 }}" aria-label="Færre">−</button>
                  <span>{{ item.quantity }}</span>
                  <button data-nc-line="{{ item.key }}" data-nc-line-qty="{{ item.quantity | plus: 1 }}" aria-label="Flere">+</button>
                </span>
                <span class="nc-drawer__line-price">{{ item.final_line_price | money }}</span>
              </div>
              <button class="nc-drawer__remove" data-nc-line="{{ item.key }}" data-nc-line-qty="0">Fjern</button>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="nc-drawer__foot">
        <div class="nc-drawer__totals">
          <span>Subtotal</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        {%- if cart.total_discount > 0 -%}
          <div class="nc-drawer__savings">
            <span>Du sparer</span>
            <span>{{ cart.total_discount | money }}</span>
          </div>
        {%- endif -%}
        <p class="nc-drawer__note">Fragt beregnes ved kassen. Levering typisk 1-3 hverdage.</p>
        <a class="nc-btn nc-btn--primary" href="{{ routes.cart_url }}/checkout">Gå til kassen</a>
      </div>
    {%- else -%}
      <div class="nc-drawer__empty">
        <h3>Din kurv er tom</h3>
        <p>Udforsk sortimentet og find din nye rutine.</p>
        <a class="nc-btn nc-btn--sage" href="/collections/cbd-hudpleje" data-nc-cart-close>Shop nu</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kurv-skuffe",
  "settings": []
}
{% endschema %}
