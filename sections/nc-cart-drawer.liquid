{% comment %}
  Kurv-skuffe 1:1 fra designet (design-src/extracted/shell.html 3009-3067):
  430px panel paa papir, "Din kurv"-hoved, fri fragt-raekke med lastbil-ikon og
  bar mod 399 kr., linjer med 74px billedboks, antalspille, linjetotal og X,
  rabatkodefelt, og en bund med besparelsesboks, subtotal, sage-knap og momsnote.
  Genrenderes via Section Rendering API (nc-theme.js). Rabatkoden gemmes via
  Shopifys /discount/KODE-link og anvendes ved kassen.
{% endcomment %}

{%- style -%}
  .nc-drawer { position: fixed; inset: 0; z-index: var(--z-modal); pointer-events: none; }
  .nc-drawer__overlay { position: absolute; inset: 0; background: rgba(32, 38, 35, 0.42); opacity: 0; transition: opacity var(--dur-base) var(--ease-soft); }
  .nc-drawer__panel { position: absolute; top: 0; right: 0; bottom: 0; width: min(430px, 92vw); background: var(--paper); box-shadow: var(--shadow-lg); transform: translateX(102%); transition: transform var(--dur-base) var(--ease-out); display: flex; flex-direction: column; }
  .nc-drawer.is-open { pointer-events: auto; }
  .nc-drawer.is-open .nc-drawer__overlay { opacity: 1; }
  .nc-drawer.is-open .nc-drawer__panel { transform: translateX(0); }

  .nc-drawer__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 20px 24px; border-bottom: 1px solid var(--border-soft); }
  .nc-drawer__head h2 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 22px; letter-spacing: normal; color: var(--sage-700); }
  .nc-drawer__close { border: 0; background: none; cursor: pointer; color: var(--ink-500); padding: 4px; display: flex; }

  .nc-drawer__ship { padding: 16px 24px; border-bottom: 1px solid var(--border-soft); }
  .nc-drawer__ship p { margin: 0 0 9px; display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--ink-700); }
  .nc-drawer__ship svg { flex: none; color: var(--sage-600); }
  .nc-drawer__bar { height: 6px; border-radius: 3px; background: var(--sage-100); overflow: hidden; }
  .nc-drawer__fill { height: 100%; background: var(--sage-500); transition: width var(--dur-base) var(--ease-out); }

  .nc-drawer__lines { flex: 1; overflow-y: auto; padding: 6px 24px; }
  .nc-drawer__line { display: flex; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--border-soft); }
  .nc-drawer__line-media { width: 74px; height: 74px; flex: none; background: var(--cloud); border-radius: var(--radius-md); border: 1px solid var(--border-soft); display: flex; align-items: center; justify-content: center; padding: 6px; }
  .nc-drawer__line-media img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; mix-blend-mode: multiply; }
  .nc-drawer__line-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5px; }
  .nc-drawer__line-title { font-family: var(--font-body); font-weight: 600; font-size: 14px; line-height: 1.3; color: var(--sage-700); text-decoration: none; }
  .nc-drawer__line-meta { font-size: 12.5px; color: var(--ink-500); }
  .nc-drawer__line-discount { font-size: 11.5px; font-weight: 600; color: var(--sage-700); }
  .nc-drawer__line-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 3px; }
  .nc-drawer__qty { display: inline-flex; align-items: center; border: 1px solid var(--border-default); border-radius: 999px; overflow: hidden; }
  .nc-drawer__qty button { border: 0; background: none; cursor: pointer; padding: 5px 10px; color: var(--ink-700); font-size: 15px; line-height: 1.2; font-family: var(--font-body); }
  .nc-drawer__qty span { font-size: 13px; min-width: 20px; text-align: center; }
  .nc-drawer__line-price { font-weight: 600; font-size: 14px; color: var(--sage-700); white-space: nowrap; }
  .nc-drawer__line-was { font-weight: 400; color: var(--ink-400); margin-right: 4px; }
  .nc-drawer__remove { border: 0; background: none; cursor: pointer; color: var(--ink-300); align-self: flex-start; padding: 2px; display: flex; }
  .nc-drawer__remove:hover { color: var(--ink-700); }

  .nc-drawer__code { display: flex; gap: 8px; margin: 16px 0 6px; }
  .nc-drawer__code input { flex: 1; min-width: 0; border: 1px solid var(--border-default); background: var(--cloud); border-radius: 999px; padding: 11px 16px; font-family: var(--font-body); font-size: 13.5px; outline: none; color: var(--sage-700); }
  .nc-drawer__code input:focus-visible { border-color: var(--sage-500); }
  .nc-drawer__code button { border: 1.5px solid var(--sage-500); background: transparent; cursor: pointer; color: var(--sage-700); border-radius: 999px; padding: 11px 18px; font-family: var(--font-body); font-weight: 600; font-size: 13.5px; }
  .nc-drawer__code-note { margin: 0 0 8px; font-size: 12px; color: var(--ink-500); }
  .nc-drawer__code-note[hidden] { display: none; }

  .nc-drawer__empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; color: var(--ink-400); padding: 40px; text-align: center; }
  .nc-drawer__empty p { margin: 0; font-size: 15px; color: var(--ink-400); }
  .nc-drawer__empty a { display: inline-block; border: 1.5px solid var(--sage-500); color: var(--sage-700); font-family: var(--font-body); font-weight: 600; font-size: 14px; padding: 11px 22px; border-radius: 999px; text-decoration: none; }

  .nc-drawer__foot { padding: clamp(11px, 5vw, 18px) clamp(16px, 4vw, 24px) clamp(14px, 6vw, 24px); border-top: 1px solid var(--border-soft); background: var(--paper-2); display: flex; flex-direction: column; gap: 9px; }
  .nc-drawer__savings { display: flex; justify-content: space-between; align-items: center; background: var(--sage-100); border-radius: var(--radius-md); padding: 11px 14px; }
  .nc-drawer__savings span:first-child { font-size: 13.5px; font-weight: 600; color: var(--sage-700); }
  .nc-drawer__savings span:last-child { font-size: 15px; font-weight: 700; color: var(--sage-700); }
  .nc-drawer__totals { display: flex; justify-content: space-between; align-items: baseline; }
  .nc-drawer__totals span { font-size: 15px; color: var(--ink-700); }
  .nc-drawer__totals strong { font-family: var(--font-body); font-weight: 700; font-size: 22px; color: var(--sage-700); }
  .nc-drawer__checkout { display: block; text-align: center; border: 0; cursor: pointer; background: var(--sage-500); color: #fff; border-radius: 999px; padding: 15px; font-family: var(--font-body); font-weight: 600; font-size: 15px; margin-top: 4px; text-decoration: none; }
  .nc-drawer__checkout:hover, .nc-drawer__checkout:focus-visible { background: var(--sage-600); color: #fff; }
  .nc-drawer__note { margin: 6px 0 0; text-align: center; font-size: 12px; color: var(--ink-400); }
{%- endstyle -%}

{%- assign free_limit = 39900 -%}
{%- assign pct = cart.total_price | times: 100 | divided_by: free_limit -%}
{%- if pct > 100 -%}{%- assign pct = 100 -%}{%- endif -%}

<div class="nc-drawer" data-nc-drawer inert aria-label="{{ 'cart.title' | t }}" role="dialog" aria-modal="true">
  <div class="nc-drawer__overlay" data-nc-drawer-overlay></div>
  <div class="nc-drawer__panel">
    <div class="nc-drawer__head">
      <h2>{{ 'cart.title' | t }}</h2>
      <button class="nc-drawer__close" type="button" data-nc-cart-close aria-label="{{ 'general.close_cart' | t }}">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="nc-drawer__ship">
        <p>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 18H3V6h12v4"/><path d="M14 9h4l3 3v6h-2"/><circle cx="7.5" cy="18.5" r="1.5"/><circle cx="17.5" cy="18.5" r="1.5"/></svg>
          <span>
            {%- if cart.total_price >= free_limit -%}
              {{ 'cart.free_shipping_reached' | t }}
            {%- else -%}
              {%- assign missing = free_limit | minus: cart.total_price | money -%}
              {{ 'cart.free_shipping_missing' | t: amount: missing }}
            {%- endif -%}
          </span>
        </p>
        <div class="nc-drawer__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}" aria-label="{{ 'cart.free_shipping_status' | t }}">
          <div class="nc-drawer__fill" style="width: {{ pct }}%;"></div>
        </div>
      </div>

      <div class="nc-drawer__lines">
        {%- for item in cart.items -%}
          <div class="nc-drawer__line">
            <a class="nc-drawer__line-media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                {{ item.image | image_url: width: 148 | image_tag: alt: '', loading: 'lazy' }}
              {%- endif -%}
            </a>
            <div class="nc-drawer__line-info">
              <a class="nc-drawer__line-title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <span class="nc-drawer__line-meta">{{ item.variant.title }}</span>
              {%- endunless -%}
              {%- if item.unit_price_measurement -%}
                <span class="nc-drawer__line-meta">{{ item.unit_price | money }} / {% if item.unit_price_measurement.reference_value != 1 %}{{ item.unit_price_measurement.reference_value }} {% endif %}{{ item.unit_price_measurement.reference_unit }}</span>
              {%- endif -%}
              {%- comment -%} Rabatter (fx Kachings maengderabat) kommer fra Shopify som discount allocations. {%- endcomment -%}
              {%- for d in item.line_level_discount_allocations -%}
                <span class="nc-drawer__line-discount">{{ d.discount_application.title }} −{{ d.amount | money }}</span>
              {%- endfor -%}
              <div class="nc-drawer__line-row">
                <span class="nc-drawer__qty">
                  <button type="button" data-nc-line="{{ item.key }}" data-nc-line-qty="{{ item.quantity | minus: 1 }}" aria-label="{{ 'general.fewer' | t }}">−</button>
                  <span>{{ item.quantity }}</span>
                  <button type="button" data-nc-line="{{ item.key }}" data-nc-line-qty="{{ item.quantity | plus: 1 }}" aria-label="{{ 'general.more' | t }}">+</button>
                </span>
                <span class="nc-drawer__line-price">
                  {%- if item.line_level_total_discount > 0 -%}<s class="nc-drawer__line-was">{{ item.original_line_price | money }}</s> {% endif -%}
                  {{ item.final_line_price | money }}
                </span>
              </div>
            </div>
            <button class="nc-drawer__remove" type="button" data-nc-line="{{ item.key }}" data-nc-line-qty="0" aria-label="{{ 'cart.remove' | t }}">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
          </div>
        {%- endfor -%}

        <form class="nc-drawer__code" data-nc-discount action="/discount" method="get">
          <label class="nc-visually-hidden" for="nc-drawer-code">{{ 'cart.discount_code' | t }}</label>
          <input id="nc-drawer-code" type="text" name="code" placeholder="{{ 'cart.discount_code' | t }}" autocomplete="off" autocapitalize="characters">
          <button type="submit">{{ 'cart.apply' | t }}</button>
        </form>
        <p class="nc-drawer__code-note" data-nc-discount-note hidden>{{ 'cart.discount_applied' | t }}</p>
      </div>

      <div class="nc-drawer__foot">
        {%- if cart.total_discount > 0 -%}
          <div class="nc-drawer__savings">
            <span>{{ 'cart.you_save_total' | t }}</span>
            <span>−{{ cart.total_discount | money }}</span>
          </div>
        {%- endif -%}
        <div class="nc-drawer__totals">
          <span>{{ 'cart.subtotal' | t }}</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        <a class="nc-drawer__checkout" href="{{ routes.cart_url }}/checkout">{{ 'cart.checkout' | t }} →</a>
        <p class="nc-drawer__note">{{ 'cart.vat_note' | t }}</p>
      </div>
    {%- else -%}
      <div class="nc-drawer__empty">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <p>{{ 'cart.empty' | t }}</p>
        <a href="/collections/cbd-hudpleje" data-nc-cart-close>{{ 'cart.shop' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kurv-skuffe",
  "settings": []
}
{% endschema %}
