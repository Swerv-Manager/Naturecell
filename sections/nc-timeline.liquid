{% comment %}
  Tidslinje 1:1 fra om os-designet: centreret kolonne med lodret rygrad
  og prikker, lille billedthumb, aarstal, titel, tekst og "Laes mere"-link
  pr. milepael (nyeste foerst), afsluttet med en CTA-knap.
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} .nc-tl { background: var(--paper); padding: clamp(44px, 6vw, 84px) 0; }
  #shopify-section-{{ section.id }} .nc-tl__head { text-align: center; max-width: 64ch; margin: 0 auto clamp(30px, 4vw, 52px); }
  #shopify-section-{{ section.id }} .nc-tl__head h2 { margin: 0; font-size: clamp(26px, 3.2vw, 40px); }

  #shopify-section-{{ section.id }} .nc-tl__list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; }
  #shopify-section-{{ section.id }} .nc-tl__item { position: relative; display: grid; grid-template-columns: 30px 176px 1fr; gap: 0 clamp(16px, 2.4vw, 28px); padding-bottom: clamp(28px, 3.6vw, 44px); }
  @media (max-width: 640px) { #shopify-section-{{ section.id }} .nc-tl__item { grid-template-columns: 26px 1fr; } }
  #shopify-section-{{ section.id }} .nc-tl__spine { position: relative; }
  #shopify-section-{{ section.id }} .nc-tl__spine::before { content: ""; position: absolute; left: 6px; top: 22px; bottom: -6px; width: 2px; background: var(--sage-200); }
  #shopify-section-{{ section.id }} .nc-tl__item:last-child .nc-tl__spine::before { display: none; }
  #shopify-section-{{ section.id }} .nc-tl__dot { position: absolute; left: 0; top: 4px; width: 14px; height: 14px; border-radius: 50%; border: 3px solid var(--sage-500); background: var(--paper); }
  #shopify-section-{{ section.id }} .nc-tl__media { border-radius: var(--radius-md); overflow: hidden; background: var(--sage-100); aspect-ratio: 4 / 3; align-self: start; }
  #shopify-section-{{ section.id }} .nc-tl__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} .nc-tl__media { grid-column: 2; margin-bottom: 12px; max-width: 240px; }
  }
  #shopify-section-{{ section.id }} .nc-tl__year { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(22px, 2.4vw, 28px); color: var(--ink-900); line-height: 1.1; }
  #shopify-section-{{ section.id }} .nc-tl__body h3 { margin: 6px 0 6px; font-size: clamp(18px, 1.9vw, 22px); }
  #shopify-section-{{ section.id }} .nc-tl__body p { margin: 0 0 10px; font-size: 15px; line-height: 1.65; color: var(--ink-700); }
  #shopify-section-{{ section.id }} .nc-tl__link { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: var(--ink-900); text-decoration: none; }
  #shopify-section-{{ section.id }} .nc-tl__link:hover { color: var(--sage-700); text-decoration: underline; text-underline-offset: 3px; }

  #shopify-section-{{ section.id }} .nc-tl__cta { text-align: center; margin-top: clamp(10px, 2vw, 22px); }
{%- endstyle -%}

<section class="nc-tl">
  <div class="nc-container">
    {%- if section.settings.heading != blank -%}
      <div class="nc-tl__head">
        <p class="nc-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="nc-tl__list">
      {%- for block in section.blocks -%}
        <div class="nc-tl__item" {{ block.shopify_attributes }}>
          <div class="nc-tl__spine"><span class="nc-tl__dot" aria-hidden="true"></span></div>
          <div class="nc-tl__media">
            {%- assign tl_alt = block.settings.title | escape -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 420 | image_tag: alt: tl_alt, loading: 'lazy', sizes: '176px' }}
            {%- elsif block.settings.image_url contains '//' -%}
              <img src="{{ block.settings.image_url }}" alt="{{ tl_alt }}" loading="lazy" width="420" height="315">
            {%- elsif block.settings.image_url != blank -%}
              <img src="{{ block.settings.image_url | asset_url }}" alt="{{ tl_alt }}" loading="lazy" width="420" height="315">
            {%- endif -%}
          </div>
          <div class="nc-tl__body">
            <p class="nc-tl__year">{{ block.settings.year }}</p>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
            {%- if block.settings.url != blank -%}
              <a class="nc-tl__link" href="{{ block.settings.url }}">
                Læs mere
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div class="nc-tl__cta">
        <a class="nc-btn nc-btn--sage" href="{{ section.settings.cta_url | default: '/collections/cbd-hudpleje' }}">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Tidslinje",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Vores rejse" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Fra idé til Danmarks førende CBD-hudpleje" },
    { "type": "text", "id": "cta_text", "label": "CTA-knap, tekst", "default": "Shop NatureCell →" },
    { "type": "url", "id": "cta_url", "label": "CTA-knap, link" }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milepæl",
      "settings": [
        { "type": "text", "id": "year", "label": "Årstal", "default": "2018" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Idéen fødes" },
        { "type": "textarea", "id": "text", "label": "Tekst", "default": "På Møllerup Gods tager en ambition om ærlig, plantebaseret CBD-hudpleje form." },
        { "type": "url", "id": "url", "label": "Læs mere-link" },
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "text", "id": "image_url", "label": "Billede-URL/asset (fallback)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tidslinje",
      "settings": { "eyebrow": "Vores rejse", "heading": "Fra idé til Danmarks førende CBD-hudpleje", "cta_text": "Shop NatureCell →" },
      "blocks": [
        { "type": "milestone", "settings": { "year": "2026", "title": "Et komplet univers", "text": "Et fuldt sortiment til ansigt, krop, hænder, fødder og hår — stadig dansk, stadig ærligt.", "image_url": "https://naturecell.dk/cdn/shop/files/Naturecell_CBD_skincare_pige_vasker_ansigt_kopier.webp?v=1757146053" } },
        { "type": "milestone", "settings": { "year": "2021", "title": "Løvens Hule", "text": "Jesper Buch investerer, og NatureCell når ud til flere danske hjem.", "url": "/blogs/artikler/vores-oplevelse-i-lovens-hule", "image_url": "nc-lovens-hule.webp" } },
        { "type": "milestone", "settings": { "year": "2019", "title": "Først godkendt i DK", "text": "NatureCell bliver den første CBD-hudplejeserie godkendt til salg i Danmark.", "image_url": "https://naturecell.dk/cdn/shop/files/NatureCell_Sortiment_Hudpleje_0725.webp?v=1752671972" } },
        { "type": "milestone", "settings": { "year": "2018", "title": "Idéen fødes", "text": "På Møllerup Gods tager en ambition om ærlig, plantebaseret CBD-hudpleje form.", "image_url": "nc-founders.webp" } }
      ]
    }
  ]
}
{% endschema %}
