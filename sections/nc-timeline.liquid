{% comment %}
  Tidslinje fra designet (om os): aarstal, titel, tekst og billede
  pr. milepael. 2018 Moellerup, 2019 foerst godkendt, 2021 Loevens Hule,
  2026 komplet univers.
{% endcomment %}

{%- style -%}
  .nc-timeline { display: flex; flex-direction: column; gap: clamp(26px, 3.4vw, 44px); }
  .nc-timeline__item { display: grid; gap: clamp(18px, 3vw, 40px); grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 800px) {
    .nc-timeline__item { grid-template-columns: 110px 1fr 1fr; }
  }
  .nc-timeline__year { font-family: var(--font-display); font-size: clamp(26px, 3vw, 38px); color: var(--sage-500); }
  .nc-timeline__media { border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 16 / 10; background: var(--sage-100); }
  .nc-timeline__media img { width: 100%; height: 100%; object-fit: cover; }
  .nc-timeline__body h3 { font-size: clamp(20px, 2.2vw, 26px); margin-bottom: 6px; }
  .nc-timeline__body p { margin: 0 0 10px; color: var(--ink-700); }
{%- endstyle -%}

<section class="nc-section">
  <div class="nc-container">
    {%- if section.settings.heading != blank -%}
      <div class="nc-section-head" style="margin-bottom: clamp(24px, 3vw, 40px);">
        <p class="nc-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="nc-timeline">
      {%- for block in section.blocks -%}
        <div class="nc-timeline__item" {{ block.shopify_attributes }}>
          <div class="nc-timeline__year">{{ block.settings.year }}</div>
          <div class="nc-timeline__body">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
            {%- if block.settings.url != blank -%}
              <a href="{{ block.settings.url }}">Læs mere →</a>
            {%- endif -%}
          </div>
          <div class="nc-timeline__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: alt: block.settings.title, loading: 'lazy' }}
            {%- elsif block.settings.image_url != blank -%}
              {%- if block.settings.image_url contains '//' -%}
                <img src="{{ block.settings.image_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="900" height="563">
              {%- else -%}
                <img src="{{ block.settings.image_url | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="900" height="563">
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tidslinje",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Rejsen indtil nu" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Fra Møllerup Gods til hele Danmark" }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milepæl",
      "settings": [
        { "type": "text", "id": "year", "label": "Årstal", "default": "2018" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Idéen fødes" },
        { "type": "textarea", "id": "text", "label": "Tekst", "default": "På Møllerup Gods tager en ambition om ærlig, plantebaseret CBD-hudpleje form." },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "text", "id": "image_url", "label": "Billede-URL/asset (fallback)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tidslinje",
      "blocks": [
        { "type": "milestone", "settings": { "year": "2018", "title": "Idéen fødes", "text": "På Møllerup Gods tager en ambition om ærlig, plantebaseret CBD-hudpleje form. Sammen med specialister i kosmetisk kemi begynder arbejdet med hudpleje baseret på dokumentation og åbenhed.", "image_url": "nc-founders.webp" } },
        { "type": "milestone", "settings": { "year": "2019", "title": "Først godkendt i Danmark", "text": "NatureCell bliver den første CBD-hudplejeserie godkendt til salg i Danmark, og samme år kommer serien i Matas.", "image_url": "https://naturecell.dk/cdn/shop/files/NatureCell_Sortiment_Hudpleje_0725.webp?v=1752671972" } },
        { "type": "milestone", "settings": { "year": "2021", "title": "Løvens Hule", "text": "Jesper Buch træder ind som investor, og NatureCell når ud til flere danske hjem. Vi er stadig en familiedrevet virksomhed med rødder på Møllerup Gods.", "url": "/blogs/artikler/vores-oplevelse-i-lovens-hule", "image_url": "nc-lovens-hule.webp" } },
        { "type": "milestone", "settings": { "year": "2026", "title": "Et komplet univers", "text": "I dag dækker NatureCell hele kroppen: ansigt, krop, hænder, fødder og hår, plus ALFALAB, vores serie udviklet til mænd. Fundamentet er det samme som i 2018.", "image_url": "https://naturecell.dk/cdn/shop/files/Naturecell_CBD_skincare_pige_vasker_ansigt_kopier.webp?v=1757146053" } }
      ]
    }
  ]
}
{% endschema %}
