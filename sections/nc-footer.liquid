{% comment %}
  Footer, oversat fra NatureCell.dc.html (lysere groen #80A097, hvid tekst,
  4 linkkolonner + nyhedsbrev med 10%-krog, bundlinje med compliance).
{% endcomment %}

{%- style -%}
  .nc-footer { background: var(--nc-footer-bg); color: rgba(255, 255, 255, 0.88); margin-top: var(--section-y); }
  /* Sider hvor designets sidste sektion gaar direkte over i footeren (fx Om CBD-notestrimlen, B2B):
     saet klassen nc-flush-footer paa sektionens rodelement, saa footerens egen top-margin bortfalder. */
  body:has(.nc-flush-footer) .nc-footer { margin-top: 0; }
  .nc-footer a { color: var(--cloud); text-decoration: none; }
  .nc-footer a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Designets grid: 5 lige kolonner, gap 40px, padding 64/40 ved 1440 */
  .nc-footer__grid {
    display: grid;
    gap: clamp(26px, 4vw, 40px);
    grid-template-columns: repeat(5, minmax(0, 1fr));
    padding: clamp(38px, 5vw, 64px) 0 clamp(24px, 6vw, 40px);
  }

  @media (max-width: 989px) {
    .nc-footer__grid { grid-template-columns: repeat(2, 1fr); }
    .nc-footer__brand { grid-column: 1 / -1; }
  }

  .nc-footer__brand { display: flex; flex-direction: column; gap: 16px; max-width: 300px; }
  .nc-footer__logo img { display: block; width: auto; height: 42px; }
  .nc-footer__brand p { margin: 0; font-size: 14px; line-height: 1.7; }
  .nc-footer__brand-lines { display: flex; flex-direction: column; gap: 3px; font-size: 13.5px; line-height: 1.65; }
  .nc-footer__brand strong { color: var(--cloud); font-weight: 600; }

  .nc-footer__heading {
    margin: 0 0 15px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: var(--leading-relaxed);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--cloud);
  }

  .nc-footer ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 11px; font-size: 14px; line-height: normal; }

  .nc-footer__news .nc-footer__heading { margin-bottom: 12px; }
  .nc-footer__news p { margin: 0 0 12px; font-size: 14px; line-height: 1.6; }
  .nc-footer__form { display: flex; gap: 8px; }
  .nc-footer__form .nc-input {
    flex: 1;
    font-size: 14px;
    line-height: normal;
    padding: 11px 16px;
    border-radius: var(--radius-pill); /* designets felt er en pille (999px) */
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(246, 244, 238, 0.4);
    color: var(--cloud);
    min-width: 0;
  }
  /* Designet styler ikke ::placeholder, browserens standardgraa (#757575) er det godkendte udtryk. */
  .nc-footer__form .nc-iconbtn { flex: none; width: auto; height: auto; padding: 11px 18px; border: 0; border-radius: var(--radius-pill); background: var(--sage-700); color: #fff; font-family: var(--font-body); font-weight: 600; font-size: 14px; line-height: normal; }
  .nc-footer__form .nc-iconbtn:hover { background: var(--sage-600); }

  /* Bundlinje: fuldbreddeskillelinje som i designet, tekst i container */
  .nc-footer__bottom-wrap { border-top: 1px solid rgba(246, 244, 238, 0.4); }
  .nc-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.88);
  }
  .nc-footer__bottom p { margin: 0; max-width: 560px; }

  .nc-footer__payments { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding-bottom: 4px; }
  .nc-footer__payments svg { height: 22px; width: auto; }
{%- endstyle -%}

<footer class="nc-footer nc-on-dark">
  <div class="nc-container">
    <div class="nc-footer__grid">
      <div class="nc-footer__brand">
        <div class="nc-footer__logo">
          {%- if settings.logo_white != blank -%}
            {{ settings.logo_white | image_url: width: 460 | image_tag: alt: shop.name, widths: '230, 460', loading: 'lazy' }}
          {%- else -%}
            <img src="{{ 'nc-logo-wordmark-white.png' | asset_url }}" alt="{{ shop.name | escape }}" loading="lazy" width="230" height="56">
          {%- endif -%}
        </div>
        <p>{{ section.settings.brand_text }}</p>
        <div class="nc-footer__brand-lines">
          <strong>{{ section.settings.legal_name }}</strong>
          {%- assign addr_rows = section.settings.address | newline_to_br | split: '<br />' -%}
          {%- for row in addr_rows -%}
            {%- assign row_s = row | strip -%}
            {%- if row_s != blank -%}<span>{{ row_s }}</span>{%- endif -%}
          {%- endfor -%}
        </div>
        <div class="nc-footer__brand-lines">
          <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <nav aria-label="{{ block.settings.heading }}" {{ block.shopify_attributes }}>
            <h2 class="nc-footer__heading">{{ block.settings.heading }}</h2>
            <ul>
              {%- if block.settings.menu != blank -%}
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              {%- else -%}
                {%- assign rows = block.settings.links_text | newline_to_br | split: '<br />' -%}
                {%- for row in rows -%}
                  {%- assign parts = row | strip | split: '|' -%}
                  {%- if parts[0] != blank and parts[1] != blank -%}
                    <li><a href="{{ parts[1] | strip }}">{{ parts[0] | strip }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
            {%- if block.settings.heading_2 != blank -%}
              <h2 class="nc-footer__heading" style="margin-top: 24px;">{{ block.settings.heading_2 }}</h2>
              <ul>
                {%- if block.settings.menu_2 != blank -%}
                  {%- for link in block.settings.menu_2.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                {%- else -%}
                  {%- assign rows2 = block.settings.links_text_2 | newline_to_br | split: '<br />' -%}
                  {%- for row in rows2 -%}
                    {%- assign parts2 = row | strip | split: '|' -%}
                    {%- if parts2[0] != blank and parts2[1] != blank -%}
                      <li><a href="{{ parts2[1] | strip }}">{{ parts2[0] | strip }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endfor -%}

      <div class="nc-footer__news">
        <h2 class="nc-footer__heading">{{ section.settings.newsletter_heading }}</h2>
        <p>{{ section.settings.newsletter_text }}</p>
        {%- form 'customer' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="nc-footer__form">
            <label class="nc-visually-hidden" for="nc-news-email">E-mail</label>
            <input
              id="nc-news-email"
              class="nc-input"
              type="email"
              name="contact[email]"
              placeholder="din@email.dk"
              autocomplete="email"
              required
            >
            <button class="nc-iconbtn" type="submit" aria-label="Tilmeld nyhedsbrev">→</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p role="status" style="margin-top: 8px;">Tak for din tilmelding.</p>
          {%- elsif form.errors -%}
            <p role="alert" style="margin-top: 8px;">Tjek din e-mailadresse og prøv igen.</p>
          {%- endif -%}
        {%- endform -%}
        {%- unless section.settings.hide_payment_icons -%}
          <div class="nc-footer__payments" aria-label="Betalingsmetoder" style="margin-top: 18px;">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag }}
            {%- endfor -%}
          </div>
        {%- endunless -%}
      </div>
    </div>
  </div>

  <div class="nc-footer__bottom-wrap">
    <div class="nc-container">
      <div class="nc-footer__bottom">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.legal_name }} · CVR {{ section.settings.cvr }} · e-mærket · GMP- & ISO-certificeret</span>
        <p>{{ section.settings.compliance_text }}</p>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "nc-footer-section",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Om brandet",
      "default": "Plantebaseret CBD-hudpleje, udviklet og testet i Danmark. Danmarks første godkendte CBD-hudplejeserie."
    },
    { "type": "text", "id": "legal_name", "label": "Juridisk navn", "default": "NatureCell Denmark ApS" },
    { "type": "textarea", "id": "address", "label": "Adresse", "default": "Lille Nyhavn 10, 2. tv.\n8660 Skanderborg, Danmark\nCVR: 42256013" },
    { "type": "text", "id": "email", "label": "E-mail", "default": "hello@naturecell.dk" },
    { "type": "text", "id": "phone", "label": "Telefon", "default": "+45 40 55 00 42" },
    { "type": "text", "id": "cvr", "label": "CVR", "default": "42256013" },
    { "type": "header", "content": "Nyhedsbrev" },
    { "type": "text", "id": "newsletter_heading", "label": "Overskrift", "default": "Nyhedsbrev" },
    { "type": "textarea", "id": "newsletter_text", "label": "Tekst", "default": "Få 10% på din første ordre." },
    { "type": "header", "content": "Bund" },
    {
      "type": "textarea",
      "id": "compliance_text",
      "label": "Compliance-linje",
      "default": "NatureCells hudplejeprodukter er kosmetiske. De er ikke beregnet til at diagnosticere, behandle eller kurere sygdom.",
      "info": "Compliance-krav. Må ikke fjernes."
    },
    { "type": "checkbox", "id": "hide_payment_icons", "label": "Skjul betalingsikoner", "default": false }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Linkkolonne",
      "settings": [
        { "type": "text", "id": "heading", "label": "Overskrift", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "textarea", "id": "links_text", "label": "Links (fallback)", "info": "Ét link pr. linje: Tekst | /url. Bruges når ingen menu er valgt." },
        { "type": "text", "id": "heading_2", "label": "Overskrift 2 (valgfri)" },
        { "type": "link_list", "id": "menu_2", "label": "Menu 2 (valgfri)" },
        { "type": "textarea", "id": "links_text_2", "label": "Links 2 (fallback)", "info": "Ét link pr. linje: Tekst | /url." }
      ]
    }
  ]
}
{% endschema %}
