{% comment %}
  Sidehero til Om CBD 1:1 fra designet (template.html:2132-2140):
  sage-500-baand med baggrundsfoto (22 %) under en sage-700-gradient,
  820px-kolonne med 104px lodret padding, eyebrow, H1 og intro.
  nc-page-hero's billedvariant kan ikke naa disse maal via indstillinger.
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} .nc-cbdhero { position: relative; background: var(--sage-500); color: var(--paper); overflow: hidden; }
  #shopify-section-{{ section.id }} .nc-cbdhero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.22; }
  #shopify-section-{{ section.id }} .nc-cbdhero__wash { position: absolute; inset: 0; background: linear-gradient(90deg, var(--sage-700), rgba(40, 64, 59, 0.55)); }
  {%- comment -%} Designets kolonne: max-width 820 inkl. 24px sidepadding, padding 104px lodret, flex-kolonne gap 18. {%- endcomment -%}
  #shopify-section-{{ section.id }} .nc-cbdhero__inner { position: relative; max-width: 820px; margin: 0 auto; padding: 104px 24px; display: flex; flex-direction: column; gap: 18px; }
  #shopify-section-{{ section.id }} .nc-cbdhero__inner .nc-eyebrow { margin: 0; line-height: var(--leading-relaxed); font-size: 12px; letter-spacing: 0.14em; color: var(--sage-200); }
  #shopify-section-{{ section.id }} .nc-cbdhero__inner h1 { margin: 0; font-size: clamp(40px, 5.5vw, 64px); line-height: 1.03; letter-spacing: -0.01em; color: var(--paper); }
  #shopify-section-{{ section.id }} .nc-cbdhero__inner p { margin: 0; font-size: 19px; line-height: 1.7; color: rgba(246, 244, 238, 0.88); max-width: 620px; }
{%- endstyle -%}

<section class="nc-cbdhero nc-on-dark">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2200 | image_tag: alt: '', loading: 'eager', class: 'nc-cbdhero__bg', sizes: '100vw' }}
  {%- elsif section.settings.image_url contains '//' -%}
    <img class="nc-cbdhero__bg" src="{{ section.settings.image_url }}" alt="" loading="eager" width="2200" height="800">
  {%- elsif section.settings.image_url != blank -%}
    <img class="nc-cbdhero__bg" src="{{ section.settings.image_url | asset_url }}" alt="" loading="eager" width="2200" height="800">
  {%- endif -%}
  <div class="nc-cbdhero__wash" aria-hidden="true"></div>
  <div class="nc-cbdhero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="nc-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1>{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.intro != blank -%}
      <p>{{ section.settings.intro }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "NC Om CBD-hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Kom godt i gang med CBD" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Hvad er CBD?" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Alt du behøver at vide om cannabidiol — hvad det er, hvorfor vi bruger det i hudpleje, og hvad der gør NatureCells CBD særlig." },
    { "type": "image_picker", "id": "image", "label": "Baggrundsbillede" },
    { "type": "text", "id": "image_url", "label": "Billede-URL/asset (fallback)", "default": "https://naturecell.dk/cdn/shop/files/NatureCell_Sortiment_Hudpleje_0725.webp?v=1752671972" }
  ],
  "presets": [ { "name": "NC Om CBD-hero" } ]
}
{% endschema %}
