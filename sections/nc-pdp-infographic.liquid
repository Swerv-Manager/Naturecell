{% comment %}
  Produktside: sprogafhaengige infografikker (fx Amazon-billeder med tekst om
  indholdsstoffer). Billederne ligger i produktets metafelter, saa de kan
  oversaettes pr. sprog i Translate & Adapt:
    ncell.infographics  (liste af filer)  eller  ncell.infographic (en fil)
  Shopify leverer automatisk den oversatte fil for det aktive sprog (dansk,
  tysk, engelsk). Sektionen viser intet, naar produktet ingen infografik har.
{% endcomment %}

{%- liquid
  assign files = product.metafields.ncell.infographics.value
  assign single = product.metafields.ncell.infographic.value
  assign count = 0
  if files != blank
    assign count = files.size
  elsif single != blank
    assign count = 1
  endif
-%}

{%- if count > 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .nc-info { border-top: 1px solid var(--border-soft); background: var(--paper); }
    #shopify-section-{{ section.id }} .nc-info__inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: clamp(28px, 5vw, 56px) var(--gutter); display: flex; flex-direction: column; gap: 18px; }
    #shopify-section-{{ section.id }} .nc-info__head { display: flex; flex-direction: column; gap: 8px; align-items: center; text-align: center; }
    #shopify-section-{{ section.id }} .nc-info__eyebrow { margin: 0; font-family: var(--font-body); font-weight: 600; font-size: 12px; line-height: 1.7; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sage-600); }
    #shopify-section-{{ section.id }} .nc-info__head h2 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(22px, 3.3vw, 34px); line-height: 1.1; letter-spacing: normal; color: var(--sage-700); text-wrap: wrap; }
    #shopify-section-{{ section.id }} .nc-info__list { display: grid; gap: {{ section.settings.gap }}px; grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .nc-info__list--2 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
    #shopify-section-{{ section.id }} .nc-info__item { margin: 0; border-radius: var(--radius-xl); overflow: hidden; background: var(--sage-50); }
    #shopify-section-{{ section.id }} .nc-info__item img { display: block; width: 100%; height: auto; }
  {%- endstyle -%}

  <section class="nc-info">
    <div class="nc-info__inner">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="nc-info__head">
          {%- if section.settings.eyebrow != blank -%}<p class="nc-info__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        </div>
      {%- endif -%}
      <div class="nc-info__list{% if section.settings.columns == '2' %} nc-info__list--2{% endif %}">
        {%- if files != blank -%}
          {%- for f in files -%}
            {%- if f.preview_image != blank or f.src != blank -%}
              <figure class="nc-info__item">
                {{ f | image_url: width: 1600 | image_tag: alt: f.alt, loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 1100px) 1000px, 94vw' }}
              </figure>
            {%- endif -%}
          {%- endfor -%}
        {%- elsif single != blank -%}
          <figure class="nc-info__item">
            {{ single | image_url: width: 1600 | image_tag: alt: single.alt, loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 1100px) 1000px, 94vw' }}
          </figure>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Produkt: infografik",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Viser produktets infografikker fra metafelterne ncell.infographics (liste) eller ncell.infographic (én fil). Oversæt billederne pr. sprog i Translate & Adapt, så tyske og engelske kunder ser deres egen version." },
    { "type": "text", "id": "eyebrow", "label": "Overlinje" },
    { "type": "text", "id": "heading", "label": "Overskrift" },
    {
      "type": "select",
      "id": "columns",
      "label": "Kolonner",
      "options": [
        { "value": "1", "label": "Én (fuld bredde)" },
        { "value": "2", "label": "To ved siden af hinanden" }
      ],
      "default": "1"
    },
    { "type": "range", "id": "max_width", "label": "Maks. bredde", "min": 700, "max": 1400, "step": 50, "unit": "px", "default": 1000 },
    { "type": "range", "id": "gap", "label": "Afstand mellem billeder", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 }
  ],
  "presets": [ { "name": "Produkt: infografik" } ]
}
{% endschema %}
