{% comment %}
  Bland selv (mix & match): kunden saetter sin egen pakke sammen af enkeltprodukter, og rabatten
  stiger med antallet (trin som blokke, fx 2 = 10 %, 3 = 15 %, 4+ = 20 %).
  Produkter: listen i sektionen, ellers kollektionens produkter. Pakker, gavekort, udsolgte varer og
  handles under "Spring over" vises aldrig.
  Selve rabatten er en automatisk rabat i Shopify (Rabatter), en pr. trin, paa de samme produkter.
  Sektionen viser kun prisen; den trykker ikke rabatten igennem. Trin og rabatter skal derfor matche.
  JS: assets/nc-mix-match.js. Valget gemmes i sessionStorage, til kunden lukker fanen.
{% endcomment %}

{%- liquid
  assign mm_tiers = section.blocks | where: 'type', 'tier'
  assign mm_first = mm_tiers | first
  assign mm_last = mm_tiers | last
  assign mm_first_qty = mm_first.settings.qty | default: 2
  assign mm_first_pct = mm_first.settings.pct | default: 10
  assign mm_max_qty = mm_last.settings.qty | default: mm_first_qty

  if section.settings.products != blank
    assign mm_src = section.settings.products
  else
    assign mm_src = collection.products
  endif

  assign mm_skip = ','
  assign mm_skip_list = section.settings.skip_handles | downcase | split: ','
  for s in mm_skip_list
    assign s_clean = s | strip
    assign mm_skip = mm_skip | append: s_clean | append: ','
  endfor

  capture mm_fs
    render 'nc-free-shipping'
  endcapture
  assign mm_fs = mm_fs | strip

  assign mm_keep = 100 | minus: mm_first_pct
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .nc-mm { padding: clamp(28px, 5vw, 56px) 0 clamp(48px, 7vw, 88px); background: var(--paper); }
  #shopify-section-{{ section.id }} .nc-mm__layout { display: grid; gap: clamp(24px, 4vw, 48px); grid-template-columns: minmax(0, 1fr); align-items: start; }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .nc-mm__layout { grid-template-columns: minmax(0, 1fr) 380px; }
    #shopify-section-{{ section.id }} .nc-mm__aside { position: sticky; top: 104px; }
  }
  #shopify-section-{{ section.id }} .nc-mm__main { display: flex; flex-direction: column; gap: clamp(26px, 4vw, 40px); min-width: 0; }
  #shopify-section-{{ section.id }} .nc-mm__intro { display: grid; gap: 22px; grid-template-columns: minmax(0, 1fr); align-items: start; }
  @media (min-width: 760px) {
    #shopify-section-{{ section.id }} .nc-mm__intro { grid-template-columns: minmax(0, 1fr) 240px; }
  }
  #shopify-section-{{ section.id }} .nc-mm__head { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  #shopify-section-{{ section.id }} .nc-mm__head .nc-eyebrow { margin: 0; }
  #shopify-section-{{ section.id }} .nc-mm__head h1 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(31px, 4.6vw, 50px); line-height: 1.08; color: var(--sage-700); text-wrap: balance; }
  #shopify-section-{{ section.id }} .nc-mm__head > p { margin: 0; max-width: 60ch; font-size: 17px; line-height: 1.7; color: var(--ink-700); }
  #shopify-section-{{ section.id }} .nc-mm__quote { margin: 0; display: flex; gap: 14px; align-items: center; background: var(--cloud); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); padding: 16px 18px; }
  #shopify-section-{{ section.id }} .nc-mm__quote img { width: 56px; height: 56px; border-radius: 999px; object-fit: cover; object-position: 50% 25%; flex: none; }
  #shopify-section-{{ section.id }} .nc-mm__quote blockquote { margin: 0; font-family: var(--font-display); font-style: italic; font-size: 16px; line-height: 1.45; color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-mm__quote figcaption { margin-top: 6px; font-size: 13px; font-weight: 600; color: var(--ink-500); }
  #shopify-section-{{ section.id }} .nc-mm__tiers { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  #shopify-section-{{ section.id }} .nc-mm__tier { display: inline-flex; align-items: center; gap: 10px; padding: 12px 18px; border-radius: var(--radius-md); background: var(--sage-50); color: var(--sage-700); font-weight: 700; font-size: 16px; font-variant-numeric: tabular-nums; transition: background-color var(--dur-fast) var(--ease-soft), color var(--dur-fast) var(--ease-soft); }
  #shopify-section-{{ section.id }} .nc-mm__tier i { width: 18px; height: 18px; border-radius: 999px; border: 1.5px solid currentColor; opacity: .55; flex: none; display: inline-flex; align-items: center; justify-content: center; }
  #shopify-section-{{ section.id }} .nc-mm__tier.is-reached i { opacity: 1; background: currentColor; }
  #shopify-section-{{ section.id }} .nc-mm__tier.is-reached i::after { content: ""; width: 8px; height: 4px; border: 2px solid var(--cloud); border-top: 0; border-right: 0; transform: rotate(-45deg) translate(1px, -1px); }
  #shopify-section-{{ section.id }} .nc-mm__tier.is-active { background: var(--sage-700); color: var(--cloud); }
  #shopify-section-{{ section.id }} .nc-mm__tier.is-active.is-reached i::after { border-color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-mm__small { margin: 0; font-size: 13.5px; line-height: 1.6; color: var(--ink-500); }
  #shopify-section-{{ section.id }} .nc-mm__trust { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 0; padding: 0; list-style: none; font-size: 13.5px; color: var(--ink-700); }
  #shopify-section-{{ section.id }} .nc-mm__trust strong { color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-mm__steps { list-style: none; margin: 0; padding: 20px 22px; display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); background: var(--cloud); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); counter-reset: mmstep; }
  #shopify-section-{{ section.id }} .nc-mm__steps li { counter-increment: mmstep; display: grid; grid-template-columns: 28px 1fr; gap: 12px; font-size: 15px; line-height: 1.55; color: var(--ink-700); }
  #shopify-section-{{ section.id }} .nc-mm__steps li::before { content: counter(mmstep); width: 28px; height: 28px; border-radius: 999px; background: var(--sage-50); color: var(--sage-700); font-weight: 700; font-size: 13px; display: inline-flex; align-items: center; justify-content: center; }
  #shopify-section-{{ section.id }} .nc-mm__steps strong { color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-mm__gridhead { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; }
  #shopify-section-{{ section.id }} .nc-mm__gridhead h2 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(24px, 3vw, 32px); color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-mm__sort { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; color: var(--ink-700); }
  #shopify-section-{{ section.id }} .nc-mm__sort select { font: inherit; padding: 9px 34px 9px 14px; border: 1px solid var(--border-default, var(--ink-200)); border-radius: var(--radius-pill); background: var(--cloud); color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-mm__chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; border: 0; }
  #shopify-section-{{ section.id }} .nc-mm__chips button { font: inherit; font-size: 14px; font-weight: 600; padding: 8px 16px; border-radius: var(--radius-pill); border: 1px solid var(--border-default, var(--ink-200)); background: var(--cloud); color: var(--sage-700); cursor: pointer; }
  #shopify-section-{{ section.id }} .nc-mm__chips button[aria-pressed="true"] { background: var(--sage-700); border-color: var(--sage-700); color: var(--cloud); }
  #shopify-section-{{ section.id }} .nc-mm__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); }
  @media (max-width: 599px) {
    #shopify-section-{{ section.id }} .nc-mm__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    #shopify-section-{{ section.id }} .nc-mm__info { padding: 10px 10px 12px; gap: 5px; }
    #shopify-section-{{ section.id }} .nc-mm__title { font-size: 15.5px; }
    #shopify-section-{{ section.id }} .nc-mm__price strong { font-size: 16px; }
    #shopify-section-{{ section.id }} .nc-mm__add { min-height: 40px; font-size: 14px; }
    #shopify-section-{{ section.id }} .nc-mm__stepper { grid-template-columns: 36px 1fr 36px; min-height: 40px; }
    #shopify-section-{{ section.id }} .nc-mm__rating .nc-stars { display: none; }
  }
  #shopify-section-{{ section.id }} .nc-mm__card { position: relative; display: flex; flex-direction: column; background: var(--cloud); border: 1.5px solid var(--border-soft); border-radius: var(--radius-lg); overflow: hidden; transition: border-color var(--dur-fast) var(--ease-soft); }
  #shopify-section-{{ section.id }} .nc-mm__card.is-in-pack { border-color: var(--sage-500); }
  #shopify-section-{{ section.id }} .nc-mm__badge { position: absolute; top: 12px; left: 12px; z-index: 1; padding: 4px 10px; border-radius: var(--radius-pill); background: var(--sage-700); color: var(--cloud); font-size: 12px; font-weight: 700; }
  #shopify-section-{{ section.id }} .nc-mm__media { display: block; aspect-ratio: 1; background: var(--nc-product-tint, var(--sage-50)); }
  #shopify-section-{{ section.id }} .nc-mm__media img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #shopify-section-{{ section.id }} .nc-mm__info { display: flex; flex-direction: column; gap: 6px; padding: 14px 14px 16px; flex: 1; }
  #shopify-section-{{ section.id }} .nc-mm__title { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 18px; line-height: 1.25; color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-mm__title a { color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .nc-mm__size { font-size: 13px; color: var(--ink-500); }
  #shopify-section-{{ section.id }} .nc-mm__rating { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--ink-500); }
  #shopify-section-{{ section.id }} .nc-mm__rating .nc-stars svg { width: 13px; height: 13px; }
  #shopify-section-{{ section.id }} .nc-mm__rating .nc-stars svg.is-empty { fill: none; stroke: var(--ink-300); stroke-width: 1.5; }
  #shopify-section-{{ section.id }} .nc-mm__price { margin: 4px 0 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; font-variant-numeric: tabular-nums; }
  #shopify-section-{{ section.id }} .nc-mm__price strong { font-size: 19px; color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-mm__price s { font-size: 13px; color: var(--ink-400); }
  #shopify-section-{{ section.id }} .nc-mm__price span { font-size: 13px; font-weight: 600; color: var(--sage-600); }
  #shopify-section-{{ section.id }} .nc-mm__add { margin-top: auto; min-height: 44px; border: 0; border-radius: var(--radius-pill); background: var(--sage-500); color: var(--cloud); font: inherit; font-weight: 600; font-size: 15px; cursor: pointer; transition: background-color var(--dur-fast) var(--ease-soft); }
  #shopify-section-{{ section.id }} .nc-mm__add:hover, #shopify-section-{{ section.id }} .nc-mm__add:focus-visible { background: var(--sage-600); }
  #shopify-section-{{ section.id }} .nc-mm__stepper { margin-top: auto; display: grid; grid-template-columns: 44px 1fr 44px; align-items: center; min-height: 44px; border: 1.5px solid var(--sage-700); border-radius: var(--radius-pill); overflow: hidden; }
  #shopify-section-{{ section.id }} .nc-mm__stepper--sm { margin: 0; grid-template-columns: 34px 30px 34px; min-height: 36px; border-width: 1px; border-color: var(--border-default, var(--ink-200)); }
  #shopify-section-{{ section.id }} .nc-mm__stepper button { height: 100%; min-height: 34px; border: 0; background: none; color: var(--sage-700); font-size: 20px; line-height: 1; cursor: pointer; }
  #shopify-section-{{ section.id }} .nc-mm__stepper output { text-align: center; font-weight: 700; color: var(--sage-700); font-variant-numeric: tabular-nums; }
  #shopify-section-{{ section.id }} .nc-mm__pack { background: var(--cloud); border: 1px solid var(--border-soft); border-radius: var(--radius-xl); box-shadow: var(--shadow-md); padding: 24px 22px; display: flex; flex-direction: column; gap: 16px; }
  #shopify-section-{{ section.id }} .nc-mm__pack h2 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 26px; color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-mm__progress { padding: 0 9px; }
  #shopify-section-{{ section.id }} .nc-mm__bar { position: relative; height: 6px; border-radius: 999px; background: var(--sage-50); }
  #shopify-section-{{ section.id }} .nc-mm__fill { position: absolute; inset: 0 auto 0 0; width: 0; border-radius: inherit; background: var(--sage-600); transition: width var(--dur-base, .3s) var(--ease-soft); }
  #shopify-section-{{ section.id }} .nc-mm__dot { position: absolute; top: 50%; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 999px; background: var(--cloud); border: 2px solid var(--sage-200); }
  #shopify-section-{{ section.id }} .nc-mm__dot.is-reached { background: var(--sage-600); border-color: var(--sage-600); }
  #shopify-section-{{ section.id }} .nc-mm__ticks { position: relative; height: 18px; margin-top: 8px; font-size: 11.5px; font-weight: 600; color: var(--ink-500); font-variant-numeric: tabular-nums; }
  #shopify-section-{{ section.id }} .nc-mm__ticks span { position: absolute; transform: translateX(-50%); white-space: nowrap; }
  #shopify-section-{{ section.id }} .nc-mm__ticks span:last-child { transform: translateX(-85%); }
  #shopify-section-{{ section.id }} .nc-mm__msg { margin: 0; padding: 12px 14px; border-radius: var(--radius-md); background: var(--sage-50); color: var(--sage-700); font-weight: 600; font-size: 14.5px; line-height: 1.45; text-align: center; }
  #shopify-section-{{ section.id }} .nc-mm__empty { margin: 0; padding: 18px 14px; border: 1px dashed var(--border-default, var(--ink-200)); border-radius: var(--radius-md); font-size: 14px; color: var(--ink-500); text-align: center; }
  #shopify-section-{{ section.id }} .nc-mm__list { list-style: none; margin: 0; padding: 0 4px 0 0; max-height: 292px; overflow-y: auto; display: flex; flex-direction: column; }
  #shopify-section-{{ section.id }} .nc-mm__item { display: grid; grid-template-columns: 52px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border-soft); }
  #shopify-section-{{ section.id }} .nc-mm__item img { width: 52px; height: 52px; object-fit: contain; border-radius: var(--radius-sm); background: var(--nc-product-tint, var(--sage-50)); }
  #shopify-section-{{ section.id }} .nc-mm__item-name { display: flex; flex-direction: column; gap: 2px; min-width: 0; font-size: 14px; }
  #shopify-section-{{ section.id }} .nc-mm__item-name strong { font-weight: 600; color: var(--sage-700); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #shopify-section-{{ section.id }} .nc-mm__item-name span { font-variant-numeric: tabular-nums; color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-mm__item-name s { margin-right: 6px; color: var(--ink-400); font-size: 12.5px; }
  #shopify-section-{{ section.id }} .nc-mm__item-name button { align-self: flex-start; padding: 0; border: 0; background: none; color: var(--ink-500); font: inherit; font-size: 12.5px; text-decoration: underline; cursor: pointer; }
  #shopify-section-{{ section.id }} .nc-mm__sum { margin: 0; display: flex; flex-direction: column; gap: 6px; font-variant-numeric: tabular-nums; }
  #shopify-section-{{ section.id }} .nc-mm__sum div { display: flex; justify-content: space-between; gap: 12px; font-size: 14.5px; color: var(--ink-700); }
  #shopify-section-{{ section.id }} .nc-mm__sum dt, #shopify-section-{{ section.id }} .nc-mm__sum dd { margin: 0; }
  #shopify-section-{{ section.id }} .nc-mm__sum .is-total { font-family: var(--font-display); font-size: 21px; color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-mm__sum .is-save { font-weight: 700; color: var(--sage-600); }
  #shopify-section-{{ section.id }} .nc-mm__cta { width: 100%; }
  #shopify-section-{{ section.id }} .nc-mm__cta.is-busy, #shopify-section-{{ section.id }} .nc-mm__mbar .is-busy { opacity: .7; cursor: progress; }
  #shopify-section-{{ section.id }} .nc-mm__cta[disabled] { background: var(--sage-50); border-color: var(--sage-50); color: var(--ink-400); cursor: not-allowed; transform: none; }
  #shopify-section-{{ section.id }} .nc-mm__error { margin: 0; padding: 10px 12px; border-radius: var(--radius-md); background: #F7E9EE; color: var(--sale); font-size: 14px; }
  #shopify-section-{{ section.id }} .nc-mm__mbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: var(--z-sticky, 30); display: flex; align-items: center; gap: 12px; padding: 12px var(--gutter) calc(12px + env(safe-area-inset-bottom, 0px)); background: var(--cloud); border-top: 1px solid var(--border-soft); box-shadow: 0 -6px 20px rgba(62, 93, 88, 0.09); }
  #shopify-section-{{ section.id }} .nc-mm__mbar-sum { display: flex; flex-direction: column; min-width: 0; font-size: 13px; color: var(--ink-700); font-variant-numeric: tabular-nums; }
  #shopify-section-{{ section.id }} .nc-mm__mbar-sum strong { font-size: 17px; color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-mm__mbar-sum a { color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-mm__mbar .nc-btn { margin-left: auto; min-height: 44px; padding: 12px 18px; font-size: 14px; }
  @media (min-width: 990px) { #shopify-section-{{ section.id }} .nc-mm__mbar { display: none; } }
  @media (max-width: 989px) { #shopify-section-{{ section.id }} .nc-mm.has-mbar { padding-bottom: 120px; } }
  #shopify-section-{{ section.id }} [hidden] { display: none !important; }
{%- endstyle -%}

<div class="nc-mm" data-nc-mm data-nc-mm-id="{{ section.id }}">
  <div class="nc-container nc-mm__layout">
    <div class="nc-mm__main">
      <div class="nc-mm__intro">
        <div class="nc-mm__head">
          {%- if section.settings.eyebrow != blank -%}<p class="nc-eyebrow">{% render 'nc-cbd', text: section.settings.eyebrow %}</p>{%- endif -%}
          {%- assign mm_h1 = section.settings.heading | default: collection.title | default: page.title -%}
          <h1>{% render 'nc-cbd', text: mm_h1 %}</h1>
          {%- if section.settings.intro != blank -%}<p>{% render 'nc-cbd', text: section.settings.intro %}</p>{%- endif -%}
        </div>
        {%- if section.settings.quote != blank -%}
          <figure class="nc-mm__quote">
            {%- if section.settings.quote_image != blank -%}
              {{ section.settings.quote_image | image_url: width: 120, height: 120, crop: 'top' | image_tag: alt: '', loading: 'lazy', width: 56, height: 56 }}
            {%- else -%}
              <img src="{{ 'nc-founders.webp' | asset_url }}" alt="" loading="lazy" width="56" height="56">
            {%- endif -%}
            <div>
              <blockquote>{% render 'nc-cbd', text: section.settings.quote %}</blockquote>
              {%- if section.settings.quote_author != blank -%}<figcaption>{{ section.settings.quote_author }}</figcaption>{%- endif -%}
            </div>
          </figure>
        {%- endif -%}
      </div>

      {%- if mm_tiers.size > 0 -%}
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <ul class="nc-mm__tiers" aria-label="{{ section.settings.tiers_label | escape }}">
            {%- for tier in mm_tiers -%}
              {%- capture mm_n -%}{{ tier.settings.qty }}{% if forloop.last and mm_tiers.size > 1 %}+{% endif %}{%- endcapture -%}
              <li class="nc-mm__tier" data-mm-tier="{{ tier.settings.qty }}" {{ tier.shopify_attributes }}><i aria-hidden="true"></i>{{ 'mix.tier' | t: n: mm_n, pct: tier.settings.pct }}</li>
            {%- endfor -%}
          </ul>
          {%- if section.settings.tiers_note != blank -%}<p class="nc-mm__small">{% render 'nc-cbd', text: section.settings.tiers_note %}</p>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_trust or section.settings.fine_print != blank -%}
        <div style="display: flex; flex-direction: column; gap: 8px;">
          {%- if section.settings.show_trust -%}
            <ul class="nc-mm__trust">
              {%- if settings.nc_tp_score != blank and settings.nc_tp_count != blank -%}<li>★ {{ 'general.tp_line_html' | t: score: settings.nc_tp_score, count: settings.nc_tp_count }}</li>{%- endif -%}
              {%- if mm_fs != blank -%}<li>{{ 'general.free_shipping' | t: amount: mm_fs }}</li>{%- endif -%}
              <li>{{ 'pdp.ticker.emaerket' | t }}</li>
              <li>{{ 'pdp.ticker.returns' | t }}</li>
            </ul>
          {%- endif -%}
          {%- if section.settings.fine_print != blank -%}<p class="nc-mm__small">{% render 'nc-cbd', text: section.settings.fine_print %}</p>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.step1 != blank or section.settings.step2 != blank or section.settings.step3 != blank -%}
        <ol class="nc-mm__steps">
          {%- if section.settings.step1 != blank -%}
            {%- assign mm_s1 = section.settings.step1 | replace: '[antal]', mm_first_qty -%}
            <li><span>{% render 'nc-cbd', text: mm_s1 %}</span></li>
          {%- endif -%}
          {%- if section.settings.step2 != blank -%}
            {%- capture mm_tiertext -%}
              {%- for tier in mm_tiers -%}{{ tier.settings.qty }}{% if forloop.last and mm_tiers.size > 1 %}+{% endif %} {{ section.settings.unit_word }} {{ tier.settings.pct }} %{% unless forloop.last %}, {% endunless %}{%- endfor -%}
            {%- endcapture -%}
            {%- assign mm_s2 = section.settings.step2 | replace: '[trin]', mm_tiertext -%}
            <li><span>{% render 'nc-cbd', text: mm_s2 %}</span></li>
          {%- endif -%}
          {%- if section.settings.step3 != blank -%}<li><span>{% render 'nc-cbd', text: section.settings.step3 %}</span></li>{%- endif -%}
        </ol>
      {%- endif -%}

      <div style="display: flex; flex-direction: column; gap: 16px;" id="nc-mm-produkter-{{ section.id }}">
        <div class="nc-mm__gridhead">
          {%- if section.settings.grid_heading != blank -%}<h2>{% render 'nc-cbd', text: section.settings.grid_heading %}</h2>{%- endif -%}
          <label class="nc-mm__sort">
            {{ 'mix.sort' | t }}
            <select data-mm-sort id="nc-mm-sort-{{ section.id }}">
              <option value="default">{{ 'mix.sort_default' | t }}</option>
              <option value="price-asc">{{ 'mix.sort_price_asc' | t }}</option>
              <option value="price-desc">{{ 'mix.sort_price_desc' | t }}</option>
              <option value="rating">{{ 'mix.sort_rating' | t }}</option>
            </select>
          </label>
        </div>
        {%- if section.settings.show_filters -%}
          <div class="nc-mm__chips" role="group" aria-label="{{ 'mix.filter_label' | t }}" data-mm-filters>
            <button type="button" data-mm-filter="" aria-pressed="true">{{ 'general.all' | t }}</button>
            <button type="button" data-mm-filter="ansigt" aria-pressed="false">{{ 'areas.face' | t }}</button>
            <button type="button" data-mm-filter="haender" aria-pressed="false">{{ 'areas.hands' | t }}</button>
            <button type="button" data-mm-filter="krop" aria-pressed="false">{{ 'areas.body' | t }}</button>
            <button type="button" data-mm-filter="foedder" aria-pressed="false">{{ 'areas.feet' | t }}</button>
            <button type="button" data-mm-filter="haar" aria-pressed="false">{{ 'areas.hair' | t }}</button>
          </div>
        {%- endif -%}

        <ul class="nc-mm__grid" data-mm-grid>
          {%- assign mm_i = 0 -%}
          {%- for p in mm_src limit: 50 -%}
            {%- liquid
              assign mm_key = ',' | append: p.handle | append: ','
              if p.gift_card? or p.available == false or mm_skip contains mm_key
                continue
              endif
              if p.tags contains 'pakker' or p.tags contains 'Pakker' or p.tags contains 'bundle'
                continue
              endif
              assign v = p.selected_or_first_available_variant
              if v.available == false
                continue
              endif

              assign areas = ','
              for c in p.collections
                case c.handle
                  when 'cbd-ansigtspleje'
                    assign areas = areas | append: 'ansigt,'
                  when 'cbd-handpleje'
                    assign areas = areas | append: 'haender,'
                  when 'cbd-kropspleje'
                    assign areas = areas | append: 'krop,'
                  when 'cbd-fodpleje'
                    assign areas = areas | append: 'foedder,'
                  when 'cbd-haarpleje'
                    assign areas = areas | append: 'haar,'
                endcase
              endfor
              for tag in p.tags
                assign lt = tag | downcase
                case lt
                  when 'ansigt'
                    assign areas = areas | append: 'ansigt,'
                  when 'haender' or 'hænder'
                    assign areas = areas | append: 'haender,'
                  when 'krop'
                    assign areas = areas | append: 'krop,'
                  when 'foedder' or 'fødder'
                    assign areas = areas | append: 'foedder,'
                  when 'haar' or 'hår'
                    assign areas = areas | append: 'haar,'
                endcase
              endfor

              assign title_parts = p.title | split: ' | '
              capture card_title
                render 'nc-title', title: title_parts[0]
              endcapture
              assign card_title = card_title | strip
              capture card_title_plain
                render 'nc-cbd', text: card_title, mode: 'strip'
              endcapture
              assign card_title_plain = card_title_plain | strip
              assign card_sub = p.metafields.ncell.size.value | default: title_parts[1]

              assign rating = p.metafields.reviews.rating.value
              assign rating_count = p.metafields.reviews.rating_count.value
              assign rating_num = rating.rating | default: rating | default: 0 | times: 1.0
              assign rating_round = rating_num | round

              assign mm_now = v.price | times: mm_keep | divided_by: 100.0 | round
              if p.featured_image
                assign mm_thumb = p.featured_image | image_url: width: 120
              else
                assign mm_thumb = ''
              endif
            -%}
            <li class="nc-mm__card" data-mm-card data-id="{{ v.id }}" data-price="{{ v.price }}" data-title="{{ card_title_plain | escape }}" data-thumb="{{ mm_thumb }}" data-areas="{{ areas }}" data-rating="{{ rating_num }}" data-index="{{ mm_i }}">
              <span class="nc-mm__badge" data-mm-badge hidden>{{ 'mix.in_pack' | t }}</span>
              <a class="nc-mm__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
                {%- if p.featured_image -%}
                  {{ p.featured_image | image_url: width: 600 | image_tag: alt: '', loading: 'lazy', widths: '240, 360, 480, 600', sizes: '(min-width: 1200px) 260px, (min-width: 700px) 30vw, 46vw' }}
                {%- endif -%}
              </a>
              <div class="nc-mm__info">
                <h3 class="nc-mm__title"><a href="{{ p.url }}">{% render 'nc-cbd', text: card_title %}</a></h3>
                {%- if card_sub != blank -%}<span class="nc-mm__size">{% render 'nc-cbd', text: card_sub %}</span>{%- endif -%}
                {%- if rating_num > 0 and rating_count != blank -%}
                  <span class="nc-mm__rating">
                    <span class="nc-stars" aria-hidden="true">
                      {%- for i in (1..5) -%}<svg viewBox="0 0 24 24"{% if i > rating_round %} class="is-empty"{% endif %}><path d="M12 2.6l2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.95 6.2 21.05l1.1-6.45L2.6 9.95l6.5-.95L12 2.6z"/></svg>{%- endfor -%}
                    </span>
                    <span>{{ rating_num | round: 1 | replace: '.', ',' }} · {% if rating_count == 1 %}{{ 'mix.review_one' | t: n: rating_count }}{% else %}{{ 'mix.reviews' | t: n: rating_count }}{% endif %}</span>
                  </span>
                {%- endif -%}
                <p class="nc-mm__price">
                  <strong data-mm-now>{{ mm_now | money_without_trailing_zeros }}</strong>
                  <s data-mm-was><span class="nc-visually-hidden">{{ 'mix.normal' | t }} </span>{{ v.price | money_without_trailing_zeros }}</s>
                  <span data-mm-at>{{ 'mix.at_pct' | t: pct: mm_first_pct }}</span>
                </p>
                <button type="button" class="nc-mm__add" data-mm-add>{{ 'mix.add' | t }}</button>
                <div class="nc-mm__stepper" data-mm-stepper hidden>
                  <button type="button" data-mm-dec aria-label="{{ 'mix.decrease' | t: title: card_title_plain | escape }}">−</button>
                  <output data-mm-qty aria-live="polite">0</output>
                  <button type="button" data-mm-inc aria-label="{{ 'mix.increase' | t: title: card_title_plain | escape }}">+</button>
                </div>
              </div>
            </li>
            {%- assign mm_i = mm_i | plus: 1 -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>

    <aside class="nc-mm__aside" id="nc-mm-pakke-{{ section.id }}">
      <div class="nc-mm__pack">
        <h2>{{ 'mix.pack_title' | t }}</h2>
        {%- if mm_tiers.size > 0 -%}
          <div class="nc-mm__progress" aria-hidden="true">
            <div class="nc-mm__bar">
              <span class="nc-mm__fill" data-mm-fill></span>
              {%- for tier in mm_tiers -%}
                {%- assign mm_pos = tier.settings.qty | times: 100.0 | divided_by: mm_max_qty -%}
                <span class="nc-mm__dot" data-mm-dot="{{ tier.settings.qty }}" style="left: {{ mm_pos }}%;"></span>
              {%- endfor -%}
            </div>
            <div class="nc-mm__ticks">
              {%- for tier in mm_tiers -%}
                {%- assign mm_pos = tier.settings.qty | times: 100.0 | divided_by: mm_max_qty -%}
                <span style="left: {{ mm_pos }}%;">{{ tier.settings.qty }}{% if forloop.last and mm_tiers.size > 1 %}+{% endif %} · {{ tier.settings.pct }} %</span>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
        <p class="nc-mm__msg" data-mm-msg aria-live="polite">{{ 'mix.pick_for' | t: n: mm_first_qty, pct: mm_first_pct }}</p>
        <p class="nc-mm__empty" data-mm-empty>{{ 'mix.empty' | t }}</p>
        <ul class="nc-mm__list" data-mm-list hidden></ul>
        <dl class="nc-mm__sum" data-mm-sum hidden>
          <div><dt>{{ 'mix.normal' | t }}</dt><dd data-mm-normal></dd></div>
          <div class="is-total"><dt>{{ 'mix.total' | t }}</dt><dd data-mm-total></dd></div>
          <div class="is-save" data-mm-save-row><dt>{{ 'mix.save' | t }}</dt><dd data-mm-save></dd></div>
        </dl>
        <button type="button" class="nc-btn nc-btn--primary nc-mm__cta" data-mm-submit disabled>{{ 'mix.pick_min' | t: n: mm_first_qty }}</button>
        <p class="nc-mm__error" data-mm-error role="alert" hidden></p>
        {%- if section.settings.show_trust -%}
          <p class="nc-mm__small" style="text-align: center;">
            {%- if mm_fs != blank -%}{{ 'general.free_shipping' | t: amount: mm_fs }} · {% endif -%}{{ 'pdp.ticker.returns' | t }}
          </p>
        {%- endif -%}
      </div>
    </aside>
  </div>

  <div class="nc-mm__mbar" data-mm-mbar hidden>
    <div class="nc-mm__mbar-sum">
      <span data-mm-mcount></span>
      <strong data-mm-mtotal></strong>
      <a href="#nc-mm-pakke-{{ section.id }}">{{ 'mix.see_pack' | t }}</a>
    </div>
    <button type="button" class="nc-btn nc-btn--primary" data-mm-submit disabled>{{ 'mix.pick_min' | t: n: mm_first_qty }}</button>
  </div>

  {%- liquid
    assign mm_i18n_pick_min = 'mix.pick_min' | t: n: '{n}'
    assign mm_i18n_pick_for = 'mix.pick_for' | t: n: '{n}', pct: '{pct}'
    assign mm_i18n_pick_more = 'mix.pick_more' | t: n: '{n}', pct: '{pct}'
    assign mm_i18n_now_more = 'mix.now_more' | t: n: '{n}', pct: '{pct}', next: '{next}'
    assign mm_i18n_full = 'mix.full' | t: pct: '{pct}'
    assign mm_i18n_at = 'mix.at_pct' | t: pct: '{pct}'
    assign mm_i18n_selected = 'mix.selected' | t: n: '{n}'
    assign mm_i18n_add_all = 'mix.add_all' | t
    assign mm_i18n_remove = 'mix.remove' | t
    assign mm_i18n_error = 'mix.error' | t
    assign mm_i18n_dec = 'mix.decrease' | t: title: '{title}'
    assign mm_i18n_inc = 'mix.increase' | t: title: '{title}'
    assign mm_cart_add = routes.cart_add_url | append: '.js'
    capture mm_tiers_json
      echo '['
      for tier in mm_tiers
        echo '{"qty":' | append: tier.settings.qty | append: ',"pct":' | append: tier.settings.pct | append: '}'
        unless forloop.last
          echo ','
        endunless
      endfor
      echo ']'
    endcapture
  -%}
  <script type="application/json" data-mm-config>
    {
      "tiers": {{ mm_tiers_json }},
      "money": {{ shop.money_format | json }},
      "cartAdd": {{ mm_cart_add | json }},
      "cartUrl": {{ routes.cart_url | json }},
      "i18n": {
        "pickMin": {{ mm_i18n_pick_min | json }},
        "pickFor": {{ mm_i18n_pick_for | json }},
        "pickMore": {{ mm_i18n_pick_more | json }},
        "nowMore": {{ mm_i18n_now_more | json }},
        "full": {{ mm_i18n_full | json }},
        "at": {{ mm_i18n_at | json }},
        "selected": {{ mm_i18n_selected | json }},
        "addAll": {{ mm_i18n_add_all | json }},
        "remove": {{ mm_i18n_remove | json }},
        "error": {{ mm_i18n_error | json }},
        "dec": {{ mm_i18n_dec | json }},
        "inc": {{ mm_i18n_inc | json }}
      }
    }
  </script>
</div>
<script src="{{ 'nc-mix-match.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Bland selv",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Rabatten er automatiske rabatter i Shopify (Rabatter), en pr. trin, på de samme produkter. Sektionen viser kun prisen, så trin og rabatter skal matche." },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Bland selv" },
    { "type": "text", "id": "heading", "label": "Overskrift", "info": "Tom = kollektionens navn.", "default": "Sammensæt din egen rutine. Jo flere, jo billigere" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Vælg mellem vores enkeltprodukter til ansigt, krop, hænder, fødder og hår. Rabatten regnes af normalprisen og stiger, jo flere produkter du tager med." },
    { "type": "header", "content": "Citat" },
    { "type": "text", "id": "quote", "label": "Citat", "info": "Tom = intet citat. Brug kun egne, ægte ord.", "default": "Vi bruger selv produkterne hver dag." },
    { "type": "text", "id": "quote_author", "label": "Afsender", "default": "Lizbeth og Allan" },
    { "type": "image_picker", "id": "quote_image", "label": "Billede", "info": "Tom = billedet af Lizbeth og Allan." },
    { "type": "header", "content": "Trin og tekster" },
    { "type": "text", "id": "tiers_label", "label": "Trin: skjult etiket til skærmlæsere", "default": "Rabattrin" },
    { "type": "text", "id": "tiers_note", "label": "Tekst under trinene", "default": "Rabatten stiger automatisk, jo flere du vælger" },
    { "type": "checkbox", "id": "show_trust", "label": "Vis Trustpilot, fri fragt, e-mærket og fortrydelsesret", "default": true },
    { "type": "text", "id": "fine_print", "label": "Betingelser (lille tekst)", "default": "Gælder enkeltprodukterne på denne side. Kan ikke kombineres med rabatkoder." },
    { "type": "inline_richtext", "id": "step1", "label": "Trin 1", "info": "[antal] = første trins antal.", "default": "<strong>Vælg mindst [antal] produkter.</strong> Alle produkter på siden tæller med, også flere af det samme." },
    { "type": "inline_richtext", "id": "step2", "label": "Trin 2", "info": "[trin] = trinene, fx 2 produkter 10 %, 3 produkter 15 %.", "default": "<strong>Prisen falder, mens du vælger:</strong> [trin]." },
    { "type": "text", "id": "unit_word", "label": "Ord efter antal i trin 2", "default": "produkter" },
    { "type": "inline_richtext", "id": "step3", "label": "Trin 3", "default": "<strong>Læg hele pakken i kurven</strong> med ét tryk." },
    { "type": "header", "content": "Produkter" },
    { "type": "text", "id": "grid_heading", "label": "Overskrift over produkterne", "default": "Vælg dine produkter" },
    { "type": "checkbox", "id": "show_filters", "label": "Vis filtre for område", "default": true },
    { "type": "product_list", "id": "products", "label": "Produkter (valgfri)", "info": "Tom = kollektionens produkter. Pakker, gavekort og udsolgte varer vises aldrig.", "limit": 50 },
    { "type": "textarea", "id": "skip_handles", "label": "Spring over (handles, kommasepareret)", "default": "love-lubricant" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Rabattrin",
      "limit": 5,
      "settings": [
        { "type": "paragraph", "content": "Trinene skal stå i stigende rækkefølge. Det sidste trin gælder også flere produkter (fx 4+)." },
        { "type": "range", "id": "qty", "label": "Antal produkter", "min": 2, "max": 10, "step": 1, "default": 2 },
        { "type": "range", "id": "pct", "label": "Rabat i %", "min": 5, "max": 50, "step": 1, "unit": "%", "default": 10 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bland selv",
      "blocks": [
        { "type": "tier", "settings": { "qty": 2, "pct": 10 } },
        { "type": "tier", "settings": { "qty": 3, "pct": 15 } },
        { "type": "tier", "settings": { "qty": 4, "pct": 20 } }
      ]
    }
  ]
}
{% endschema %}
