{% comment %}
  Soegeside: soegefelt med forslag mens man skriver (predictive-search), resultater delt i
  produkter (produktkort) og sider/artikler, og en hjaelpsom tom-tilstand med genveje og
  populaere produkter. Soegningen bruger delvis match paa sidste ord (options[prefix]=last)
  og viser udsolgte varer sidst.
{% endcomment %}

{%- style -%}
  .nc-search { padding-top: clamp(24px, 5vw, 44px); }
  .nc-search h1 { margin: 0 0 18px; font-family: var(--font-display); font-weight: 400; font-size: clamp(28px, 4vw, 40px); line-height: 1.15; color: var(--sage-700); }
  .nc-search__form { position: relative; display: flex; gap: 10px; max-width: 620px; margin: 0 0 clamp(20px, 3vw, 32px); }
  .nc-search__form .nc-input { flex: 1; min-width: 0; }
  .nc-search__count { margin: 0 0 18px; font-size: 14px; color: var(--ink-500); }
  .nc-search__head { margin: clamp(28px, 4vw, 44px) 0 14px; font-family: var(--font-display); font-weight: 400; font-size: 24px; color: var(--sage-700); }
  .nc-search__head:first-of-type { margin-top: 0; }
  .nc-search__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; max-width: 820px; }
  .nc-search__item { display: block; padding: 16px 18px; background: var(--cloud); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); text-decoration: none; transition: border-color var(--dur-fast) var(--ease-soft); }
  .nc-search__item:hover { border-color: var(--sage-400); }
  .nc-search__item small { display: block; margin-bottom: 4px; font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-400); }
  .nc-search__item strong { display: block; font-family: var(--font-display); font-weight: 400; font-size: 19px; line-height: 1.25; color: var(--sage-700); }
  .nc-search__item span { display: block; margin-top: 6px; font-size: 14.5px; line-height: 1.6; color: var(--ink-500); }
  .nc-search__empty { max-width: 640px; }
  .nc-search__empty p { margin: 0 0 14px; font-size: 16px; line-height: 1.6; color: var(--ink-700); }
  .nc-search__shortcuts { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 8px; }
  .nc-search .nc-grid { gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(47%, 238px), 1fr)); }
  .nc-search .nc-pagination { margin-top: 40px; }
{%- endstyle -%}

<div class="nc-section nc-search">
  <div class="nc-container">
    <h1>{% if search.performed %}{{ 'search.results_title' | t }}{% else %}{{ 'general.search' | t }}{% endif %}</h1>

    <form class="nc-search__form" action="{{ routes.search_url }}" method="get" role="search" data-nc-predictive="{{ routes.predictive_search_url }}">
      <label class="nc-visually-hidden" for="nc-search-input">{{ 'general.search' | t }}</label>
      <input
        id="nc-search-input"
        class="nc-input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search_products' | t }}"
        role="combobox"
        aria-expanded="false"
        aria-controls="nc-ps-main"
        aria-autocomplete="list"
        autocomplete="off"
        {% unless search.performed %}autofocus{% endunless %}
      >
      <input type="hidden" name="options[prefix]" value="last">
      <input type="hidden" name="options[unavailable_products]" value="last">
      <button class="nc-btn nc-btn--primary" type="submit">{{ 'general.search' | t }}</button>
      <div class="nc-ps-box" id="nc-ps-main" data-nc-ps hidden></div>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="nc-search__count">{{ 'search.results_for' | t: count: search.results_count, terms: search.terms }}</p>

        {%- paginate search.results by 24 -%}
          {%- capture res_products -%}
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                <li>{% render 'nc-product-card', product: item %}</li>
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- capture res_other -%}
            {%- for item in search.results -%}
              {%- case item.object_type -%}
                {%- when 'article' -%}
                  {%- assign res_title = item.title | split: ' | ' | first -%}
                  <li>
                    <a class="nc-search__item" href="{{ item.url }}">
                      <small>{{ 'blog.article' | t }}</small>
                      <strong>{% render 'nc-cbd', text: res_title %}</strong>
                      <span>{{ item.excerpt_or_content | strip_html | truncatewords: 26 }}</span>
                    </a>
                  </li>
                {%- when 'page' -%}
                  <li>
                    <a class="nc-search__item" href="{{ item.url }}">
                      <small>{{ 'general.page_label' | t }}</small>
                      <strong>{% render 'nc-cbd', text: item.title %}</strong>
                      {%- assign res_text = item.content | strip_html | strip | truncatewords: 26 -%}
                      {%- if res_text != blank -%}<span>{{ res_text }}</span>{%- endif -%}
                    </a>
                  </li>
              {%- endcase -%}
            {%- endfor -%}
          {%- endcapture -%}

          {%- if res_products != blank -%}
            {%- if res_other != blank -%}<h2 class="nc-search__head">{{ 'search.products' | t }}</h2>{%- endif -%}
            <ul class="nc-grid" style="list-style: none; margin: 0; padding: 0;">{{ res_products }}</ul>
          {%- endif -%}
          {%- if res_other != blank -%}
            <h2 class="nc-search__head">{{ 'search.pages_articles' | t }}</h2>
            <ul class="nc-search__list">{{ res_other }}</ul>
          {%- endif -%}

          {%- if paginate.pages > 1 -%}
            <nav class="nc-pagination" aria-label="{{ 'general.pages' | t }}">
              {{ paginate | default_pagination }}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <div class="nc-search__empty">
          <p>{{ 'search.no_results' | t: terms: search.terms }}</p>
          <p>{{ 'search.try' | t }}</p>
          <div class="nc-search__shortcuts">
            <a class="nc-chip" href="{% render 'nc-url', url: section.settings.all_url, fallback: '/collections/cbd-hudpleje' %}">{{ 'search.all_products' | t }}</a>
            <a class="nc-chip" href="{% render 'nc-url', url: section.settings.start_url, fallback: '/pages/hvor-skal-jeg-starte' %}">{{ 'search.where_to_start' | t }}</a>
            <a class="nc-chip" href="{% render 'nc-url', url: section.settings.contact_url, fallback: '/pages/kontakt' %}">{{ 'search.contact' | t }}</a>
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- liquid
      assign show_popular = false
      if section.settings.popular != blank
        unless search.performed and search.results_count > 0
          assign show_popular = true
        endunless
      endif
    -%}
    {%- if show_popular -%}
      <h2 class="nc-search__head">{{ 'search.popular' | t }}</h2>
      <ul class="nc-grid" style="list-style: none; margin: 0; padding: 0;">
        {%- for product in section.settings.popular.products limit: 4 -%}
          <li>{% render 'nc-product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Søgning",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "popular", "label": "Populære produkter", "info": "Vises før en søgning og når en søgning ikke giver resultater (4 produkter)." },
    { "type": "url", "id": "all_url", "label": "Genvej: alle produkter" },
    { "type": "url", "id": "start_url", "label": "Genvej: Hvor skal jeg starte?" },
    { "type": "url", "id": "contact_url", "label": "Genvej: kontakt" }
  ]
}
{% endschema %}
