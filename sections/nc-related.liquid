{% comment %} Relaterede produkter: Shopify-anbefalinger med kollektion som fallback. {% endcomment %}

<section class="nc-section" style="background: var(--nc-bestsellers-bg);">
  <div class="nc-container">
    <div style="margin-bottom: clamp(20px, 3vw, 32px);">
      <p class="nc-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 style="margin: 0;">{{ section.settings.heading }}</h2>
    </div>

    <ul class="nc-grid">
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {%- for rec in recommendations.products limit: section.settings.limit -%}
          <li>{% render 'nc-product-card', product: rec %}</li>
        {%- endfor -%}
      {%- elsif product.collections.first -%}
        {%- assign shown = 0 -%}
        {%- for p in product.collections.first.products -%}
          {%- if p.id != product.id and shown < section.settings.limit -%}
            <li>{% render 'nc-product-card', product: p %}</li>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Relaterede produkter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Passer godt sammen" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Andre har også kigget på" },
    { "type": "range", "id": "limit", "label": "Antal", "min": 2, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}
