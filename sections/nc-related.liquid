{% comment %}
  Produktside: "Passer godt sammen med"-rail 1:1 fra NatureCell.dc.html.
  Overskrift til venstre, runde pil-knapper til hoejre, produktkort i
  vandret rail. Shopify-anbefalinger med kollektion som fallback
  (uden sampakker), samme kort-snippet som resten af butikken.
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} .nc-relrail { padding: 72px 0 clamp(48px, 6vw, 80px); }
  #shopify-section-{{ section.id }} .nc-relrail__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  #shopify-section-{{ section.id }} .nc-relrail__head h2 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 28px; line-height: var(--leading-relaxed); letter-spacing: normal; color: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-relrail__nav { display: flex; gap: 8px; }
  #shopify-section-{{ section.id }} .nc-relrail__nav button { width: 42px; height: 42px; border-radius: 999px; border: 1px solid var(--border-default); background: var(--cloud); color: var(--ink-700); cursor: pointer; display: flex; align-items: center; justify-content: center; }
  #shopify-section-{{ section.id }} .nc-relrail__nav button:hover { background: var(--sage-50); border-color: var(--sage-400); }
  #shopify-section-{{ section.id }} .nc-relrail__rail { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(min(47%, 248px), 1fr); gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; overscroll-behavior-x: contain; padding-bottom: 12px; }
  #shopify-section-{{ section.id }} .nc-relrail__rail::-webkit-scrollbar { display: none; }
  /* Designet (template.html:1776-1780): kortene ligger i auto-hoeje wrappers og har
     naturlig hoejde: Collagen-kortet (2 titellinjer) er 22px hoejere end de andre. */
  #shopify-section-{{ section.id }} .nc-relrail__rail { align-items: start; }
  #shopify-section-{{ section.id }} .nc-relrail__rail > * { scroll-snap-align: start; }
  #shopify-section-{{ section.id }} .nc-product-card { height: auto; }
  /* Korttitler som i designets NCProductCard: ingen tracking, almindelig ombrydning.
     max-width matcher designets ombrydning ("Collagen med / hyaluronsyre"). */
  #shopify-section-{{ section.id }} .nc-product-card__title { letter-spacing: normal; text-wrap: wrap; max-width: 210px; line-height: 1.25; }
  /* Tekstblokkens lodrette rytme 1:1 fra NCProductCard.dc.html (body 16px/1.7):
     gap 7, padding 18/18/20; rating-div = margin-top 2 + strut-linje 27.2px med
     stjernerne 4.5px nede; pris-div = padding-top 10 + strut-linje, hvor PriceTag (22px/1)
     baseline-justeres 2.5px nede (maalt mod designets render: pris-glyf 153px, kortbund 197px under mediet). */
  #shopify-section-{{ section.id }} .nc-product-card__info { gap: 7px; padding: 18px 18px 20px; line-height: 1.7; }
  #shopify-section-{{ section.id }} .nc-product-card__rating { margin-top: 2px; box-sizing: border-box; height: 27.2px; padding-bottom: 2.2px; align-items: center; }
  #shopify-section-{{ section.id }} .nc-product-card__price { margin-top: auto; padding: 12.5px 0 4.2px; }
{%- endstyle -%}

<div class="nc-relrail">
  <div class="nc-container" data-nc-railwrap>
    <div class="nc-relrail__head">
      <h2>{{ section.settings.heading }}</h2>
      <div class="nc-relrail__nav">
        <button type="button" data-nc-rail-prev aria-label="Forrige">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" data-nc-rail-next aria-label="Næste">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <div class="nc-relrail__rail" data-nc-railscroll>
      {%- assign pinned_size = section.settings.pinned | size -%}
      {%- if pinned_size > 0 -%}
        {%- for item in section.settings.pinned limit: section.settings.limit -%}
          {%- if item.title -%}
            <div>{% render 'nc-product-card', product: item %}</div>
          {%- else -%}
            {%- assign pinned_product = all_products[item] -%}
            {%- if pinned_product.title -%}
              <div>{% render 'nc-product-card', product: pinned_product %}</div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- elsif recommendations.performed and recommendations.products_count > 0 -%}
        {%- for rec in recommendations.products limit: section.settings.limit -%}
          <div>{% render 'nc-product-card', product: rec %}</div>
        {%- endfor -%}
      {%- elsif product.collections.first or collection -%}
        {%- assign src = product.collections.first | default: collection -%}
        {%- assign shown = 0 -%}
        {%- for p in src.products -%}
          {%- assign skip = false -%}
          {%- if p.id == product.id -%}{%- assign skip = true -%}{%- endif -%}
          {%- if p.tags contains 'pakker' or p.tags contains 'bundle' -%}{%- assign skip = true -%}{%- endif -%}
          {%- if skip == false and shown < section.settings.limit -%}
            <div>{% render 'nc-product-card', product: p %}</div>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Relaterede produkter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Passer godt sammen med" },
    { "type": "product_list", "id": "pinned", "label": "Faste produkter (overstyrer anbefalinger)", "limit": 10 },
    { "type": "range", "id": "limit", "label": "Antal", "min": 2, "max": 10, "step": 1, "default": 10 }
  ]
}
{% endschema %}
