{% comment %}
  Hero-karrusel fra NatureCell.dc.html: 4 slides, autoplay 7s,
  pile og dots. Tre slide-typer: produkt (sage-baggrund + packshot),
  billede (fuldt baggrundsbillede med gradient) og split (tekst +
  billede side om side, fx Loevens Hule).
{% endcomment %}

{%- style -%}
  .nc-hero { position: relative; background: var(--nc-hero-bg); color: var(--paper); overflow: hidden; }
  .nc-hero__track { display: flex; transform: translateX(0); transition: transform 700ms var(--ease-out); }
  .nc-hero__slide { flex: 0 0 100%; position: relative; min-height: clamp(540px, 82vh, 640px); overflow: hidden; }

  .nc-hero__inner {
    position: relative;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 clamp(22px, 6.6vw, 72px) 64px;
    min-height: clamp(540px, 82vh, 640px);
  }
  .nc-hero__inner--grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: clamp(24px, 4vw, 40px);
    align-items: center;
  }
  .nc-hero__inner--stack { display: flex; flex-direction: column; justify-content: center; gap: 20px; }
  @media (max-width: 699px) {
    .nc-hero__inner--stack { justify-content: flex-end; }
  }

  .nc-hero__text { display: flex; flex-direction: column; gap: 22px; padding: clamp(37px, 7vw, 64px) 0; max-width: 520px; }
  .nc-hero__eyebrow { font-family: var(--font-body); font-weight: 600; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sage-200); margin: 0; }
  .nc-hero__h1 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(40px, 5vw, 68px); line-height: 1.02; letter-spacing: -0.01em; color: var(--paper); }
  .nc-hero__h2 { margin: 0; max-width: 560px; font-family: var(--font-display); font-weight: 400; font-size: clamp(34px, 4.4vw, 56px); line-height: 1.04; color: var(--paper); }
  .nc-hero__body { margin: 0; font-size: 18px; line-height: 1.7; color: rgba(246, 244, 238, 0.86); max-width: 440px; }
  .nc-hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; }

  .nc-hero__trust { display: flex; align-items: center; gap: 14px; margin-top: 10px; }
  .nc-hero__trust .nc-stars { color: var(--accent-pink); }
  .nc-hero__trust .nc-stars svg { width: 18px; height: 18px; }
  .nc-hero__trust span { font-size: 14px; color: rgba(246, 244, 238, 0.82); }
  .nc-hero__trust strong { color: var(--paper); }

  .nc-hero__packshot-wrap { position: relative; display: flex; align-items: center; justify-content: center; padding: 40px 0; }
  .nc-hero__glow { position: absolute; width: 380px; height: 380px; border-radius: var(--radius-pill); background: radial-gradient(circle, rgba(255, 255, 255, 0.12), transparent 70%); }
  .nc-hero__packshot { position: relative; max-width: 400px; width: 100%; filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.35)); }

  .nc-hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .nc-hero__wash { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(40, 64, 59, 0.74), rgba(40, 64, 59, 0.26)); pointer-events: none; }

  .nc-hero__split-media { display: flex; align-items: center; justify-content: center; padding: clamp(19px, 7vw, 32px) 0; }
  .nc-hero__split-media img { width: 100%; max-width: 520px; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }

  .nc-hero__arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 5; background: rgba(246, 244, 238, 0.92); border: 0; color: var(--sage-700); }
  .nc-hero__arrow:hover { background: var(--paper); }
  .nc-hero__arrow--prev { left: clamp(10px, 2vw, 24px); }
  .nc-hero__arrow--next { right: clamp(10px, 2vw, 24px); }

  .nc-hero__dots { position: absolute; left: 0; right: 0; bottom: 22px; display: flex; justify-content: center; gap: 8px; z-index: 5; }
  .nc-hero__dot { width: 8px; height: 8px; padding: 0; border: 0; border-radius: var(--radius-pill); background: rgba(246, 244, 238, 0.45); cursor: pointer; transition: width var(--dur-base) var(--ease-soft), background-color var(--dur-base) var(--ease-soft); }
  .nc-hero__dot.is-active { width: 26px; background: var(--paper); }

  @media (max-width: 699px) {
    .nc-hero__arrow { display: none; }
  }
{%- endstyle -%}

<section class="nc-hero" data-nc-carousel="{{ section.settings.autoplay | default: 7000 }}" aria-label="Fremhævet indhold">
  <div class="nc-hero__track" data-nc-track>
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'product_slide' -%}
          <div class="nc-hero__slide" data-nc-slide {{ block.shopify_attributes }}>
            <div class="nc-hero__inner nc-hero__inner--grid">
              <div class="nc-hero__text">
                <p class="nc-hero__eyebrow">{{ block.settings.eyebrow }}</p>
                <h1 class="nc-hero__h1">{{ block.settings.heading }}</h1>
                <p class="nc-hero__body">{{ block.settings.body }}</p>
                <div class="nc-hero__ctas">
                  {%- if block.settings.cta_text != blank -%}
                    <a class="nc-btn nc-btn--light" href="{{ block.settings.cta_url }}">{{ block.settings.cta_text }}</a>
                  {%- endif -%}
                  {%- if block.settings.cta2_text != blank -%}
                    <a class="nc-btn nc-btn--outline" href="{{ block.settings.cta2_url }}">{{ block.settings.cta2_text }}</a>
                  {%- endif -%}
                </div>
                {%- if block.settings.trust_text != blank -%}
                  <div class="nc-hero__trust">
                    <span class="nc-stars" aria-hidden="true">
                      {%- for i in (1..5) -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="m12 2 3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.4 21.7l1.8-7.3L1.5 9.5 9 8.9Z"/></svg>
                      {%- endfor -%}
                    </span>
                    <span>{{ block.settings.trust_text }}</span>
                  </div>
                {%- endif -%}
              </div>
              <div class="nc-hero__packshot-wrap">
                <div class="nc-hero__glow" aria-hidden="true"></div>
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 800 | image_tag: class: 'nc-hero__packshot', alt: block.settings.heading, widths: '400, 600, 800', loading: 'eager' }}
                {%- else -%}
                  <img class="nc-hero__packshot" src="{{ 'nc-hero-kompletpakken.png' | asset_url }}" alt="Komplet CBD Hudpleje" width="800" height="800">
                {%- endif -%}
              </div>
            </div>
          </div>

        {%- when 'image_slide' -%}
          <div class="nc-hero__slide" data-nc-slide {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 2200 | image_tag: class: 'nc-hero__bg', alt: '', widths: '800, 1200, 1600, 2200', sizes: '100vw', loading: 'lazy' }}
            {%- elsif block.settings.fallback_asset != blank -%}
              <img class="nc-hero__bg" src="{{ block.settings.fallback_asset | asset_url }}" alt="" loading="lazy">
            {%- endif -%}
            <div class="nc-hero__wash" aria-hidden="true"></div>
            <div class="nc-hero__inner nc-hero__inner--stack">
              <p class="nc-hero__eyebrow">{{ block.settings.eyebrow }}</p>
              <h2 class="nc-hero__h2">{{ block.settings.heading }}</h2>
              <p class="nc-hero__body">{{ block.settings.body }}</p>
              {%- if block.settings.cta_text != blank -%}
                <div><a class="nc-btn nc-btn--light" href="{{ block.settings.cta_url }}">{{ block.settings.cta_text }}</a></div>
              {%- endif -%}
            </div>
          </div>

        {%- when 'split_slide' -%}
          <div class="nc-hero__slide" data-nc-slide {{ block.shopify_attributes }}>
            <div class="nc-hero__inner nc-hero__inner--grid">
              <div class="nc-hero__text">
                <p class="nc-hero__eyebrow">{{ block.settings.eyebrow }}</p>
                <h2 class="nc-hero__h2">{{ block.settings.heading }}</h2>
                <p class="nc-hero__body">{{ block.settings.body }}</p>
                {%- if block.settings.cta_text != blank -%}
                  <div class="nc-hero__ctas">
                    <a class="nc-btn nc-btn--light" href="{{ block.settings.cta_url }}">{{ block.settings.cta_text }}</a>
                  </div>
                {%- endif -%}
              </div>
              <div class="nc-hero__split-media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1040 | image_tag: alt: block.settings.heading, widths: '520, 780, 1040', loading: 'lazy' }}
                {%- elsif block.settings.fallback_asset != blank -%}
                  <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.heading | escape }}" loading="lazy">
                {%- endif -%}
              </div>
            </div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <button class="nc-iconbtn nc-hero__arrow nc-hero__arrow--prev" data-nc-prev aria-label="Forrige slide">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button class="nc-iconbtn nc-hero__arrow nc-hero__arrow--next" data-nc-next aria-label="Næste slide">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
    </button>
    <div class="nc-hero__dots">
      {%- for block in section.blocks -%}
        <button class="nc-hero__dot" data-nc-dot aria-label="Gå til slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero-karrusel",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "autoplay",
      "label": "Autoplay-interval",
      "min": 4000,
      "max": 12000,
      "step": 500,
      "unit": "ms",
      "default": 7000
    }
  ],
  "blocks": [
    {
      "type": "product_slide",
      "name": "Produkt-slide",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Danmarks første godkendte CBD-hudpleje" },
        { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Ægte pleje,<br>til al slags hud" },
        { "type": "textarea", "id": "body", "label": "Brødtekst", "default": "Plantebaseret CBD-hudpleje, udviklet og testet i Danmark. Vi lover ikke mirakler. Vi lader vores kunder fortælle om deres egne oplevelser." },
        { "type": "text", "id": "cta_text", "label": "Primær knap", "default": "Shop nu →" },
        { "type": "url", "id": "cta_url", "label": "Primær knap: link" },
        { "type": "text", "id": "cta2_text", "label": "Sekundær knap", "default": "Se kundecases" },
        { "type": "url", "id": "cta2_url", "label": "Sekundær knap: link" },
        { "type": "text", "id": "trust_text", "label": "Trust-linje", "default": "<strong>4,8/5</strong> · 2.143 anmeldelser på Trustpilot", "info": "Tallene skal matche jeres aktuelle Trustpilot-score." },
        { "type": "image_picker", "id": "image", "label": "Packshot" }
      ]
    },
    {
      "type": "image_slide",
      "name": "Billed-slide",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Plantebaseret & dansk" },
        { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "CBD i samspil med ren botanik" },
        { "type": "textarea", "id": "body", "label": "Brødtekst", "default": "Glycerin, mandelolie, squalane og aloe vera. Vegansk, uden syntetisk parfume. Udviklet og testet i Danmark." },
        { "type": "text", "id": "cta_text", "label": "Knap", "default": "Udforsk produkterne →" },
        { "type": "url", "id": "cta_url", "label": "Knap: link" },
        { "type": "image_picker", "id": "image", "label": "Baggrundsbillede" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback-asset (avanceret)", "info": "Filnavn i temaets assets, bruges når intet billede er valgt." }
      ]
    },
    {
      "type": "split_slide",
      "name": "Split-slide",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Investering i Løvens Hule" },
        { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Jesper Buch er trådt ind som investor" },
        { "type": "textarea", "id": "body", "label": "Brødtekst", "default": "Et stærkt skulderklap til dansk CBD-hudpleje: efter vores tur i Løvens Hule er Jesper Buch gået ind som investor i NatureCell, sammen med grundlæggerne Lizbeth Falk og Allan Gamborg." },
        { "type": "text", "id": "cta_text", "label": "Knap", "default": "Læs historien →" },
        { "type": "url", "id": "cta_url", "label": "Knap: link" },
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback-asset (avanceret)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero-karrusel",
      "blocks": [
        { "type": "product_slide" },
        { "type": "image_slide" },
        { "type": "image_slide", "settings": { "eyebrow": "Ægte oplevelser", "heading": "Vi lader vores kunder fortælle", "body": "Vi lover ikke mirakler. Læs ægte kundecases, med billeder, video og produkterne de bruger.", "cta_text": "Se kundecases →", "fallback_asset": "nc-hero-kunder.jpg" } },
        { "type": "split_slide" }
      ]
    }
  ]
}
{% endschema %}
