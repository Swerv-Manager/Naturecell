{% comment %}
  Fuldbred billedbaand med CTA fra Om CBD-designet ("Hele serien").
  Baggrundsbillede med moerk gradient i venstre side, eyebrow,
  overskrift, tekst og lys knap.
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} .nc-imgcta { position: relative; min-height: clamp(340px, 40vw, 460px); display: flex; align-items: center; overflow: hidden; background: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-imgcta__bg { position: absolute; inset: 0; }
  #shopify-section-{{ section.id }} .nc-imgcta__bg img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .nc-imgcta__wash { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(35, 51, 48, 0.68) 0%, rgba(35, 51, 48, 0.32) 46%, rgba(35, 51, 48, 0) 75%); }
  #shopify-section-{{ section.id }} .nc-imgcta__inner { position: relative; padding: clamp(40px, 5vw, 64px) 0; max-width: 46ch; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  #shopify-section-{{ section.id }} .nc-imgcta__inner h2 { margin: 0; color: var(--cloud); font-size: clamp(28px, 3.4vw, 44px); line-height: 1.12; }
  #shopify-section-{{ section.id }} .nc-imgcta__inner p { margin: 0; color: rgba(255, 255, 255, 0.88); line-height: 1.65; }
{%- endstyle -%}

<div class="nc-imgcta nc-on-dark">
  <div class="nc-imgcta__bg" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2200 | image_tag: alt: '', loading: 'lazy', sizes: '100vw' }}
    {%- elsif section.settings.image_url contains '//' -%}
      <img src="{{ section.settings.image_url }}" alt="" loading="lazy" width="2200" height="700">
    {%- elsif section.settings.image_url != blank -%}
      <img src="{{ section.settings.image_url | asset_url }}" alt="" loading="lazy" width="2200" height="700">
    {%- endif -%}
    <span class="nc-imgcta__wash"></span>
  </div>
  <div class="nc-container" style="width: 100%;">
    <div class="nc-imgcta__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nc-eyebrow" style="margin: 0;">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <a class="nc-btn nc-btn--light" href="{{ section.settings.cta_url | default: '/collections/cbd-hudpleje' }}" style="margin-top: 6px;">{{ section.settings.cta_text }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NC billed-CTA",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Baggrundsbillede" },
    { "type": "text", "id": "image_url", "label": "Billede-URL/asset (fallback)" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Hele serien" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Én serie — til hele din rutine" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Rens, creme, olie og mere — plantebaseret CBD-hudpleje til ansigt og krop." },
    { "type": "text", "id": "cta_text", "label": "Knaptekst", "default": "Shop hudpleje →" },
    { "type": "url", "id": "cta_url", "label": "Knaplink" }
  ],
  "presets": [ { "name": "NC billed-CTA" } ]
}
{% endschema %}
