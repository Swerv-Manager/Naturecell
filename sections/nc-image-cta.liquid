{% comment %}
  Fuldbred billedbaand med CTA fra Om CBD-designet ("Hele serien",
  template.html:2210-2222). Baggrundsbillede med moerk gradient i venstre
  side, eyebrow, overskrift, tekst og lys knap.
{% endcomment %}

{%- style -%}
  {%- comment -%} Designets baand: min-height 420, container 1180, padding clamp(40,6vw,72), gradient rgba(31,45,41,.74) → .15. {%- endcomment -%}
  #shopify-section-{{ section.id }} .nc-imgcta { position: relative; min-height: 420px; display: flex; align-items: center; overflow: hidden; background: var(--sage-700); }
  #shopify-section-{{ section.id }} .nc-imgcta .nc-container { max-width: 1180px; }
  #shopify-section-{{ section.id }} .nc-imgcta__bg { position: absolute; inset: 0; }
  #shopify-section-{{ section.id }} .nc-imgcta__bg img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .nc-imgcta__wash { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(31, 45, 41, 0.74), rgba(31, 45, 41, 0.15)); }
  {%- comment -%} Designets tekstblok: max-width 460, flex-kolonne gap 16; eyebrow rgba(246,244,238,.85) uden linjehoejde;
      h2 clamp(30,4vw,44)/1.08 hvid; p 16px/1.7 rgba(246,244,238,.9); knap paper/sage-700 15px/600 padding 14px 28px. {%- endcomment -%}
  #shopify-section-{{ section.id }} .nc-imgcta__pad { position: relative; padding: clamp(40px, 6vw, 72px) 0; }
  #shopify-section-{{ section.id }} .nc-imgcta__inner { max-width: 460px; display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  #shopify-section-{{ section.id }} .nc-imgcta__inner .nc-eyebrow { margin: 0; line-height: var(--leading-relaxed); font-size: 12px; letter-spacing: 0.12em; color: rgba(246, 244, 238, 0.85); }
  #shopify-section-{{ section.id }} .nc-imgcta__inner h2 { margin: 0; color: #fff; font-size: clamp(30px, 4vw, 44px); line-height: 1.08; letter-spacing: normal; }
  #shopify-section-{{ section.id }} .nc-imgcta__inner p { margin: 0; font-size: 16px; color: rgba(246, 244, 238, 0.9); line-height: 1.7; }
  #shopify-section-{{ section.id }} .nc-imgcta__inner .nc-btn { min-height: 0; padding: 14px 28px; line-height: normal; letter-spacing: normal; border-width: 0; background: var(--paper); color: var(--sage-700); }
{%- endstyle -%}

<div class="nc-imgcta nc-on-dark">
  <div class="nc-imgcta__bg" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2200 | image_tag: alt: '', loading: 'lazy', sizes: '100vw' }}
    {%- elsif section.settings.image_url contains '//' -%}
      <img src="{{ section.settings.image_url }}" alt="" loading="lazy" width="2200" height="700">
    {%- elsif section.settings.image_url != blank -%}
      <img src="{{ section.settings.image_url | asset_url }}" alt="" loading="lazy" width="2200" height="700">
    {%- endif -%}
    <span class="nc-imgcta__wash"></span>
  </div>
  <div class="nc-container nc-imgcta__pad">
    <div class="nc-imgcta__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nc-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <a class="nc-btn nc-btn--light" href="{{ section.settings.cta_url | default: '/collections/cbd-hudpleje' }}">{{ section.settings.cta_text }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NC billed-CTA",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Baggrundsbillede" },
    { "type": "text", "id": "image_url", "label": "Billede-URL/asset (fallback)" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Hele serien" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Én serie, til hele din rutine" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Rens, creme, olie og mere, plantebaseret CBD-hudpleje til ansigt og krop." },
    { "type": "text", "id": "cta_text", "label": "Knaptekst", "default": "Shop hudpleje →" },
    { "type": "url", "id": "cta_url", "label": "Knaplink" }
  ],
  "presets": [ { "name": "NC billed-CTA" } ]
}
{% endschema %}
