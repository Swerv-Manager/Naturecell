{% comment %}
  Video i fuld bredde med overlinje, overskrift og kort tekst (fx grundlæggervideoen på Om os).
  Kilde: en video fra Shopify Filer (anbefales: Shopify konverterer og streamer den i flere
  kvaliteter) eller et YouTube- eller Vimeo-link. YouTube og Vimeo indlæses først, når kunden
  trykker afspil, så der ikke sættes cookies fra dem ved sidevisning.
  Uden valgt video vises sektionen ikke for kunderne (kun en vejledning i temaeditoren).
{% endcomment %}

{%- liquid
  assign vf_video = section.settings.video
  assign vf_url = section.settings.video_url
  assign vf_has = false
  if vf_video != blank or vf_url != blank
    assign vf_has = true
  endif
  assign vf_ratio = 1.7778
  if vf_video != blank and vf_video.aspect_ratio > 0
    assign vf_ratio = vf_video.aspect_ratio
  endif
-%}

{%- if vf_has or request.design_mode -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .nc-vf { padding: clamp(36px, 6vw, 72px) 0; {% if section.settings.tone == 'sage' %}background: var(--sage-50);{% endif %} }
    #shopify-section-{{ section.id }} .nc-vf__head { max-width: 680px; margin: 0 auto clamp(20px, 3vw, 30px); text-align: center; }
    #shopify-section-{{ section.id }} .nc-vf__head .nc-eyebrow { margin: 0 0 10px; }
    #shopify-section-{{ section.id }} .nc-vf__head h2 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(26px, 3.6vw, 38px); line-height: 1.2; color: var(--sage-700); }
    #shopify-section-{{ section.id }} .nc-vf__head p { margin: 12px 0 0; font-size: 16.5px; line-height: 1.7; color: var(--ink-700); }
    #shopify-section-{{ section.id }} .nc-vf__frame { position: relative; max-width: 1040px; margin: 0 auto; aspect-ratio: {{ vf_ratio }}; border-radius: 18px; overflow: hidden; background: var(--sage-800, #28403b); box-shadow: var(--shadow-md); }
    #shopify-section-{{ section.id }} .nc-vf__frame video, #shopify-section-{{ section.id }} .nc-vf__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; object-fit: cover; background: #000; }
    #shopify-section-{{ section.id }} .nc-vf__play { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; cursor: pointer; background: none; }
    #shopify-section-{{ section.id }} .nc-vf__play img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    #shopify-section-{{ section.id }} .nc-vf__play span { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: inline-flex; align-items: center; justify-content: center; width: 76px; height: 76px; border-radius: 50%; background: rgba(246, 244, 238, 0.94); color: var(--sage-700); box-shadow: var(--shadow-md); transition: transform var(--dur-fast) var(--ease-soft); }
    #shopify-section-{{ section.id }} .nc-vf__play:hover span, #shopify-section-{{ section.id }} .nc-vf__play:focus-visible span { transform: translate(-50%, -50%) scale(1.06); }
    #shopify-section-{{ section.id }} .nc-vf__empty { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: 24px; text-align: center; color: rgba(246, 244, 238, 0.9); font-size: 15px; line-height: 1.6; }
    #shopify-section-{{ section.id }} .nc-vf__caption { max-width: 1040px; margin: 12px auto 0; font-size: 13.5px; color: var(--ink-500); text-align: center; }
  {%- endstyle -%}

  <section class="nc-vf" aria-labelledby="nc-vf-h-{{ section.id }}">
    <div class="nc-container">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
        <header class="nc-vf__head">
          {%- if section.settings.eyebrow != blank -%}<p class="nc-eyebrow">{% render 'nc-cbd', text: section.settings.eyebrow %}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 id="nc-vf-h-{{ section.id }}">{% render 'nc-cbd', text: section.settings.heading %}</h2>{%- endif -%}
          {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        </header>
      {%- endif -%}

      <div class="nc-vf__frame">
        {%- if vf_video != blank -%}
          {{ vf_video | video_tag: controls: true, preload: 'metadata', playsinline: true, image_size: '1600x', class: 'nc-vf__video' }}
        {%- elsif vf_url != blank -%}
          {%- liquid
            assign vf_label = section.settings.heading | default: section.settings.eyebrow | default: 'Video'
            if vf_url.type == 'youtube'
              assign vf_embed = 'https://www.youtube-nocookie.com/embed/' | append: vf_url.id | append: '?autoplay=1&rel=0&modestbranding=1'
              assign vf_thumb = 'https://img.youtube.com/vi/' | append: vf_url.id | append: '/hqdefault.jpg'
            else
              assign vf_embed = 'https://player.vimeo.com/video/' | append: vf_url.id | append: '?autoplay=1&dnt=1'
              assign vf_thumb = ''
            endif
          -%}
          <button type="button" class="nc-vf__play" data-nc-embed="{{ vf_embed }}" data-nc-embed-title="{{ vf_label | escape }}" aria-label="{{ 'general.play_video' | t }}: {{ vf_label | escape }}">
            {%- if section.settings.poster != blank -%}
              {{ section.settings.poster | image_url: width: 1600 | image_tag: alt: '', loading: 'lazy', widths: '640, 960, 1280, 1600', sizes: '(min-width: 1100px) 1040px, 94vw' }}
            {%- elsif vf_thumb != blank -%}
              <img src="{{ vf_thumb }}" alt="" loading="lazy" width="480" height="360">
            {%- endif -%}
            <span aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg></span>
          </button>
        {%- else -%}
          <div class="nc-vf__empty">{{ 'general.video_missing' | t }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.caption != blank -%}<p class="nc-vf__caption">{{ section.settings.caption }}</p>{%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "class": "nc-vf-section",
  "settings": [
    { "type": "video", "id": "video", "label": "Video fra Shopify Filer", "info": "Anbefales. Upload videoen under Indhold > Filer (MP4 eller MOV, højst 1 GB og 10 minutter), og vælg den her." },
    { "type": "video_url", "id": "video_url", "label": "Eller YouTube- eller Vimeo-link", "accept": ["youtube", "vimeo"], "info": "Bruges kun, hvis der ikke er valgt en video fra Shopify Filer. Indlæses først, når kunden trykker afspil." },
    { "type": "image_picker", "id": "poster", "label": "Forsidebillede til YouTube/Vimeo (valgfrit)" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje" },
    { "type": "text", "id": "heading", "label": "Overskrift" },
    { "type": "textarea", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "caption", "label": "Billedtekst under videoen (valgfri)" },
    { "type": "select", "id": "tone", "label": "Baggrund", "options": [ { "value": "plain", "label": "Papir" }, { "value": "sage", "label": "Lys sage" } ], "default": "plain" }
  ],
  "presets": [
    { "name": "Video" }
  ]
}
{% endschema %}
