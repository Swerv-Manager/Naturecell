<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f6f4ee">

    {%- render 'nc-integrations-head' -%}

    {%- comment -%} Brandet tilfoejes, medmindre titlen allerede naevner NatureCell. Skilletegn er |, ikke tankestreg. {%- endcomment -%}
    {%- assign nc_title_lc = page_title | downcase -%}
    <title>
      {{- page_title -}}
      {%- if current_tags %} | {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} | {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless nc_title_lc contains 'naturecell' %} | NatureCell{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%} Delingskort og strukturerede data (Temaindstillinger → SEO og produktdata). Hreflang lægger Shopify selv ind via content_for_header. {%- endcomment -%}
    {%- render 'nc-social-meta' -%}
    {%- if settings.nc_schema -%}
      {%- render 'nc-structured-data' -%}
    {%- endif -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {%- comment -%}
      Brandets fonte (Philosopher + Roboto Flex) er selvhostede i temaet,
      saa der ikke sker eksterne kald (Cookiebot-hensyn).
    {%- endcomment -%}
    {{ 'nc-philosopher-regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'nc-robotoflex.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {{ 'nc-theme.css' | asset_url | stylesheet_tag }}

    <style>
      html.nc-lock { overflow: hidden; }
    </style>

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    {%- if settings.nc_cbd_icon %}{% render 'nc-cbd-sprite' %}{% endif -%}
    <a class="nc-skip-link" href="#nc-main">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="nc-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'nc-cart-drawer' %}

    <script src="{{ 'nc-theme.js' | asset_url }}" defer></script>

    {%- render 'nc-integrations-body' -%}
  </body>
</html>
