{%- comment -%}
  nc-url: goer en URL fra temaets indstillinger sprogbevidst.

  Shopify saetter selv sprogpraefikset paa objekt-URLs (product.url, collection.url,
  blog.url, routes.* og link.url fra en menu), men IKKE paa URLs der er skrevet ind
  i en sektionsindstilling. Paa /de/ sender saadan et link kunden tilbage til den
  danske version.

  Snippet'en slaar derfor sider, kollektioner, blogs og artikler op som objekter og
  bruger deres egen .url. Det giver baade sprogpraefikset og den oversatte slug, saa
  linket peger direkte paa den rigtige URL i stedet for gennem et redirect.
  Kan ressourcen ikke slaas op, praefikses stien i stedet.

  Uroert bliver: absolutte URLs (https://, //), mailto/tel, ankre (#...) og URLs
  der allerede har praefikset. Snippet'en er derfor idempotent.

  Bemaerk: tags i en filtreret kollektions-URL (/collections/x/tag) kan ikke
  oversaettes af Shopify og bevares som de er.

  Brug:
    href="{% render 'nc-url', url: section.settings.cta_url %}"
    href="{% render 'nc-url', url: block.settings.link, fallback: '/collections/cbd-hudpleje' %}"
{%- endcomment -%}
{%- liquid
  assign nc_u = url | default: fallback | strip
  assign nc_out = nc_u

  assign nc_head1 = nc_u | slice: 0, 1
  assign nc_head2 = nc_u | slice: 0, 2

  if nc_u != blank and nc_head1 == '/' and nc_head2 != '//'

    assign nc_path = nc_u
    assign nc_tail = ''
    if nc_path contains '#'
      assign nc_bits = nc_path | split: '#'
      assign nc_path = nc_bits[0]
      assign nc_tail = '#' | append: nc_bits[1]
    endif
    if nc_path contains '?'
      assign nc_bits = nc_path | split: '?'
      assign nc_tail = '?' | append: nc_bits[1] | append: nc_tail
      assign nc_path = nc_bits[0]
    endif

    assign nc_seg = nc_path | remove_first: '/' | split: '/'
    assign nc_kind = nc_seg[0]
    assign nc_h1 = nc_seg[1]
    assign nc_h2 = nc_seg[2]
    assign nc_base = ''
    assign nc_rest = ''

    if nc_h1 != blank
      if nc_kind == 'pages'
        assign nc_base = pages[nc_h1].url
      elsif nc_kind == 'collections'
        assign nc_base = collections[nc_h1].url
        assign nc_rest = nc_h2
      elsif nc_kind == 'blogs'
        assign nc_base = blogs[nc_h1].url
        if nc_h2 != blank
          assign nc_article = blogs[nc_h1].articles | where: 'handle', nc_h2 | first
          if nc_article.url != blank
            assign nc_base = nc_article.url
          else
            assign nc_rest = nc_h2
          endif
        endif
      endif
    endif

    if nc_base != blank
      assign nc_out = nc_base
      if nc_rest != blank
        assign nc_out = nc_out | append: '/' | append: nc_rest
      endif
      assign nc_out = nc_out | append: nc_tail
    else
      assign nc_root = routes.root_url
      if nc_root != '/'
        assign nc_len = nc_root | size
        assign nc_pre = nc_u | slice: 0, nc_len
        assign nc_next = nc_u | slice: nc_len, 1
        if nc_pre == nc_root and nc_next == blank
          assign nc_out = nc_u
        elsif nc_pre == nc_root and nc_next == '/'
          assign nc_out = nc_u
        else
          assign nc_out = nc_root | append: nc_u
        endif
      endif
    endif
  endif
  echo nc_out
-%}
