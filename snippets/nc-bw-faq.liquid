{%- comment -%}
  nc-bw-faq: Black Week-FAQ som <details> (+ drejer til ×). rows: linjer "Spørgsmål | Svar". open_first: første er åben.
{%- endcomment -%}
{%- assign qrows = rows | newline_to_br | split: '<br />' -%}
<div class="nc-bwx__faq">
  {%- for r in qrows -%}
    {%- assign qp = r | strip | split: ' | ' -%}
    {%- if qp[1] == blank -%}{%- continue -%}{%- endif -%}
    <details {% if open_first and forloop.first %} open{% endif %}>
      <summary><span>{{ qp[0] | strip | escape }}</span><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#F5F4EF" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></summary>
      <div class="nc-bwx__ans">{{ qp[1] | strip | escape }}</div>
    </details>
  {%- endfor -%}
</div>
