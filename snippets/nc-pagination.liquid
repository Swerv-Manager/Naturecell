{%- comment -%}
  nc-pagination: sidetal som runde knapper, aktuel side udfyldt, forrige/naeste som pile og
  "…" ved spring. Erstatter Shopifys default_pagination, hvis markup (<span><a></a></span>)
  gav dobbelte ringe med temaets styling.
  Brug (inde i {% paginate %}): {% render 'nc-pagination', paginate: paginate %}
{%- endcomment -%}
{%- if paginate.pages > 1 -%}
  {%- assign nc_cur = paginate.current_page | append: '' -%}
  <nav class="nc-pagination" aria-label="{{ 'general.pages' | t }}">
    {%- if paginate.previous -%}
      <a class="nc-pagination__item nc-pagination__arrow" href="{{ paginate.previous.url }}" rel="prev" aria-label="{{ 'general.previous_page' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a class="nc-pagination__item" href="{{ part.url }}" aria-label="{{ 'general.page_n' | t: page: part.title }}">{{ part.title }}</a>
      {%- elsif part.title == nc_cur -%}
        <span class="nc-pagination__item is-current" aria-current="page">{{ part.title }}</span>
      {%- else -%}
        <span class="nc-pagination__gap" aria-hidden="true">…</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a class="nc-pagination__item nc-pagination__arrow" href="{{ paginate.next.url }}" rel="next" aria-label="{{ 'general.next_page' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    {%- endif -%}
  </nav>
{%- endif -%}
