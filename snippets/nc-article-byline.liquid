{%- comment -%}
  nc-article-byline: "Skrevet af <forfatter>" med forfatterens foto i den runde cirkel.
  Fotoet vaelges i artikelsektionen (Forfatterbillede) og vises kun for den forfatter,
  det hoerer til. Andre forfattere faar ikonet.
  Brug: {% render 'nc-article-byline', author_name: author_name, author_img: author_img, extra_class: '' %}
{%- endcomment -%}
<div class="nc-art__byline {{ extra_class }}">
  <span class="nc-avatar nc-avatar--light" aria-hidden="true">
    {%- if author_img != blank -%}
      {{ author_img | image_url: width: 120, height: 120, crop: 'top' | image_tag: alt: '', loading: 'lazy', width: 38, height: 38 }}
    {%- else -%}
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
    {%- endif -%}
  </span>
  <span>{{ 'blog.told_by' | t }} <strong>{{ author_name }}</strong></span>
</div>
