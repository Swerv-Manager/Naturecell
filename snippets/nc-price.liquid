{% comment %}
  Prisvisning. Foer-pris vises kun som gennemstreget belob.
  Ingen "SPAR X %"-tekst her: besparelsesudsagn kraever dokumenteret
  30-dages normalpris (prismaerkningsbekendtgoerelsen, paragraf 9 a)
  og maa ikke genereres automatisk af temaet.

  Brug: {% render 'nc-price', product: product %}
{% endcomment %}

{%- liquid
  assign target = product.selected_or_first_available_variant | default: product
-%}

<span class="nc-price">
  <span class="nc-price__current">
    {%- if product.price_varies -%}
      Fra {{ product.price_min | money }}
    {%- else -%}
      {{ target.price | money }}
    {%- endif -%}
  </span>
  {%- if target.compare_at_price > target.price -%}
    <s class="nc-price__compare">
      <span class="nc-visually-hidden">{{ 'product.regular_price' | t }}</span>
      {{ target.compare_at_price | money }}
    </s>
  {%- endif -%}
  {%- if target.unit_price_measurement -%}
    <span class="nc-price__unit"><span class="nc-visually-hidden">{{ 'product.unit_price' | t }} </span>{{ target.unit_price | money }} / {% if target.unit_price_measurement.reference_value != 1 %}{{ target.unit_price_measurement.reference_value }} {% endif %}{{ target.unit_price_measurement.reference_unit }}</span>
  {%- endif -%}
</span>
